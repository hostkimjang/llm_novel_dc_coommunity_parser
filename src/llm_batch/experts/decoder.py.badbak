                user_prompt += "?š¨ ???¬ìŠ¤?¸ëŠ” ?¹ì • ?Œì„¤???„ë‹ˆ??'?¥ë¥´/?¸ë¡œ???´ë¦¬?????€???¼ë°˜??? ë¡ ??ê°€?¥ì„±???’ìŠµ?ˆë‹¤.\n"
                user_prompt += "?œëª©?´ë‚˜ ë³¸ë¬¸??ì£¼ì œ?´ê? ?¥ë¥´Â·?¸ë¡œ??ê´€???¼ë°˜ ê°œë…?´ì¸ ê²½ìš°,\n"
                user_prompt += "ê²€?‰ì—???°ì—°??ë¹„ìŠ·???¤ì›Œ?œì˜ ?Œì„¤??ë°œê²¬?˜ë”?¼ë„ ê·¸ê²ƒ?????¬ìŠ¤?¸ì˜ ?¤ì œ ì£¼ì œ?¸ì? ?„ê²©???•ì¸?˜ì„¸??\n"
                user_prompt += "?ë‹¨ ê¸°ì?: ë³¸ë¬¸/?“ê????´ë‹¹ ?Œì„¤??ê³ ìœ  ?•ë³´(?‘ê?ëª? ?Œë«?? ?Œì°¨, ìºë¦­??ê³ ìœ ëª? ì¤„ê±°ë¦?ê°€ ?ˆëŠ”ê°€?\n"
                user_prompt += "ê³ ìœ  ?•ë³´ê°€ ?†ìœ¼ë©???best_match.title=null, confidence=none?¼ë¡œ ?ì •?˜ì„¸??\n"
            else:
