                    user_prompt += f"  ??'{abbrev}' = '{full}' (?½ì¹­ ???•ì‹ ?œëª©)\n"
            if _gk_characters:
                user_prompt += f"  ??ë³¸ë¬¸/?œëª©?ì„œ ê°ì????¸ë¬¼ëª? {_gk_characters}\n"
            if _gk_authors:
                user_prompt += f"  ??ë³¸ë¬¸/?œëª©?ì„œ ê°ì????‘ê?ëª??„ë³´: {_gk_authors}\n"
            if not _resolved_mappings and not _gk_characters and not _gk_authors and not _snippet_identified_title:
                user_prompt += "  ??(?¬ì „ ë°œê²¬??ë§¤í•‘/?¸ë¬¼ ?†ìŒ ??ê²€??ê²°ê³¼?€ ë³¸ë¬¸??ì§ì ‘ ?€ì¡°í•˜???¤ìŠ¤ë¡?ì¶”ë¡ ?˜ì„¸??\n"
            
            # ?ë¬¸ ?ìŠ¤???¤ì‹œ ?œì‹œ
            user_prompt += f"\n?“ ?ë¬¸ ?¤ì‹œ ?½ê¸°:\n"
            user_prompt += f"  ?œëª©: {_post_title_r}\n"
            if _body_text:
                user_prompt += f"  ë³¸ë¬¸: {_body_text[:300]}\n"
            if _comments_text:
                user_prompt += f"  ?“ê?: {_comments_text[:300]}\n"
            
            # ?ìœ  ì¶”ë¡  ì§€??
            user_prompt += "\n?§  **ì¶”ë¡  ê³¼ì œ (ë§¤ìš° ì¤‘ìš”!):**\n"
            user_prompt += "???¬ì‹¤?¤ì„ ?ë¬¸???€?…í•˜???¤ìŒ???¨ê³„ë³„ë¡œ ì¶”ë¡ ?˜ì„¸??\n\n"
            user_prompt += "**Pre-Step ???œëª©+ë³¸ë¬¸ ?°ê²° ?½ê¸° (MANDATORY):**\n"
            user_prompt += "ì»¤ë??ˆí‹° ê²Œì‹œê¸€???œëª©ê³?ë³¸ë¬¸?€ ?˜ë‚˜???°ì†??ë°œí™”?…ë‹ˆ??\n"
            user_prompt += "?œëª©?ëŠ” ?µì‹¬ ì£¼ì œ(?‘í’ˆëª?ìºë¦­?°ëª…/?‘ê?ëª?, ë³¸ë¬¸?ëŠ” ê´€??ê°ì •/?˜ê²¬/?´ìš©???´ê¹?ˆë‹¤.\n"
            user_prompt += "?ˆì‹œ: ?œëª©='ì¦‰ì‚¬ë¬´ë¦¼ ?€?ì´ ?ˆë¬´ ë¶ˆìŒ?? + ë³¸ë¬¸='?´ë µê²??ê¸´ ê°€ì¡±ì„ ?„í•´ ì£½ëŠ”?¤ë‹ˆ'\n"
            user_prompt += "??'ì¦‰ì‚¬ë¬´ë¦¼'?´ë¼???‘í’ˆ??'?€???´ë¼??ìºë¦­?°ê? ë¶ˆìŒ?˜ë‹¤. ê°€ì¡±ì„ ?´ë µê²??»ì—ˆ?”ë° ì£½ëŠ”?¤ë‹ˆ.\n"
            user_prompt += "?œëª©ë§?ë³´ê³  ?ë‹¨?˜ì? ë§ê³ , ?œëª©+ë³¸ë¬¸???˜ë‚˜ë¡??´ì–´???½ìœ¼?¸ìš”.\n\n"
            user_prompt += "**Step 0 ???¤ì¤‘ ?´ì„ ?´ê±° (MANDATORY):**\n"
            user_prompt += "ê°?key_term???€?? ê²€??ê²°ê³¼?ì„œ ë°œê²¬??**ëª¨ë“  ê°€?¥í•œ ?´ì„**???´ê±°?˜ì„¸??\n"
            user_prompt += "??ê°€ì§€ ?´ì„??ê³ ì°©?˜ì? ë§ˆì„¸??\n"
            user_prompt += "ê°™ì? ?©ì–´ê°€ ?‘ê?ëª…ì´???¼ë°˜ ëª…ì‚¬?????ˆê³ , ?‘í’ˆ ?½ì¹­?´ì ?¥ë¥´ ?©ì–´?????ˆìŠµ?ˆë‹¤.\n"
            user_prompt += "ê°??´ì„ë³„ë¡œ ë³¸ë¬¸ ë§¥ë½ê³¼ì˜ ?í•©??context_fit)ë¥??‰ê??˜ì„¸??\n"
            user_prompt += "??interpretations ë°°ì—´??ëª¨ë“  ?´ì„??ê¸°ë¡?˜ì„¸??\n\n"
            user_prompt += "**Step 1 ???©ì–´ ì¹˜í™˜ ?½ê¸°:**\n"
            user_prompt += "?½ì¹­/?¸ë¬¼ëª…ì„ ?¤ì œ ?˜ë?ë¡?ì¹˜í™˜?˜ë©´ ??ê¸€??ë¬´ìŠ¨ ?»ì¸ê°€?\n"
            user_prompt += "ë°œê²¬???¬ì‹¤(?½ì¹­?’ì •?ì œëª? ?¸ë¬¼?’ì‘ê°€/ìºë¦­?????ë¬¸???€?…í•˜???½ìœ¼?¸ìš”.\n\n"
            user_prompt += "**Step 2 ??ë§¥ë½ ì¶”ë¡ :**\n"
            user_prompt += "ì¹˜í™˜ ??ê¸€ ?„ì²´ë¥??¤ì‹œ ?½ê³ , ê¸€?´ì´??**?˜ë„**ë¥?ì¶”ë¡ ?˜ë¼.\n"
            user_prompt += "- ?‘í’ˆ??ì¤„ê±°ë¦?ìºë¦­?°ì— ?€???¼ì˜?¸ê??\n"
            user_prompt += "- ?‘ê????€????ë°˜ì‘(?‘ì›, ?°ì¬ ê¸°ì›, ë¶ˆë§Œ ???¸ê??\n"
            user_prompt += "- ?‘í’ˆ ì¶”ì²œ/ë¹„êµ?¸ê??\n"
            user_prompt += "- ?‘í’ˆê³?ë¬´ê???ë°??€?´ì¸ê°€?\n"
            user_prompt += "- ë³¸ë¬¸+?“ê????„ì²´ ë¶„ìœ„ê¸°ì—???´ë–¤ ?´ì„??ê°€???ì—°?¤ëŸ¬?´ê??\n\n"
            user_prompt += "**Step 3 ???¸ë¬¼ ??•  ?ì •:**\n"
            user_prompt += "ê²€??ê²°ê³¼ë¥?ì°¸ê³ ?˜ì—¬ ?¸ë¬¼ëª…ì˜ ??• ???•ì¸?˜ë¼.\n"
            user_prompt += "- ?±ì¥?¸ë¬¼ë¡??•ì¸ ??anchor_type='character_mention', is_grounded=true\n"
            user_prompt += "- ?‘ê?ë¡??•ì¸ ??is_author_name=true, author_info ê¸°ë¡\n"
            user_prompt += "- ?‘ê?ëª…ì´ ë³¸ë¬¸???ˆê³  + ?´ë‹¹ ?‘í’ˆ ?½ì¹­???ˆìœ¼ë©???is_grounded=true (?‘í’ˆ ?ë³„ ì¦ê±°)\n\n"
            user_prompt += "**Step 3-B ???‘ê? ì¤‘ì‹¬ ?¤ì¤‘ ?‘í’ˆ ?¨í„´ (?´ë‹¹ ???ìš©):**\n"
            user_prompt += "ê²Œì‹œê¸€??**?¹ì • ?‘ê????¬ëŸ¬ ?‘í’ˆ**???œêº¼ë²ˆì— ?¼í•˜??ê²½ìš°:\n"
            user_prompt += "- ?‘ê?ëª…ì´ ë³¸ë¬¸/?“ê????ˆê³ , ?¬ëŸ¬ ?‘í’ˆ???½ì¹­???¨ê»˜ ?±ì¥?˜ë©´\n"
            user_prompt += "  ???´ë‹¹ ?‘ê???**?€?œì‘**(ê°€??ë§ì´ ?¸ê¸‰/ê°€??? ëª…???‘í’ˆ)??best_match.titleë¡?? íƒ\n"
            user_prompt += "  ??confidence='medium' ?´ìƒ, anchor_type='author_works_discussion'\n"
            user_prompt += "  ??notes??'?‘ê? X???¤ì¤‘ ?‘í’ˆ ?¼ì˜: A, B, C ???€?œì‘ A ? íƒ' ?•íƒœë¡?ê¸°ë¡\n"
            user_prompt += "- snippet_analyzer ë¶„ì„?ì„œ ?´ë? ?¹ì • ?‘í’ˆ???ë³„?˜ì—ˆ?¼ë©´ ê·¸ê²ƒ???°ì„  ì±„íƒ\n\n"
            user_prompt += "**Step 4 ??ê²°ë¡ :**\n"
            user_prompt += "ì¶”ë¡  ê²°ê³¼ë¥?notes ?„ë“œ??'ì¹˜í™˜ ?½ê¸° ??ë§¥ë½ ì¶”ë¡  ??ê²°ë¡ ' ?•íƒœë¡?ê°„ê²°?˜ê²Œ ê¸°ë¡?˜ì„¸??\n"
        
        # ï¿½ğŸŒ?Fetched Page Info: URL ?˜ì¹­?¼ë¡œ ?»ì? êµ¬ì¡°???•ë³´
        if ctx and hasattr(ctx, 'fetched_page_info') and ctx.fetched_page_info:
            user_prompt += "\n\n=== ?Œ FETCHED PAGE INFO (ê³µì‹ ?˜ì´ì§€ ë¶„ì„) ===\n"
            user_prompt += "?„ë˜???˜ë¬´?„í‚¤/ê³µì‹ ?Œë«???˜ì´ì§€?ì„œ ì¶”ì¶œ???•ë³´?…ë‹ˆ??\n\n"
            for fi in ctx.fetched_page_info[:3]:
                url = fi.get("url", "")
                structured = fi.get("structured_info", {})
                preview = fi.get("text_preview", "")
                user_prompt += f"URL: {url}\n"
                if structured:
                    for k, v in structured.items():
                        if v and k != "text_preview":
                            user_prompt += f"  {k}: {v}\n"
                if preview:
                    user_prompt += f"  ?´ìš© ë¯¸ë¦¬ë³´ê¸°: {preview[:300]}\n"
                user_prompt += "\n"
        
        print(f"[{_ts()}][{self.emoji}] {self.name} ë¶„ì„ ?œì‘: terms={key_terms}", file=sys.stderr)
        
        # ?€?€ ìµœì¢… ?„ë¡¬?„íŠ¸ ?¬ê¸° ê°€???€?€
        # user_promptê°€ ?ˆì‚°??ì´ˆê³¼?˜ë©´ ì¶”ê? ?¹ì…˜ë¶€???ì§„?ìœ¼ë¡??œê±°
        if len(user_prompt) > _USER_PROMPT_BUDGET:
            _over = len(user_prompt) - _USER_PROMPT_BUDGET
            print(
                f"[{_ts()}][{self.emoji}] user_prompt over budget ({len(user_prompt):,} > {_USER_PROMPT_BUDGET:,}), trimming {_over:,} chars",
                file=sys.stderr,
            )
            
            # ê²€??ê²°ê³¼ë¥?ìµœì†Œ?”í•˜??user_prompt ?¬êµ¬??
            _sr_for_prompt = _truncate_search_results(search_results, max_snippet_len=80, max_results=5)
            _sr_json_min = json.dumps(_sr_for_prompt, ensure_ascii=False, indent=2)
            user_prompt = DECODER_PROMPT.format(
                gatekeeper_json=_gk_json,
                search_results_json=_sr_json_min,
                slang_dictionary=_dict_json,
            )
            # ?µì‹¬ ?•ë³´ë§?ìµœì†Œ?œìœ¼ë¡?ì¶”ê?
            if ctx and getattr(ctx, 'discourse_warning', None):
                user_prompt += f"\n\n? ï¸ DISCOURSE WARNING: {getattr(ctx, 'discourse_warning', '')}\n"
            # Deep Search Hints??ê°€??ì¤‘ìš”???½ì¹­ ë§¤í•‘ë§?
            if _resolved_mappings:
                user_prompt += "\n?“Œ ?½ì¹­ ë§¤í•‘:\n"
                for abbrev, full in _resolved_mappings[:2]:
                    user_prompt += f"  ??'{abbrev}' = '{full}'\n"
            if _gk_characters:
                user_prompt += f"?“Œ ê°ì????¸ë¬¼ëª? {_gk_characters[:3]}\n"
            
            # ê·¸ë˜??ì´ˆê³¼?˜ë©´ ìµœí›„ ?˜ë‹¨
            if len(user_prompt) > _USER_PROMPT_BUDGET:
                _sr_for_prompt = _truncate_search_results(search_results, 50, 3)
                _sr_json_min = json.dumps(_sr_for_prompt, ensure_ascii=False, indent=2)
                user_prompt = DECODER_PROMPT.format(
                    gatekeeper_json=_gk_json,
                    search_results_json=_sr_json_min,
                    slang_dictionary=_dict_json,
                )
                print(
                    f"[{_ts()}][{self.emoji}] final prompt trim: user_prompt={len(user_prompt):,}",
                    file=sys.stderr,
                )
        
        print(f"[{_ts()}][{self.emoji}] ìµœì¢… user_prompt={len(user_prompt):,}??"
              f"(budget={_USER_PROMPT_BUDGET:,})", file=sys.stderr)
        
        try:
            result = self._call_llm(user_prompt)
            elapsed = time.time() - start_time
            
            # Merge dictionary matches with LLM result
            # ?”¥ ctx ?„ë‹¬: ?¬ì „ê°’ë„ ê²€??ê²°ê³¼ë¡?êµì • ê°€?¥í•˜?„ë¡
            result = self._merge_dict_matches(result, dict_matches, ctx)
            
            # ?”¥ decoded_terms ?€???ˆì „ ?•ì œ: LLM??ê¹¨ì§„ JSON??ë°˜í™˜?˜ë©´
            # decoded_terms??dictê°€ ?„ë‹Œ str ?±ì´ ?ì¼ ???ˆìŒ ???œê±°
            raw_terms = result.get("decoded_terms", [])
            if raw_terms:
                cleaned = [t for t in raw_terms if isinstance(t, dict)]
                if len(cleaned) < len(raw_terms):
                    print(f"[{_ts()}][{self.emoji}] ? ï¸ decoded_terms ?€???•ì œ: "
                          f"{len(raw_terms)}ê±???{len(cleaned)}ê±?(ë¹?dict ??ª© ?œê±°)",
                          file=sys.stderr)
                    result["decoded_terms"] = cleaned
            
            # ?œì•ˆ 2: Decoder??? ë¢°?„ë? ctx???€??
            if ctx:
                confidence_str = result.get("overall_confidence", "medium")
                confidence_map = {"high": 0.85, "max": 0.95, "medium": 0.6, "low": 0.3}
                ctx.expert_confidence["decoder"] = confidence_map.get(confidence_str, 0.6)
            
            # ?”¥ ì»¤ë??ˆí‹° ?œëª© ë°©ì–´: LLM??dcinside/arca ê²Œì‹œê¸€ ?œëª©??ê³µì‹ ?œëª©?¼ë¡œ ì°©ê°??ê²½ìš° êµì •
            if ctx:
                result = self._guard_community_title(result, ctx)
            
            # ?”¥ ?Œë«??URL ê¸°ë°˜ ?œëª© êµì •: candidate URL??ê³µì‹ ?œëª©ê³?ë¶ˆì¼ì¹???êµì •
            if ctx:
                result = self._correct_title_from_platform_url(result, ctx)
            
            # ?”¥ ?Œë«??ê¸°ëŠ¥ ê°€?? ?¸í”¼??ì½?ë±ƒì? ì¡°í•©?´ë©´ meta ê°•ì œ (?Œì„¤ ?„ë‹˜)
            if ctx:
                result = self._guard_platform_feature_as_title(result, ctx)
            
            # ?”¥ ?°ìƒ ?¨í„´ ê°€?? "X?´ë? ?¨ì–´ê°€ ? ì˜¬?? ??X???œëª© ?„ë‹˜
            if ctx:
                result = self._guard_association_pattern(result, ctx)
            
            # ?”¥ ?¥ë¥´ êµì°¨ê²€ì¦? ë³¸ë¬¸ ?¥ë¥´?€ ?„ë³´ ?‘í’ˆ ?¥ë¥´ ë¶ˆì¼ì¹???confidence ?˜í–¥
            if ctx:
                result = self._validate_genre_cross_match(result, ctx)
            
            # ?”¥ ?‘ê?ëª??½ì¹­ rescue: is_author_name?¸ë° ê²€??ê²°ê³¼?ì„œ ?‘í’ˆ ?½ì¹­ ì¦ê±° ë°œê²¬ ???„í™˜
            if ctx:
                result = self._rescue_author_as_work_abbreviation(result, ctx)
            
            # ?”¥ ?•íƒœ??ë§¤ì¹­ ê²€ì¦? ì¶•ì•½?´ì˜ ?•íƒœ?Œê? ?„ë³´ ?œëª©???¤ì œ ?¬í•¨?˜ëŠ”ì§€ ?•ì¸
            if ctx:
                result = self._validate_morpheme_in_title(result, ctx)
            
            # ?”¥ ?‘ê?+? ì‘ ?ˆì „ì²˜ë¦¬: ?‘ê????ë³„?ˆì?ë§??œëª©???¥ë¥´ ?©ì–´/?„í‚¤?€?…ì¸ ê²½ìš° ì°¨ë‹¨
            if ctx:
                result = self._guard_archetype_as_title(result, ctx)
            
            # ?”¥ Discourse ??°©??Override: non-novel ?„ë©”??high)?´ë©´ Decoder ? ë¢°??ê°•ì œ ?˜í–¥
            if ctx and getattr(ctx, 'discourse_warning', None):
                result = self._apply_discourse_warning(result, ctx)
            
            # ?”¥ ë³¸ë¬¸ ì¦ê±° ê²€ì¦? best_matchê°€ ?ˆì?ë§?ë³¸ë¬¸???‘í’ˆ ê´€??ì¦ê±°ê°€ ?„í? ?†ìœ¼ë©?confidence ?˜í–¥
            if ctx:
                result = self._guard_no_body_evidence(result, gatekeeper_result, ctx)

            # ?”§ ?„ë³´ ?¤ëª…/?Œë˜ê·??•í•©??ë³´ì •:
            # decode_logic(?ìœ ?œìˆ )?€ genre_match/is_match(êµ¬ì¡°???„ë“œ)ê°€ ëª¨ìˆœ?˜ëŠ” ê²½ìš° êµì •
            result = self._reconcile_candidate_consistency(result)
            
            best = self._get_best_candidate(result)
            print(f"[{_ts()}][{self.emoji}] {self.name} ?„ë£Œ ({elapsed:.1f}s): "
                  f"best_match={best}, confidence={result.get('overall_confidence')}", 
                  file=sys.stderr)
            
            # â­?suspected_titles ì´ˆê¸° ?ì„± (Decoderê°€ ì²?ë²ˆì§¸ë¡??ì„±)
            if ctx:
                self._init_suspected_titles(result, ctx)
            
            return result
            
        except Exception as e:
            elapsed = time.time() - start_time
            print(f"[{_ts()}][{self.emoji}] {self.name} ?¤ë¥˜ ({elapsed:.1f}s): {e}", file=sys.stderr)
            return self._empty_result(str(e))
    
    def _check_session_knowledge(self, terms: List[str], session_knowledge: Dict[str, Any]) -> List[Dict[str, Any]]:
        """
        NEW: Check if any term exists in session knowledge (learned from previous posts)
        ?¸ì…˜ ì§€?ì—???´ë? ?™ìŠµ???½ì¹­ ?•ì¸
        """
        matches = []
        resolved_slang = session_knowledge.get("resolved_slang", {})
        
        for term in terms:
            term_lower = term.lower().strip()
            if term_lower in resolved_slang:
                info = resolved_slang[term_lower]
                matches.append({
                    "slang": term,
                    "official_title": info["official_title"],
                    "confidence": info.get("confidence", "medium"),
                    "source": "session_knowledge"
                })
        
        return matches
    
    # ?€?€ OPT-4: ?¸ë˜???œê? ?œê¸° ?¼ë³¸???? ?ì????¨í„´ ?€?€
    # ì¹´í?ì¹´ë‚˜?’í•œê¸€ ?„ì‚¬?ì„œ ?ì£¼ ?˜í??˜ëŠ” ?Œì ˆ ì¡°í•©
    _FOREIGN_SYLLABLE_PAIRS = {
        "Äí·Î", "Å¸·Î", "¼¼ÀÌ", "¸®¾Æ", "¸®Ä«", "¸¶Å°", "À¯Å°", "»çÅ°",
        "¹Ì¾ß", "ÇÏÅ°", "³ª±â", "ÇÏ·ç", "¼îÅ°", "»ç¶ó", "¸¶·ç", "¾ÆÀÌ",
        "ÄÚ¿ì", "Ä¡Å°", "Ä«ÀÌ", "¿ÀÅä", "Ä¡Ä«", "½Ã¸¶", "¸ğÅä", "Ä«³ª", "¹«¶ó",
    }

    def _is_likely_foreign_transcription(self, term: str) -> bool:
        """
        OPT-4: ?œê?ë¡??œê¸°???¸ë˜???¼ë³¸???ì–´ ?? ê°ì?.
        ?´ëŸ° ?¨ì–´??ë¶„ë¦¬?˜ë©´ ?˜ë? ?†ëŠ” ?°ë ˆê¸°ë§Œ ?ê¸°ë¯€ë¡?ë¶„ë¦¬ ?¤í‚µ.

        ?ì • ê¸°ì?:
        1. Kiwiê°€ ?¨ì¼ NNP(ê³ ìœ ëª…ì‚¬)ë¡??¸ì‹ ???¸ë˜??ê°€?¥ì„± ?’ìŒ
        2. ì¹´í?ì¹´ë‚˜ ?„ì‚¬ ?¹ìœ ???Œì ˆ?ì´ 2ê°??´ìƒ ?¬í•¨
        """
        # ê¸°ì? 1: Kiwi ?•íƒœ??ë¶„ì„ ???¨ì¼ NNPë©?ë¶„ë¦¬ ë¶ˆí•„??
        if self._kiwi:
            try:
                tokens = self._kiwi.tokenize(term)
                # ?¤ì§ˆ ?•íƒœ??ì¡°ì‚¬/?´ë? ?œì™¸)ê°€ 1ê°œë¿?´ë©´ ?¨ì¼ ê³ ìœ ëª…ì‚¬
                content_tokens = [t for t in tokens if t.tag.startswith('N') or t.tag.startswith('V')]
                if len(content_tokens) <= 1:
                    return True
            except Exception:
                pass

        # ê¸°ì? 2: ?¸ë˜???„ì‚¬ ?Œì ˆ??ë¹ˆë„
        foreign_hit = 0
        for i in range(len(term) - 1):
            pair = term[i:i+2]
            if pair in self._FOREIGN_SYLLABLE_PAIRS:
                foreign_hit += 1
        # ?„ì²´ ê¸¸ì´ ?€ë¹?30% ?´ìƒ?´ë©´ ?¸ë˜???ì •
        if len(term) >= 4 and foreign_hit >= max(2, len(term) * 0.3):
            return True

        return False

    def _try_split_abbreviation_boundary(
        self, terms: List[str], gatekeeper_result: Dict[str, Any] | None = None,
    ) -> List[tuple]:
        """
        ?†• P0-4 v2: ì¶•ì•½??ê²½ê³„ ë¶„ë¦¬ ?Œê³ ë¦¬ì¦˜ (Kiwi + GK entity ê¸°ë°˜)

        ë°˜í™˜ê°? [(term_str, priority)] ë¦¬ìŠ¤??
          priority: 0 = GK ?ë³¸, 1 = GK possible_title, 2 = ë¶„ë¦¬ ?„ë³´

        ê°œì„  ?¬í•­ (OPT-1~4):
        - OPT-1: Kiwi ?•íƒœ??ë¶„ì„?¼ë¡œ ëª…ì‚¬ ê²½ê³„?ì„œë§?ë¶„ë¦¬
        - OPT-2: GK possible_characters ê¸°ë°˜ ?•ë? ë¶„ë¦¬
        - OPT-3: priority ?œê·¸ë¡?? í° ê´€ë¦?(?¸ì¶œë¶€?ì„œ ?•ë ¬)
        - OPT-4: ?¸ë˜???ì?ë¡?ë¶ˆí•„??ë¶„ë¦¬ ì°¨ë‹¨
        """
        gatekeeper_result = gatekeeper_result or {}
        gk_entities = gatekeeper_result.get("detected_entities") or {}
        gk_characters = set(gk_entities.get("possible_characters") or [])

        # priority 0 = ?ë³¸ GK key_term
        expanded: list[tuple] = []

        for term in terms:
            term_clean = term.strip()
            if not term_clean:
                continue

            # ?œê?ë§?ì²˜ë¦¬ (?ë¬¸/?«ì ?¼í•©?€ Skip)
            if not all('°¡' <= c <= 'ÆR' or c.isspace() for c in term_clean):
                expanded.append((term_clean, 0))
                continue

            syllable_count = len(term_clean)

            # 5?Œì ˆ ë¯¸ë§Œ?´ë©´ ë¶„ë¦¬ ë¶ˆí•„??
            if syllable_count < 5:
                expanded.append((term_clean, 0))
                continue

            # ?€?€ OPT-4: ?¸ë˜??ê°ì? ??ë¶„ë¦¬ ?¤í‚µ ?€?€
            if self._is_likely_foreign_transcription(term_clean):
                expanded.append((term_clean, 0))
                print(
                    f"[{_ts()}][{self.emoji}] ?Œ ?¸ë˜??ê°ì? ?¤í‚µ: '{term_clean}'",
                    file=sys.stderr,
                )
                continue

            split_found = False

            # ?€?€ OPT-2: GK possible_characters ê¸°ë°˜ ë¶„ë¦¬ ?€?€
            # ?·ë?ë¶„ì´ GKê°€ ê°ì???ìºë¦­???´ë¦„ê³??¼ì¹˜?˜ë©´ ?•ë? ë¶„ë¦¬
            for char_name in gk_characters:
                if len(char_name) < 2:
                    continue
                if term_clean.endswith(char_name) and len(term_clean) > len(char_name):
                    abbrev_part = term_clean[: -len(char_name)]
                    if len(abbrev_part) >= 2:
                        expanded.append((term_clean, 0))  # ?ë³¸ ë³´ì¡´
                        expanded.append((abbrev_part, 2))
                        expanded.append((char_name, 2))
                        split_found = True
                        print(
                            f"[{_ts()}][{self.emoji}] ?¯ GKìºë¦­??ë¶„ë¦¬: "
                            f"'{term_clean}' ??'{abbrev_part}' + '{char_name}'",
                            file=sys.stderr,
                        )
                        break

            if split_found:
                continue

            # ?€?€ OPT-1: Kiwi ?•íƒœ??ë¶„ì„ ê¸°ë°˜ ë¶„ë¦¬ ?€?€
            # ?µì‹¬: ì¡°ì‚¬(JKS/JX/JKO..), ?‘ë???XSN), ?´ë?(E*) ?„ì¹˜ê°€
            # ?¤ì œ ?¨ì–´ ê²½ê³„ë¥??˜í???(?? "ì¦‰ì‚¬ë¬´ë¦¼?´ìœ ë°? ????JKS at 4)
            if self._kiwi:
                try:
                    tokens = self._kiwi.tokenize(term_clean)

                    # ?„ëµ 1: ì¡°ì‚¬/?‘ë????´ë? ê²½ê³„?ì„œ ë¶„ë¦¬
                    # ì¡°ì‚¬(J*) ??ì¡°ì‚¬??startê°€ ë¶„ë¦¬??(ì¡°ì‚¬???¤ìª½ ?¨ì–´???¼ë?)
                    # ?‘ë???XSN/XSA/XSV) ???‘ë?????start+len)ê°€ ë¶„ë¦¬??(?‘ë??¬ëŠ” ???¨ì–´??ë¶™ìŒ)
                    josa_tags = {'JKS', 'JKO', 'JKB', 'JKG', 'JKC', 'JKV', 'JX', 'JC'}
                    suffix_tags = {'XSN', 'XSA', 'XSV'}
                    split_positions: list[int] = []
                    for t in tokens:
                        if t.tag in josa_tags:
                            # ì¡°ì‚¬???œì‘ = ???¨ì–´????= ë¶„ë¦¬??
                            sp = t.start
                            if 2 <= sp <= syllable_count - 2:
                                split_positions.append(sp)
                        elif t.tag in suffix_tags:
                            # ?‘ë?????= ë¶„ë¦¬??("?„ì??? ?¤ì—??ë¶„ë¦¬)
                            sp = t.start + len(t.form)
                            if 2 <= sp <= syllable_count - 2:
                                split_positions.append(sp)

                    # ì¤‘ë³µ ?œê±° & ?•ë ¬
                    split_positions = sorted(set(split_positions))

                    for sp in split_positions:
                        abbrev_part = term_clean[:sp]
                        remainder = term_clean[sp:]
                        if len(abbrev_part) >= 2 and len(remainder) >= 2:
                            expanded.append((term_clean, 0))
                            expanded.append((abbrev_part, 2))
                            expanded.append((remainder, 2))
                            split_found = True
                            tag_info = [f'{t.form}/{t.tag}' for t in tokens]
                            print(
                                f"[{_ts()}][{self.emoji}] ?”¬ Kiwi ê²½ê³„ ë¶„ë¦¬: "
                                f"'{term_clean}' ??'{abbrev_part}' + '{remainder}' "
                                f"(?•íƒœ?? {tag_info})",
                                file=sys.stderr,
                            )
                            break  # ì²?ë²ˆì§¸ ? íš¨ ê²½ê³„ë§??¬ìš©

                    # ?„ëµ 2: ì¡°ì‚¬ê°€ ?†ìœ¼ë©?ëª…ì‚¬ ê²½ê³„ë¡??´ë°±
                    if not split_found:
                        noun_tokens = [
                            t for t in tokens
                            if t.tag in ('NNG', 'NNP') and len(t.form) >= 2
                        ]
                        if len(noun_tokens) >= 2:
                            # ??ë²ˆì§¸ ëª…ì‚¬???œì‘?ì—??ë¶„ë¦¬
                            sp2 = noun_tokens[1].start
                            if 2 <= sp2 <= syllable_count - 2:
                                abbrev_part = term_clean[:sp2]
                                remainder = term_clean[sp2:]
                                if len(abbrev_part) >= 2 and len(remainder) >= 2:
                                    expanded.append((term_clean, 0))
                                    expanded.append((abbrev_part, 2))
                                    expanded.append((remainder, 2))
                                    split_found = True
                                    print(
                                        f"[{_ts()}][{self.emoji}] ?”¬ Kiwi ëª…ì‚¬ê²½ê³„ ë¶„ë¦¬: "
                                        f"'{term_clean}' ??'{abbrev_part}' + '{remainder}'",
                                        file=sys.stderr,
                                    )

                except Exception as e:
                    print(
                        f"[{_ts()}][{self.emoji}] ? ï¸ Kiwi ë¶„ë¦¬ ?¤íŒ¨: '{term_clean}' ??{e}",
                        file=sys.stderr,
                    )

            # ?€?€ ?´ë°±: ê¸°ì¡´ ?„ì¹˜ ê¸°ë°˜ ë¶„ë¦¬ (Kiwi ?†ê±°???¤íŒ¨ ?? ?€?€
            if not split_found:
                # Kiwiê°€ ?†ê±°??ë¶„ë¦¬?ì„ ëª?ì°¾ì? ê²½ìš°?ë§Œ ê¸°ê³„??ë¶„ë¦¬
                fallback_candidates = []
                for split_at in [3, 4]:
                    if split_at >= syllable_count:
                        continue
                    abbrev_part = term_clean[:split_at]
                    remainder = term_clean[split_at:]
                    if 2 <= len(remainder) <= 4:
                        fallback_candidates.append((abbrev_part, remainder))

                if fallback_candidates:
                    expanded.append((term_clean, 0))
                    for abbrev, char_name in fallback_candidates:
                        expanded.append((abbrev, 2))
                        if len(char_name) >= 3:
                            expanded.append((char_name, 2))
                    print(
                        f"[{_ts()}][{self.emoji}] ?? ?´ë°± ë¶„ë¦¬: '{term_clean}' "
                        f"({syllable_count}?Œì ˆ) ??{len(fallback_candidates)}ê°??„ë³´",
                        file=sys.stderr,
                    )
                else:
                    expanded.append((term_clean, 0))

        # ì¤‘ë³µ ?œê±° (term ê¸°ì?, ???’ì? priority ? ì?)
        seen: dict[str, int] = {}
        for term_str, prio in expanded:
            if term_str not in seen or prio < seen[term_str]:
                seen[term_str] = prio
        return [(t, p) for t, p in seen.items()]
    
    def _expand_repetition_patterns(self, terms: List[str]) -> List[str]:
        """
        ?†• P1-4: ë°˜ë³µ ?¨í„´ ?•ì¥ ?Œê³ ë¦¬ì¦˜
        
        [?Œì ˆë°˜ë³µ] ??[?¨ì–´ ë°˜ë³µ] ?•ì¥
        
        ?ì¹™ (PROMPT_GUIDELINES.md ì¤€??:
        - ?¹ì • ?¨í„´ ?˜ë“œì½”ë”© ê¸ˆì?
        - ?¸ì–´?™ì  ?ë¦¬: ?œê? ?Œì ˆ ë°˜ë³µ ?¨í„´ ê°ì?
        - ë°˜ë³µ = ê°•ì¡° ?œí˜„ (consecutive same syllables)
        
        ?¨í„´ ë¶„ì„:
        - ?°ì† ?™ì¼ ?Œì ˆ ??2????ë°˜ë³µ ?¨í„´?¼ë¡œ ?¸ì‹
        - ?Œì ˆ + "?? ?•íƒœë¡??•ì¥ (?¼ë°˜???´ë? ?¨í„´)
        - êµ¬ì¡°: [?‘ë‘][?Œì ˆÃ—N] ??[?‘ë‘] [?Œì ˆ??Ã—N
        """
        expanded_terms = []
        
        for term in terms:
            # ?œê?ë§?ì²˜ë¦¬
            if not all('°¡' <= c <= 'ÆR' or c.isspace() for c in term):
                expanded_terms.append(term)
                continue
            
            term_clean = term.strip()
            syllable_count = len(term_clean)
            
            # 3?Œì ˆ ?´ìƒë§?ì²˜ë¦¬ (?ˆë¬´ ì§§ìœ¼ë©??¨í„´ ?ë³„ ?´ë ¤?€)
            if syllable_count < 3:
                expanded_terms.append(term)
                continue
            
            # ?°ì†???™ì¼ ?Œì ˆ ê°ì?
            repetition_found = False
            expanded_version = ""
            i = 0
            
            while i < syllable_count:
                current = term_clean[i]
                
                # ?¤ìŒ ?Œì ˆ??ê°™ì?ì§€ ?•ì¸
                consecutive_count = 1
                while i + consecutive_count < syllable_count and term_clean[i + consecutive_count] == current:
                    consecutive_count += 1
                
                # 2???´ìƒ ë°˜ë³µ?´ë©´ ?¨í„´?¼ë¡œ ê°„ì£¼
                if consecutive_count >= 2:
                    repetition_found = True
                    # ì²??Œì ˆ?€ ?ë˜ ?¨ì–´??ê°€?¥ì„± ?’ìŒ
                    if i == 0:
                        # "ì¢‹ì¢‹ì¢? ??ì²?"ì¢??€ ?ë˜ ?¨ì–´, ?˜ë¨¸ì§€??ë°˜ë³µ
                        expanded_version += current  # ?ë˜ ?„ì¹˜
                        i += 1
                    else:
                        # "ë§ˆì¢‹ì¢‹ì¢‹" ??"ë§? + "ì¢‹ì•„ ì¢‹ì•„ ì¢‹ì•„"
                        # ?°ì† ?Œì ˆ??"X??X??X?? ?•íƒœë¡??•ì¥
                        expanded_part = " ".join([current] * consecutive_count)
                        expanded_version += " " + expanded_part
                        i += consecutive_count
                else:
                    expanded_version += current
                    i += 1
            
            # ?ë³¸ ë³´ì¡´
            expanded_terms.append(term_clean)
            
            # ë°˜ë³µ ?¨í„´???ˆìœ¼ë©??•ì¥ ë²„ì „??ì¶”ê?
            if repetition_found:
                # ?•ì¥ ë²„ì „??ê²€??ì¿¼ë¦¬ë¡?ì¶”ê?
                expanded_clean = expanded_version.strip()
                
                # ê°„ë‹¨???´ë¦¬?¤í‹±: ë°˜ë³µ ?¨í„´ ???¨ì–´ ?•ì¥?¼ë¡œ??ê²€??
                # (?¤ì œ ê²€??ê²°ê³¼ê°€ ?´ë? ê²€ì¦í•  ê²?
                if len(expanded_clean) > 0:
                    expanded_terms.append(expanded_clean)
                    
                    # ì¶”ê? ë³€?? ë°˜ë³µ ?†ëŠ” ë²„ì „???œë„
                    # [?‘ë‘][?Œì ˆë°˜ë³µ] ??[?‘ë‘][?Œì ˆ] (ì¶•ì•½??ê°€?¥ì„±)
                    if i > 1:
                        base_part = term_clean[0] + term_clean[1]
                        expanded_terms.append(base_part)
                
                print(f"[{_ts()}][{self.emoji}] ?” ë°˜ë³µ ?¨í„´ ê°ì?: '{term_clean}' ({syllable_count}?Œì ˆ) ??{len(expanded_clean)}???•ì¥", 
                      file=sys.stderr)
        
        return list(set(expanded_terms))  # ì¤‘ë³µ ?œê±°
    
    def _check_dictionary(
        self, 
        terms: List[str], 
        slang_dict: Dict[str, str]
    ) -> Dict[str, str]:
        """Check terms against slang dictionary for direct matches."""
        matches = {}
        for term in terms:
            term_lower = term.lower().strip()
            # Direct match
            if term_lower in slang_dict:
                matches[term] = slang_dict[term_lower]
            # Check without spaces
            term_nospace = term_lower.replace(" ", "")
            if term_nospace in slang_dict:
                matches[term] = slang_dict[term_nospace]
        return matches
    
    def _merge_dict_matches(
        self, 
        result: Dict[str, Any], 
        dict_matches: Dict[str, str],
        ctx: Any = None,
    ) -> Dict[str, Any]:
        """Merge dictionary matches into result with high confidence.
        
        ?”¥ ?¬ì „ê°’ë„ ê²€??ê²°ê³¼??ê³µì‹ ?Œë«???œëª©?¼ë¡œ êµì • ê°€??
        """
        if not dict_matches:
            return result
        
        # ?”¥ ê²€??ê²°ê³¼?ì„œ ê³µì‹ ?œëª© ì¶”ì¶œ (?¬ì „ê°?êµì •??
        official_titles = []
        if ctx:
            official_titles = self._extract_official_titles_from_search(ctx)
        
        decoded_terms = result.get("decoded_terms", [])
        
        for term, title in dict_matches.items():
            # ?”¥ ?¬ì „ê°’ì„ ê²€??ê²°ê³¼??ê³µì‹ ?œëª©?¼ë¡œ êµì •
            corrected_title = self._correct_title_with_search_result(title, official_titles)
            if corrected_title != title:
                print(f"[{_ts()}][{self.emoji}] ? ï¸ ?¬ì „ê°?êµì •: '{title}' ??'{corrected_title}' (ê²€??ê²°ê³¼ ê¸°ë°˜)", file=sys.stderr)
                title = corrected_title
            
            # Find existing entry or create new
            existing = next((d for d in decoded_terms if d.get("original") == term), None)
            
            if existing:
                # Add dictionary match as top candidate
                existing["candidates"].insert(0, {
                    "official_title": title,
                    "url": None,
                    "platform": None,
                    "decode_logic": "?¬ì „ ë§¤ì¹­",
                    "morphological_score": 1.0,
                    "search_evidence": "slang_dictionary",
                })
                existing["best_match"] = {"title": title, "confidence": "high"}
            else:
                decoded_terms.append({
                    "original": term,
                    "candidates": [{
                        "official_title": title,
                        "url": None,
                        "platform": None,
                        "decode_logic": "?¬ì „ ë§¤ì¹­",
                        "morphological_score": 1.0,
                        "search_evidence": "slang_dictionary",
                    }],
                    "best_match": {"title": title, "confidence": "high"},
                    "is_author_name": False,
                    "author_info": None,
                })
        
        result["decoded_terms"] = decoded_terms
        
        # Upgrade confidence if we have dictionary matches
        if dict_matches and result.get("overall_confidence") in ("low", "none"):
            result["overall_confidence"] = "high"
        
        return result
    
    def _call_llm(self, user_prompt: str) -> Dict[str, Any]:
        """Call LLM and parse JSON response."""
        system_content = DECODER_SYSTEM.replace("{platform_map}", PLATFORM_ABBREVIATION_MAP)
        messages = [
            {"role": "system", "content": system_content},
            {"role": "user", "content": user_prompt},
        ]
        
        response_text = self.llm._stream_chat_http(
            messages=messages,
            tag="decoder",
            use_grammar=True,
        )
        
        return self._parse_json_response(response_text)
    
    def _parse_json_response(self, text: str) -> Dict[str, Any]:
        """Extract and parse JSON from response, removing <think> blocks."""
        result = parse_json_with_think_removal(text)
        
        # Safety: verification_search ì²˜ë¦¬ (ë¬¸ì????ë°°ì—´ ë³€??
        vs = result.get("verification_search")
        if vs:
            if isinstance(vs, str):
                # ?¨ì¼ ë¬¸ì?´ì„ ë°°ì—´ë¡?ë³€??
                result["verification_search"] = [vs.strip()]
            elif isinstance(vs, list):
                # ?´ë? ë°°ì—´?´ë©´ ê°???ª© ?•ë¦¬
                result["verification_search"] = [
                    q.strip() for q in vs if isinstance(q, str) and q.strip()
                ][:5]  # ìµœë? 5ê°œë¡œ ?œí•œ
        
        return result
    
    def _empty_result(self, reason: str) -> Dict[str, Any]:
        """Return empty result."""
        return {
            "decoded_terms": [],
            "needs_verification": False,
            "verification_search": None,
            "overall_confidence": "none",
            "notes": reason,
        }
    
    def _init_suspected_titles(self, result: Dict[str, Any], ctx: Any) -> None:
        """
        â­?suspected_titles ì´ˆê¸° ?ì„± (Decoderê°€ ì²?ë²ˆì§¸ë¡??ì„±)
        Verifier, Critic????ëª©ë¡??ì°¸ì¡°?˜ê³  ?˜ì •?????ˆìŒ
        
        ?”¥ CRITICAL: ê²€??ê²°ê³¼?ì„œ ê³µì‹ ?Œë«??novelpia, namu.wiki, munpia)??
        ?•í™•???œëª©??ì¶”ì¶œ?˜ì—¬ LLM ?ì„± ?œëª©??êµì •?´ì•¼ ??
        """
        suspected = []
        decoded_terms = result.get("decoded_terms", [])
        
        # ?”¥ Step 0: ê²€??ê²°ê³¼?ì„œ ê³µì‹ ?Œë«?¼ì˜ ?•í™•???œëª© ì¶”ì¶œ
        official_titles_from_search = self._extract_official_titles_from_search(ctx)
        
        def _norm_text(text: Any) -> str:
            if text is None:
                return ""
            return re.sub(r"[^\uac00-\ud7a3A-Za-z0-9]", "", str(text)).lower()

        _known_author_norms = set()
        if ctx and hasattr(ctx, "snippet_hints") and ctx.snippet_hints:
            for ah in (ctx.snippet_hints.get("author_hints") or []):
                _n = _norm_text((ah or {}).get("name"))
                if _n:
                    _known_author_norms.add(_n)
        
        for term in decoded_terms:
            if not term:
                continue
            
            # ?‘ê?ëª…ì? ?œì™¸
            if term.get("is_author_name"):
                continue
            
            # best_match?ì„œ title ?•ì¸
            best_match = term.get("best_match") or {}
            if not best_match.get("title"):
                continue
            
            # candidates?ì„œ ?„ë³´ ì¶”ì¶œ
            candidates = term.get("candidates", [])
            for cand in candidates[:2]:  # ?ìœ„ 2ê°œê¹Œì§€
                if not cand or not isinstance(cand, dict):
                    continue
                
                title = cand.get("official_novel_title") or cand.get("official_title")
                if not title:
                    continue
                
                # ?”¥ CRITICAL: LLM ?ì„± ?œëª©??ê²€??ê²°ê³¼??ê³µì‹ ?œëª©ê³?ë¹„êµ?˜ì—¬ êµì •
                title = self._correct_title_with_search_result(title, official_titles_from_search)
                if _norm_text(title) in _known_author_norms:
                    continue
                
                # ì¤‘ë³µ ì²´í¬
                if any(s.get("title") == title for s in suspected):
                    continue
                
                suspected.append({
                    "title": title,
                    "confidence": cand.get("morphological_score", 0.5),
                    "source_term": term.get("original", "Unknown"),
                    "source_expert": "decoder",
                    "status": "suspected",  # suspected ??verified ??confirmed
                })
        
        # ?†• interpretations?ì„œ ?‘ê?ëª??½ì¹­(author_abbreviation) ?´ì„ ?œìš©
        # LLM??interpretations??author_abbreviation ?´ì„??ê¸°ë¡??ê²½ìš°,
        # ?´ë‹¹ ?‘ê????‘í’ˆ??ê²€??ê²°ê³¼?ì„œ ì°¾ì•„ suspected_titles??ì¶”ê?
        for term in decoded_terms:
            if not term or not isinstance(term, dict):
                continue
            
            # ?”¥ ?„í‚¤?€??ì°¨ë‹¨??term?´ë©´ multi-interp??ê±´ë„ˆ?€
            # _guard_archetype_as_title?ì„œ confidence="none"?¼ë¡œ ?¤ì •??ê²½ìš°
            best_match_for_term = term.get("best_match") or {}
            if best_match_for_term.get("confidence") == "none":
                original_term = term.get("original", "")
                if original_term.strip() in GENRE_ARCHETYPE_TERMS:
                    continue
            
            interps = term.get("interpretations") or []
            for interp in interps:
                if not isinstance(interp, dict):
                    continue
                interp_type = interp.get("type", "")
                context_fit = interp.get("context_fit", "low")
                interp_value = interp.get("value", "")
                
                # ?‘ê?ëª??‘ê??½ì¹­ ?´ì„???ˆê³  ë³¸ë¬¸ ë§¥ë½ ?í•©?„ê? medium ?´ìƒ?´ë©´
                if interp_type in ("author_name", "author_abbreviation") and context_fit in ("high", "medium") and interp_value:
                    # ctx._resolved_authors??ì¶”ê? (downstream?ì„œ ?œìš©)
                    if ctx and not hasattr(ctx, '_multi_interp_authors'):
                        ctx._multi_interp_authors = []
                    if interp_value not in ctx._multi_interp_authors:
                        ctx._multi_interp_authors.append(interp_value)
                        print(
                            f"[{_ts()}][{self.emoji}] ?§  ?¤ì¤‘?´ì„: '{term.get('original')}' ??"
                            f"?‘ê? '{interp_value}' (fit={context_fit})",
                            file=sys.stderr,
                        )
                
                # ?‘í’ˆ ?½ì¹­ ?´ì„???ˆê³  best_matchê°€ ë¹„ì–´?ˆëŠ” ê²½ìš° ??suspected_titles ë³´ì¶©
                if interp_type == "novel_title" and context_fit in ("high", "medium") and interp_value:
                    if _norm_text(interp_value) in _known_author_norms:
                        continue
                    if not any(s.get("title") == interp_value for s in suspected):
                        conf = 0.75 if context_fit == "high" else 0.55
                        suspected.append({
                            "title": interp_value,
                            "confidence": conf,
                            "source_term": term.get("original", "Unknown"),
                            "source_expert": "decoder_multi_interp",
                            "status": "suspected",
                        })
                        print(
                            f"[{_ts()}][{self.emoji}] ?§  ?¤ì¤‘?´ì„: '{term.get('original')}' ??"
                            f"?‘í’ˆ '{interp_value}' (fit={context_fit})",
                            file=sys.stderr,
                        )
        
        # ctx???€??(ê¸°ì¡´ ê²ƒê³¼ ë³‘í•©)
        existing = getattr(ctx, "suspected_titles", []) or []
        
        # ?†• decoded_terms?ì„œ ?œëª©??ëª?ì°¾ì•˜ì§€ë§?_resolved_mappings??ë§¤í•‘???ˆìœ¼ë©?ë³´ì¶©
        # ?µì‹¬: LLM???´ë? ?´ë…???½ì¹­??decoded_terms??ë°˜ë³µ?˜ì? ?ŠëŠ” ê²½ìš° ?€ë¹?
        if not suspected and ctx:
            _resolved = getattr(ctx, '_resolved_mappings', []) or []
            if _resolved:
                # ê²€??ê²°ê³¼?ì„œ ê³µì‹ ?œëª© ?•ì¸
                official_titles_from_search = self._extract_official_titles_from_search(ctx)
                existing_titles = {s.get('title') for s in existing}
                
                for abbrev, full_title in _resolved:
                    # ê²€??ê²°ê³¼??ê³µì‹ ?œëª©?¼ë¡œ êµì •
                    corrected = self._correct_title_with_search_result(full_title, official_titles_from_search)
                    if _norm_text(corrected) in _known_author_norms:
                        continue
                    if corrected in existing_titles:
                        continue
                    
                    # ??ë§¤í•‘??ê²€?‰ì—???•ì¸??ê²ƒì¸ì§€ ì²´í¬ (snippet_hints ê¸°ë°˜)
                    from_snippet = hasattr(ctx, 'snippet_hints') and ctx.snippet_hints
                    
                    suspected.append({
                        "title": corrected,
                        "confidence": 0.85 if from_snippet else 0.7,
                        "source_term": abbrev,
                        "source_expert": "decoder_mapping",
                        "status": "suspected",
                    })
                    existing_titles.add(corrected)
                
                if suspected:
                    print(
                        f"[{_ts()}][{self.emoji}] ?“‹ resolved_mappings ?´ë°±: "
                        f"decoded_terms ë¹„ì–´?ˆìŒ ??_resolved_mappings?ì„œ {len(suspected)}ê±?ë³´ì¶©",
                        file=sys.stderr,
                    )
        
        merged = []
        seen_titles = set()
        for st in (existing + suspected):
            if not isinstance(st, dict):
                continue
            title = st.get("title", "")
            title_norm = _norm_text(title)
            if not title_norm or title_norm in _known_author_norms or title_norm in seen_titles:
                continue
            seen_titles.add(title_norm)
            merged.append(st)
        ctx.suspected_titles = merged[:5]  # ÃÖ´ë 5°³
        
        if suspected:
            print(f"[{_ts()}][{self.emoji}] seeded suspected_titles: {len(suspected)}", file=sys.stderr)
            for i, st in enumerate(suspected[:5], 1):
                title = st.get('title', 'N/A')
                conf = st.get('confidence', 'N/A')
                source = st.get('source_expert', 'decoder')
                print(f"[{_ts()}][{self.emoji}]    [{i}] {title} (conf={conf}, from={source})", file=sys.stderr)
    
    def _guard_community_title(self, result: Dict[str, Any], ctx: Any) -> Dict[str, Any]:
        """
        ?”¥ ì»¤ë??ˆí‹° ?œëª© ë°©ì–´ ?„ì²˜ë¦?
        
        LLM??best_match.titleë¡?ë°˜í™˜???œëª©??ê²€??ê²°ê³¼?ì„œ
        ì»¤ë??ˆí‹° URL(dcinside, arca.live, fmkorea ???ì„œë§??˜ì˜¨ ê²½ìš°:
        1. ê³µì‹ ?Œë«??content?ì„œ ì¶”ì¶œ???€???œëª©???ˆìœ¼ë©?êµì²´
        2. ?†ìœ¼ë©?? ë¢°?„ë? lowë¡?ê°•ì œ ?˜í–¥ + verification_search ?¬ìš”ì²?
        """
        import re
        from difflib import SequenceMatcher
        
        community_domains = [
            "dcinside.com", "fmkorea.com", "arca.live", "ruliweb.com",
            "theqoo.net", "clien.net", "arcalive.com",
        ]
        
        search_results = getattr(ctx, "search_results", []) or []
        if not search_results:
            return result
        
        # ê³µì‹ ?Œë«??content?ì„œ ì¶”ì¶œ???œëª©
        official_from_content = self._extract_official_titles_from_search(ctx)
        content_only_titles = [t for t in official_from_content if t.get("source") == "content_field"]
        
        decoded_terms = result.get("decoded_terms", [])
        changed = False
        
        for term in decoded_terms:
            best_match = term.get("best_match") or {}
            title = best_match.get("title", "")
            if not title:
                continue
            
            # ???œëª©??ê²€??ê²°ê³¼?ì„œ ?´ë””???˜ì™”?”ì? ?•ì¸
            title_norm = title.strip().lower()
            found_in_official = False
            found_in_community = False
            
            for sr in search_results:
                sr_url = sr.get("url", "").lower()
                sr_title = (sr.get("title", "") or "").lower()
                sr_content = (sr.get("content", "") or sr.get("snippet", "") or "").lower()
                
                # ??ê²€??ê²°ê³¼???´ë‹¹ ?œëª©???¸ê¸‰?˜ëŠ”ì§€ ?•ì¸
                if title_norm not in sr_title and title_norm not in sr_content:
                    # ? ì‚¬?„ë¡œ???•ì¸ (ë¶€ë¶??¼ì¹˜)
                    sim_t = SequenceMatcher(None, title_norm, sr_title).ratio()
                    sim_c = SequenceMatcher(None, title_norm, sr_content[:100]).ratio() if sr_content else 0
                    if sim_t < 0.7 and sim_c < 0.5:
                        continue
                
                is_community = any(cd in sr_url for cd in community_domains)
                if is_community:
                    found_in_community = True
                else:
                    found_in_official = True
            
            # ì»¤ë??ˆí‹°?ì„œë§?ë°œê²¬?˜ê³  ê³µì‹ ?Œë«?¼ì—?œëŠ” ?†ëŠ” ê²½ìš°
            if found_in_community and not found_in_official:
                original_term = term.get("original", "")
                
                # ?†• ë³µí•©??ë³´ì •: morphemes?ì„œ ?œëª© ë¶€ë¶„ë§Œ ì¶”ì¶œ
                effective_term = original_term
                morphs = term.get("morphemes") or []
                if morphs and len(morphs) >= 2 and title:
                    title_n = title.replace(" ", "")
                    title_morphs = [m for m in morphs if m in title_n or m in title]
                    if title_morphs and len(title_morphs) < len(morphs):
                        effective_term = "".join(title_morphs)
                
                # content_field?ì„œ ì¶”ì¶œ???€???œëª© ì¤??ë³¸ ?½ì¹­ê³?ë§¤ì¹­?˜ëŠ” ê²?ì°¾ê¸°
                best_alt = None
                best_alt_score = 0.0
                
                for alt in content_only_titles:
                    alt_title = alt["title"]
                    score = abbreviation_match_score(effective_term, alt_title)
                    
                    if score > best_alt_score:
                        best_alt_score = score
                        best_alt = alt
                
                # ?”¥ Fallback: ?½ì¹­ bigram ë§¤ì¹­ ?¤íŒ¨ ??LLM ?œëª© vs ê³µì‹ ?œëª© ? ì‚¬??ë¹„êµ
                if (not best_alt or best_alt_score < 0.3) and content_only_titles:
                    for alt in content_only_titles:
                        alt_title = alt["title"]
                        sim = SequenceMatcher(None, title_norm, alt_title.lower()).ratio()
                        if sim > best_alt_score and sim >= 0.35:
                            best_alt_score = sim
                            best_alt = alt
                
                # ?”¥ Fallback 2: ?„ì²´ ê³µì‹ ?œëª© (content_field ?´ì™¸)ê³¼ë„ ë¹„êµ
                if (not best_alt or best_alt_score < 0.3):
                    all_officials = self._extract_official_titles_from_search(ctx)
                    for alt in all_officials:
                        alt_title = alt["title"]
                        sim = SequenceMatcher(None, title_norm, alt_title.lower()).ratio()
                        if sim > best_alt_score and sim >= 0.35:
                            best_alt_score = sim
                            best_alt = alt
                
                if best_alt and best_alt_score >= 0.3:
                    # ?€???œëª©?¼ë¡œ êµì²´
                    old_title = title
                    new_title = best_alt["title"]
                    best_match["title"] = new_title
                    best_match["confidence"] = "medium"
                    
                    # candidates?ë„ ì¶”ê?
                    candidates = term.get("candidates", [])
                    candidates.insert(0, {
                        "official_title": new_title,
                        "url": best_alt.get("url"),
                        "platform": best_alt.get("platform"),
                        "decode_logic": "ì»¤ë??ˆí‹° ?œëª© êµì • ??ê³µì‹ ?Œë«??content ì¶”ì¶œ",
                        "morphological_score": best_alt_score,
                        "search_evidence": f"content_field ({best_alt.get('platform')})",
                    })
                    term["candidates"] = candidates
                    
                    print(f"[{_ts()}][{self.emoji}] ?›¡ï¸?ì»¤ë??ˆí‹° ?œëª© ë°©ì–´: '{old_title}' ??'{new_title}' "
                          f"(community_only=True, alt_score={best_alt_score:.2f}, platform={best_alt.get('platform')})",
                          file=sys.stderr)
                    changed = True
                else:
                    # ?€?ˆì´ ?†ìœ¼ë©?? ë¢°??ê°•ì œ ?˜í–¥ + ?½ì¹­ ê¸°ë°˜ ?¬ê???? ë„
                    if best_match.get("confidence") in ("high", "medium"):
                        best_match["confidence"] = "low"
                        print(f"[{_ts()}][{self.emoji}] ? ï¸ ì»¤ë??ˆí‹° ?œëª© ?˜ì‹¬: '{title}' ??confidence=low "
                              f"(ì»¤ë??ˆí‹° URL?ì„œë§?ë°œê²¬?? ê³µì‹ ?Œë«??ì¦ê±° ?†ìŒ)",
                              file=sys.stderr)
                        changed = True
                    
                    # ?¬ê???ì¿¼ë¦¬ ì¶”ê?: ?ë³¸ ?½ì¹­?¼ë¡œ ê³µì‹ ?Œë«??ê²€??
                    if original_term:
                        vs = result.get("verification_search") or []
                        if isinstance(vs, str):
                            vs = [vs]
                        # ?½ì¹­ ë¶„ë¦¬?˜ì—¬ ê²€??(?? "ì¦‰ì‚¬ë¬´ë¦¼" ??"ì¦‰ì‚¬ ë¬´ë¦¼ ?¹ì†Œ??)
                        orig_clean = re.sub(r'[^\uac00-\ud7a3]', '', original_term)
                        if len(orig_clean) >= 4:
                            split_q = orig_clean[:3] + " " + orig_clean[3:] + " ¼Ò¼³"
                            if split_q not in vs:
                                vs.append(split_q)
                        else:
                            fallback_q = orig_clean + " ¼Ò¼³ °ø½Ä"
                            if fallback_q not in vs:
                                vs.append(fallback_q)
                        result["verification_search"] = vs
                        result["needs_verification"] = True
        
        return result
    
    def _correct_title_from_platform_url(self, result: Dict[str, Any], ctx: Any) -> Dict[str, Any]:
        """
        ?”¥ ?Œë«??URL ê¸°ë°˜ ?œëª© êµì •
        
        Decoder LLM??candidate URL?€ ê³µì‹ ?Œë«??novelpia, munpia ???¼ë¡œ ?¬ë°”ë¥´ê²Œ
        ?¤ì •?ˆì?ë§? ?œëª©?€ ì»¤ë??ˆí‹° ë¦¬ë·° ?œëª©??ì±„íƒ??ê²½ìš°ë¥?êµì •.
        
        ?? URL=novelpia.com/novel/326040 ê²€?‰ê²°ê³??œëª©="ë§ˆë²• ì¢‹ì•„ì¢‹ì•„ì¢‹ì•„"
            Decoderê°€ "ë§ˆë²• ì¢‹ì•„, ë§ˆë²•ê³?ì¢‹ì•„" (arca.live ë¦¬ë·° ?œëª©) ë°˜í™˜
            ??"ë§ˆë²• ì¢‹ì•„ì¢‹ì•„ì¢‹ì•„"ë¡?êµì •
        """
        import re
        from difflib import SequenceMatcher
        
        search_results = getattr(ctx, "search_results", []) or []
        if not search_results:
            return result
        
        # 1. ê³µì‹ ?Œë«??URL ??ì¶”ì¶œ ?œëª© ë§??ì„±
        url_title_map: Dict[str, str] = {}
        for sr in search_results:
            sr_url = sr.get("url", "")
            if not any(p in sr_url for p in OFFICIAL_PLATFORMS):
                continue
            
            raw_title = sr.get("title", "")
            extracted = None
            
            # ë°©ë²•A: "?¬ì´?¸ëª… - ?‘í’ˆ?œëª©" ?¨í„´ ë¶„ë¦¬
            if " - " in raw_title:
                parts = raw_title.split(" - ")
                candidate = parts[-1].strip()
                # ë¶ˆí•„?”í•œ ?‘ë????œê±°
                candidate = re.sub(r'\s*\(r\d+\s*\)\s*$', '', candidate)
                if 2 <= len(candidate) <= 50:
                    extracted = candidate
            
            # ë°©ë²•B: namu.wiki URL ?”ì½”??
            if not extracted and "namu.wiki/w/" in sr_url:
                import urllib.parse
                try:
                    path = sr_url.split("/w/")[-1].split("?")[0]
                    decoded = urllib.parse.unquote(path)
                    decoded = re.sub(r'\s*\(r\d+\s*\)\s*$', '', decoded)
                    # ?†• ?˜ìœ„ ?˜ì´ì§€ ?„í„°: '/?±ì¥?¸ë¬¼' ???œê±°
                    if "/" in decoded:
                        decoded = decoded.split("/")[0]
                    if 2 <= len(decoded) <= 50:
                        extracted = decoded
                except Exception:
                    pass
            
            if extracted:
                # URL ?•ê·œ??(trailing slash, query params ?œê±°)
                norm_url = sr_url.split("?")[0].rstrip("/")
                url_title_map[norm_url] = extracted
        
        if not url_title_map:
            return result
        
        # 2. ê°?decoded_term??candidates URLê³?êµì°¨ ?•ì¸
        decoded_terms = result.get("decoded_terms", [])
        changed = False
        
        for term in decoded_terms:
            best = term.get("best_match") or {}
            bm_title = best.get("title", "")
            if not bm_title:
                continue
            
            for cand in term.get("candidates", []):
                cand_url = cand.get("url", "")
                if not cand_url:
                    continue
                
                # URL ?•ê·œ????ë§¤ì¹­
                cand_norm = cand_url.split("?")[0].rstrip("/")
                official_title = url_title_map.get(cand_norm)
                
                if not official_title:
                    continue
                
                # ?œëª©???´ë? ?™ì¼?˜ë©´ ?¤í‚µ
                if official_title == bm_title:
                    continue
                
                # ? ì‚¬???•ì¸ (?ˆë¬´ ?¤ë¥´ë©??¤êµ??ë°©ì?)
                sim = SequenceMatcher(
                    None, bm_title.lower(), official_title.lower()
                ).ratio()
                
                # ? ì‚¬??0.25 ?´ìƒ?´ë©´ êµì • (ê°™ì? ?‘í’ˆ???¤ë¥¸ ?œê¸°??ê°€?¥ì„±)
                # ?ëŠ” ê³µìœ  ?•íƒœ?Œê? ?ˆìœ¼ë©?êµì •
                shared_morphemes = sum(
                    1 for ch in set(bm_title.replace(" ", ""))
                    if ch in official_title
                )
                shared_ratio = shared_morphemes / max(
                    len(set(bm_title.replace(" ", ""))), 1
                )
                
                if sim >= 0.25 or shared_ratio >= 0.4:
                    # ?†• BUG-A ë°©ì–´: ?½ì–´ ?¤ì½”?????ì¦?
                    # ?„ì¬ ?œëª©???½ì–´ ë§¤ì¹­??êµì • ?„ë³´ë³´ë‹¤ ?’ìœ¼ë©?êµì • ê±°ë?
                    # (?? "ì¦‰ì‚¬ë¬´ë¦¼" ??"ì¦‰ì‚¬ê¸??¤ê³  ë¬´ë¦¼???¨ì–´ì§€??(0.9) vs "ì¦‰ì‚¬ê¸??¤ê³  ê²Œì„ ?ìœ¼ë¡?(0.0))
                    original_term = term.get("original", "")
                    if original_term and len(original_term) >= 2:
                        old_abbr_score = abbreviation_match_score(original_term, bm_title)
                        new_abbr_score = abbreviation_match_score(original_term, official_title)
                        if old_abbr_score > new_abbr_score + 0.1:
                            print(
                                f"[{_ts()}][{self.emoji}] ?›¡ï¸??Œë«??URL ?œëª© êµì • ê±°ë?: "
                                f"'{bm_title}'(abbr={old_abbr_score:.2f}) ??'{official_title}'(abbr={new_abbr_score:.2f}) "
                                f"?½ì–´ ?¤ì½”???? „ ??êµì • ?ˆí•¨",
                                file=sys.stderr,
                            )
                            continue
                    
                    old_title = bm_title
                    best["title"] = official_title
                    cand["official_novel_title"] = official_title
                    
                    # confidence ? ì? ?ëŠ” ?í–¥
                    if best.get("confidence") in ("low", "none"):
                        best["confidence"] = "medium"
                    
                    print(
                        f"[{_ts()}][{self.emoji}] ?›¡ï¸??Œë«??URL ?œëª© êµì •: "
                        f"'{old_title}' ??'{official_title}' "
                        f"(url={cand_url}, sim={sim:.2f}, shared={shared_ratio:.2f})",
                        file=sys.stderr,
                    )
                    changed = True
                    # best_match ?œëª©??ë°”ë€Œì—ˆ?¼ë?ë¡???term ë£¨í”„ ì¢…ë£Œ
                    break
        
        if changed:
            # overall_confidence ?¬ê³„?? êµì • ??? ë¢°???í–¥ ê°€??
            confs = []
            for term in decoded_terms:
                bm = term.get("best_match") or {}
                c = bm.get("confidence", "none")
                confs.append(c)
            if "high" in confs:
                result["overall_confidence"] = "high"
            elif "medium" in confs:
                result["overall_confidence"] = "medium"
        
        return result
    
    def _validate_genre_cross_match(self, result: Dict[str, Any], ctx: Any) -> Dict[str, Any]:
        """
        ?”¥ ?¥ë¥´ êµì°¨ê²€ì¦? ?¬ìŠ¤??ë³¸ë¬¸???¥ë¥´?€ ?„ë³´ ?‘í’ˆ???¥ë¥´ ë¶ˆì¼ì¹???ì°¨ë‹¨
        
        ?? ë³¸ë¬¸??"ë§ˆì™•, ?€ë§ˆë²•?? ?©ì‚¬, ?„ì ?? ??fantasy
            ?„ë³´ ?‘í’ˆ "ì´ˆë???B" ??romance
            ???¥ë¥´ ë¶ˆì¼ì¹???confidence ?˜í–¥
        """
        # 1. ë³¸ë¬¸?ì„œ ?¥ë¥´ ?¤ì›Œ??ì¶”ì¶œ
        post_data = getattr(ctx, 'post_data', {}) or {}
        content_texts = []
        post_title = post_data.get("title", "")
        for block in post_data.get("content_blocks", []):
            if isinstance(block, dict) and block.get("text"):
                content_texts.append(block["text"])
            elif isinstance(block, str):
                content_texts.append(block)
        all_text = post_title + " " + " ".join(content_texts + (getattr(ctx, 'comments', []) or []))
        
        # ê°??¥ë¥´ë³??¤ì›Œ???ˆíŠ¸ ??ê³„ì‚°
        genre_hits: Dict[str, int] = {}
        for genre, keywords in GENRE_KEYWORDS.items():
            hits = sum(1 for kw in keywords if kw in all_text)
            if hits > 0:
                genre_hits[genre] = hits
        
        if not genre_hits:
            return result  # ë³¸ë¬¸?ì„œ ?¥ë¥´ ?¤ì›Œ???†ìŒ ??ê²€ì¦?ë¶ˆê?
        
        # ê°€??ë§ì´ ?ˆíŠ¸???¥ë¥´
        post_genre = max(genre_hits, key=genre_hits.get)
        post_genre_hits = genre_hits[post_genre]
        
        if post_genre_hits < 2:
            return result  # ?¤ì›Œ??1ê°œë§Œ ?ˆíŠ¸ ???¥ë¥´ ?•ì • ë¶ˆê?
        
        # 2. ?„ë³´ ?‘í’ˆ???¥ë¥´ ?•ì¸ (ê²€??ê²°ê³¼ snippet?ì„œ)
        decoded_terms = result.get("decoded_terms", [])
        for term in decoded_terms:
            if term.get("is_author_name"):
                continue
            
            best_match = term.get("best_match") or {}
            title = best_match.get("title")
            if not title or best_match.get("confidence") in ("none", "low"):
                continue
            
            # ?„ë³´ ?‘í’ˆ???¥ë¥´ ì¶”ì¶œ: candidates??genre_match ?ëŠ” ê²€??ê²°ê³¼?ì„œ
            candidate_genres = set()
            for cand in term.get("candidates", []):
                gm = cand.get("genre_match") or {}
                tg = gm.get("target_genre", "")
                if tg:
                    # target_genre ë¬¸ì?´ì„ ?°ë¦¬ ?¥ë¥´ ?¤ì— ë§¤í•‘
                    tg_lower = tg.lower()
                    for genre, keywords in GENRE_KEYWORDS.items():
                        if tg_lower in [kw.lower() for kw in keywords] or tg_lower == genre:
                            candidate_genres.add(genre)
                    # ì§ì ‘ ë§¤í•‘
                    genre_map = {
                        "·Î¸Ç½º": "romance", "romance": "romance", "·ÎÆÇ": "romance",
                        "ÆÇÅ¸Áö": "fantasy", "fantasy": "fantasy", "ÇöÆÇÅ¸Áö": "fantasy",
                        "¹«Çù": "martial_arts", "martial_arts": "martial_arts",
                        "Çö´ë": "modern", "modern": "modern",
                    }
                    if tg_lower in genre_map:
                        candidate_genres.add(genre_map[tg_lower])
            
            if not candidate_genres:
                continue
            
            # 3. ?¥ë¥´ ë¶ˆì¼ì¹??ì •
            if post_genre not in candidate_genres:
                old_conf = best_match.get("confidence", "medium")
                best_match["confidence"] = "low"
                
                # overall_confidence???˜í–¥
                if result.get("overall_confidence") in ("high", "medium"):
                    result["overall_confidence"] = "low"
                
                print(f"[{_ts()}][{self.emoji}] ?š¨ ?¥ë¥´ êµì°¨ê²€ì¦??¤íŒ¨: "
                      f"'{title}' ?¥ë¥´={candidate_genres} vs ë³¸ë¬¸ ?¥ë¥´={post_genre}"
                      f"(hits={post_genre_hits}) ??confidence={old_conf}?’low",
                      file=sys.stderr)
        
        return result
    
    def _validate_morpheme_in_title(self, result: Dict[str, Any], ctx: Any) -> Dict[str, Any]:
        """
        ?”¥ ?½ì–´-?œëª© ë§¤ì¹­ ê²€ì¦?(ì½”ë“œ ?ˆë²¨ + LLM morphemes ë³‘í–‰)

        1?¨ê³„: abbreviation_match_score()ë¡??½ì–´?”í˜„???„ë³´ ?¤ì½”??ê³„ì‚°
        2?¨ê³„: ?¤ì½”?´ê? ??œ¼ë©?ê²€??ê²°ê³¼?ì„œ ???’ì? ?¤ì½”?´ì˜ ?„ë³´ ?ìƒ‰
        3?¨ê³„: LLM morphemes??ë³´ì¡° ê²€ì¦ìœ¼ë¡??œìš© (?ˆëŠ” ê²½ìš°)

        LLM??morphemesë¥??˜ëª» ë¶„ì ˆ?´ë„ ì½”ë“œ ?ˆë²¨ ?¤ì½”?´ê? ?…ë¦½?ìœ¼ë¡?ê²€ì¦?
        """
        decoded_terms = result.get("decoded_terms", [])
        if not decoded_terms:
            return result

        # ê²€??ê²°ê³¼?ì„œ ?„ë³´ ?œëª© ?˜ì§‘
        all_search_titles = self._extract_official_titles_from_search(ctx)
        search_results = getattr(ctx, "search_results", []) or []

        # ê²€??ê²°ê³¼ snippet/title?ì„œ ? ì¬???‘í’ˆ ?œëª© ì¶”ì¶œ
        raw_title_pool: list[str] = []  # (?œëª© ?„ë³´, ì¶œì²˜) ??
        for official in all_search_titles:
            raw_title_pool.append(official["title"])
        for sr in search_results:
            sr_title = sr.get("title", "")
            sr_content = sr.get("content", "") or sr.get("snippet", "")
            if sr_title:
                # ?†• BUG-B ë°©ì–´: ê²€?‰ê²°ê³??œëª©?ì„œ ?¬ì´?¸ëª…/ê²Œì‹œ???‘ë‘???•ì œ
                # "ë¸”ë¼?¸ë“œ | ?¹ì†Œ??ì¢…í† ë°? ?¤ëŠ˜?„ìš” - ì¦‰ì‚¬ê¸??¤ê³  ë¬´ë¦¼???¨ì–´ì§€??
                # ??"ì¦‰ì‚¬ê¸??¤ê³  ë¬´ë¦¼???¨ì–´ì§€?? ?±ìœ¼ë¡?ë¶„ë¦¬?˜ì—¬ ì¶”ê?
                cleaned_titles = self._clean_search_result_title(sr_title)
                raw_title_pool.extend(cleaned_titles)
            # content?ì„œ Kiwi ëª…ì‚¬ ì¡°í•© ?ëŠ” êµ¬ë¬¸ ì¶”ì¶œ
            if sr_content:
                self._extract_title_candidates_from_text(sr_content, raw_title_pool)

        # ?€?€ Gatekeeper possible_titles ?µí•© (?“ê? ì¶”ì¶œ ?œëª© ?¬í•¨) ?€?€
        gk_out = ctx.expert_outputs.get("gatekeeper") or {}
        gk_entities = gk_out.get("detected_entities") or {}
        gk_possible = gk_entities.get("possible_titles") or []
        for gk_title in gk_possible:
            if isinstance(gk_title, str) and len(gk_title) >= 2:
                raw_title_pool.append(gk_title)
        if gk_possible:
            print(
                f"[{_ts()}][{self.emoji}] ?“¥ Gatekeeper possible_titles ??title_pool: "
                f"{gk_possible}",
                file=sys.stderr,
            )

        # ì¤‘ë³µ ?œê±°
        seen_titles: set[str] = set()
        title_pool: list[str] = []
        for t in raw_title_pool:
            t_stripped = t.strip()
            if t_stripped and t_stripped not in seen_titles:
                seen_titles.add(t_stripped)
                title_pool.append(t_stripped)

        changed = False

        for term in decoded_terms:
            if term.get("is_author_name"):
                continue

            original = term.get("original", "")
            if not original or len(original) < 2:
                continue

            # ?†• interpretations??author_name??high fit?¼ë¡œ ?ˆìœ¼ë©??½ì–´ ê°€???¤í‚µ
            # LLM??is_author_name=falseë¡??¤ì •?ˆì?ë§?interpretations???‘ê?ëª??´ì„???ˆëŠ” ëª¨ìˆœ ë°©ì–´
            # ?? "?Œì¡°" ??interpretations??type="author_name", context_fit="high" ?ˆëŠ”??
            #     is_author_name=false + best_match.title="ë¯¸êµ­ ?ˆíŠ¸ë¡??Œì„¤ê°€ê°€ ?˜ì—ˆ?? ??score=0.00
            #     ???´ê²ƒ?€ ?½ì–´ ë¶ˆì¼ì¹˜ê? ?„ë‹ˆ???‘ê??’ë??œì‘ ë§¤í•‘?´ë?ë¡??½ì–´ ê°€???€?ì´ ?„ë‹˜
            _interps = term.get("interpretations", [])
            _has_author_interp = any(
                (i.get("type") == "author_name" and i.get("context_fit") in ("high", "medium"))
                for i in _interps
                if isinstance(i, dict)
            )
            if _has_author_interp:
                print(
                    f"[{_ts()}][{self.emoji}] ?¹ï¸ ?‘ê?ëª??´ì„ ì¡´ì¬ '{original}' ???½ì–´ ê°€???¤í‚µ "
                    f"(is_author_name=false?´ì?ë§?interpretations??author_name ?ˆìŒ)",
                    file=sys.stderr,
                )
                continue

            # ?†• ìºë¦­?°ëª…?€ ?½ì–´ ê°€???€?ì´ ?„ë‹˜ ???¤í‚µ
            # Decoderê°€ anchor_type="character_mention"?¼ë¡œ ?ë³„??term?€
            # ?œëª© ?½ì–´ê°€ ?„ë‹ˆ??ìºë¦­???´ë¦„?´ë?ë¡?abbreviation_match_score ê²€ì¦?ë¶ˆí•„??
            grounding_info = term.get("grounding") or {}
            is_character_term = (
                grounding_info.get("anchor_type") == "character_mention"
                or (len(original) <= 3 and any(
                    (term.get("original") or "") in (c or "")
                    for c in (ctx.expert_outputs.get("gatekeeper") or {}).get("detected_entities", {}).get("possible_characters", [])
                ))
            )
            if is_character_term:
                print(
                    f"[{_ts()}][{self.emoji}] ?¹ï¸ ìºë¦­?°ëª… '{original}' ???½ì–´ ê°€???¤í‚µ "
                    f"(anchor_type={grounding_info.get('anchor_type')})",
                    file=sys.stderr,
                )
                continue

            best_match = term.get("best_match") or {}
            current_title = best_match.get("title")

            # ?€?€ ?†• Rescue: LLM??title=null??ë°˜í™˜??ê²½ìš°, ê²€??ê²°ê³¼?ì„œ ?ë™ ë§¤ì¹­ ?œë„ ?€?€
            if not current_title:
                if len(original) >= 3:
                    rescue_title, rescue_score, rescue_src = self._rescue_null_title(
                        original, term, title_pool, all_search_titles,
                        search_results, ctx,
                    )
                    if rescue_title:
                        best_match["title"] = rescue_title
                        best_match["confidence"] = "medium"
                        # candidates?ë„ ì¶”ê?
                        cands = term.get("candidates") or []
                        cands.insert(0, {
                            "official_novel_title": rescue_title,
                            "url": None,
                            "platform": rescue_src,
                            "decode_logic": f"ì½”ë“œ ?ˆë²¨ rescue: abbreviation_match_score={rescue_score:.2f}",
                            "morphological_score": rescue_score,
                            "search_evidence": f"rescue from {rescue_src}",
                        })
                        term["candidates"] = cands
                        current_title = rescue_title
                        changed = True
                        # overall_confidence???í–¥ (null?’rescue ?±ê³µ)
                        if result.get("overall_confidence") in ("none", "low"):
                            result["overall_confidence"] = "medium"
                        print(
                            f"[{_ts()}][{self.emoji}] ?? Null?’Rescue ë§¤ì¹­: "
                            f"'{original}' ??'{rescue_title}' "
                            f"(score={rescue_score:.2f}, src={rescue_src})",
                            file=sys.stderr,
                        )
                        # ?†• rescue ê²°ê³¼??ì½”ë“œ?ˆë²¨ ?ŒíŠ¸ë¡??€??
                        if ctx:
                            if not hasattr(ctx, 'code_level_hints'):
                                ctx.code_level_hints = []
                            ctx.code_level_hints.append({
                                "type": "rescue_match",
                                "original_term": original,
                                "effective_keyword": original,
                                "corrected_title": rescue_title,
                                "abbreviation_score": round(rescue_score, 2),
                                "source": rescue_src or "search_pool",
                                "reasoning": f"LLM???œëª©???ë³„?˜ì? ëª»í–ˆ?¼ë‚˜, ì½”ë“œ ?ˆë²¨ ?½ì–´ ë¶„ì„?ì„œ '{original}'??'{rescue_title}'ê³??’ì? ë§¤ì¹­??ë³´ì„ (score={rescue_score:.2f})",
                            })
                if not current_title:
                    continue

            # ?€?€ 1?¨ê³„: ?„ì¬ ?„ë³´???½ì–´ ë§¤ì¹­ ?¤ì½”???€?€
            current_score = abbreviation_match_score(original, current_title)

            # LLM morphemes ë³´ì¡° ê²€ì¦?(?ˆìœ¼ë©?ì¶”ê? ì²´í¬)
            morphemes = term.get("morphemes", [])
            morpheme_ok = True
            effective_original = original  # ë³µí•©??ë³´ì •??
            if morphemes and len(morphemes) >= 2:
                title_norm = current_title.replace(" ", "")
                morpheme_ok = all(
                    m in title_norm or m in current_title
                    for m in morphemes
                )

                # ?†• ë³µí•©??ë³´ì •: original??[?œëª©ë¶€ë¶?+ ìºë¦­???‘ê?ëª??¼ë¡œ êµ¬ì„±??ê²½ìš°
                # morphemes ì¤?title???¬í•¨?˜ëŠ” ë¶€ë¶„ë§Œ ì¶”ì¶œ?˜ì—¬ ?¤ì½”???¬ê³„??
                # ?? original='ì¦‰ì‚¬ë¬´ë¦¼?´ìœ ë°?, morphemes=['ì¦‰ì‚¬ë¬´ë¦¼','?´ìœ ë°?], title='ì¦‰ì‚¬ë¬´ë¦¼'
                if current_score < 0.2 and len(original) > len(current_title.replace(" ", "")):
                    title_morphemes = [m for m in morphemes if m in title_norm or m in current_title]
                    non_title_morphemes = [m for m in morphemes if m not in title_morphemes]
                    if title_morphemes and non_title_morphemes:
                        # ?œëª© ë¶€ë¶?morphemeë¥??©ì³??effective_original ?ì„±
                        effective_abbr = "".join(title_morphemes)
                        comp_score = abbreviation_match_score(effective_abbr, current_title)
                        if comp_score > current_score:
                            current_score = comp_score
                            effective_original = effective_abbr
                            # non_title_morphemesê°€ ìºë¦­???‘ê?ëª…ì¸ì§€ ?•ì¸
                            morpheme_ok = True  # ?œëª© ë¶€ë¶„ë§Œ ë¹„êµ?˜ë?ë¡?OK
                            print(
                                f"[{_ts()}][{self.emoji}] ?? ë³µí•©??ë³´ì •: "
                                f"'{original}' ??effective='{effective_abbr}' "
                                f"(non_title={non_title_morphemes}, score={comp_score:.2f})",
                                file=sys.stderr,
                            )

            # ?†• ë³µí•© ?œëª© ?„ì²˜ë¦? GK entities??ìºë¦­???‘ê?ë¥?original?ì„œ ?œê±°?˜ì—¬ ?œìˆ˜ ?‘í’ˆ ?¤ì›Œ?œë¡œ ?¬ì‹œ??
            # ?? "ë§ê²œ???©ê±´??ts?œê±°" ???©ê±´??ìºë¦­?? ?œê±° ??"ë§ê²œ???¼ë¡œ ?¬ë§¤ì¹?
            # ?? "ì¦‰ì‚¬ë¬´ë¦¼?´ìœ ë°? ??? ë°±(?‘ê?) ??morpheme "?´ìœ ë°? ?•ì¥ ?œê±° ??"ì¦‰ì‚¬ë¬´ë¦¼"
            if current_score < 0.5:
                gk_out_m = ctx.expert_outputs.get("gatekeeper") or {}
                gk_ent_m = gk_out_m.get("detected_entities") or {}
                gk_chars = set(gk_ent_m.get("possible_characters") or [])
                gk_authors = set(gk_ent_m.get("possible_authors") or [])
                entities_to_remove = gk_chars | gk_authors

                # ?†• BUG-2: ê³µë°± ë¶„ë¦¬ ë³µí•©??ë³´ì • ??GKê°€ ìºë¦­?°ë? ê°ì? ëª??´ë„ ê³µë°± ê¸°ì? ë¶„ë¦¬ ?œë„
                # "ë§ê²œ???©ê±´?? ??["ë§ê²œ??, "?©ê±´??] ??ê°?ë¶€ë¶„ìœ¼ë¡??ìˆ˜ ê³„ì‚°, ìµœì„  ? íƒ
                if " " in original and not entities_to_remove:
                    parts = original.split()
                    if len(parts) >= 2:
                        best_part_score = current_score
                        best_part = None
                        for part in parts:
                            part_clean = part.strip()
                            if len(part_clean) >= 2:
                                pscore = abbreviation_match_score(part_clean, current_title)
                                if pscore > best_part_score:
                                    best_part_score = pscore
                                    best_part = part_clean
                        if best_part and best_part_score > current_score:
                            print(
                                f"[{_ts()}][{self.emoji}] ?? ê³µë°±ë¶„ë¦¬ ë³µí•©??ë³´ì •: "
                                f"'{original}' ??'{best_part}' "
                                f"(score: {current_score:.2f} -> {best_part_score:.2f})",
                                file=sys.stderr,
                            )
                            current_score = best_part_score
                            effective_original = best_part
                            if best_part_score >= 0.8:
                                morpheme_ok = True

                if entities_to_remove:
                    # ?†• morphemes ê¸°ë°˜ entity ?•ì¥ ?œê±°:
                    # GK entity "? ë°±"??morpheme "?´ìœ ë°????¬í•¨?˜ë©´, "?´ìœ ë°? ?„ì²´ë¥??œê±° ?€?ì— ì¶”ê?
                    # ?´ìœ : "ì¦‰ì‚¬ë¬´ë¦¼?´ìœ ë°? ??GK "? ë°±" ?œê±° ??"ì¦‰ì‚¬ë¬´ë¦¼?? (???”ì—¬ '??ê°€ ë§¤ì¹­ ë°©í•´)
                    #       morpheme ["ì¦‰ì‚¬", "ë¬´ë¦¼", "?´ìœ ë°?] ì°¸ì¡° ??"?´ìœ ë°? ?„ì²´ ?œê±° ??"ì¦‰ì‚¬ë¬´ë¦¼" (?•í™•)
                    expanded_entities = set(entities_to_remove)
                    if morphemes and len(morphemes) >= 2:
                        for ent in entities_to_remove:
                            for morph in morphemes:
                                # entityê°€ morpheme??suffix?´ê³ , morpheme??entityë³´ë‹¤ ê¸¸ë©´ ?•ì¥
                                if morph.endswith(ent) and len(morph) > len(ent) and morph != original:
                                    expanded_entities.add(morph)
                                # entityê°€ morphemeê³??™ì¼?˜ë©´ ?´ë? ?¬í•¨
                    
                    # original?ì„œ entity ?œê±°?˜ì—¬ ?œìˆ˜ ?‘í’ˆ ?¤ì›Œ??ì¶”ì¶œ
                    # ?•ì¥??entityë¶€??ë¨¼ì? ?œê±° (??ê¸?ê²ƒë????œê±°?´ì•¼ ?•í™•)
                    sorted_entities = sorted(expanded_entities, key=len, reverse=True)
                    stripped = original
                    for ent in sorted_entities:
                        stripped = stripped.replace(ent, "")
                    # ê³µë°±/?¹ìˆ˜ë¬¸ì ?•ë¦¬: ì¤‘ê°„ ?´ì¤‘ê³µë°± ?œê±° + ?‘ìª½ trim
                    stripped = _re.sub(r"\s+", " ", stripped).strip()
                    # ?œê±° ???¨ì? ë¬¸ì?´ì´ 2ê¸€???´ìƒ?´ë©´ ?¬ì‹œ??
                    if stripped and len(stripped) >= 2 and stripped != original:
                        stripped_score = abbreviation_match_score(stripped, current_title)
                        # ?”§ entity ?œê±°ë¡??ì„±??stripped??2?¨ê³„ ?ìƒ‰?ì„œ ì¤‘ìš”?˜ë?ë¡?
                        # current_title???€??score ê°œì„  ?¬ë??€ ë¬´ê??˜ê²Œ effective_original ì±„íƒ
                        # (?„ì¬ ?œëª©???´ë? ?€ë¦?ê²½ìš°, 2?¨ê³„ title_pool?ì„œ ?¬ë°”ë¥?ë§¤ì¹­???˜ì˜¬ ???ˆìŒ)
                        if stripped_score >= current_score:
                            if stripped_score > current_score:
                                actually_removed = expanded_entities & set(
                                    e for e in sorted_entities if e in original
                                )
                                print(
                                    f"[{_ts()}][{self.emoji}] ?? ë³µí•© ?œëª© ë¶„ë¦¬: "
                                    f"'{original}' ??entity ?œê±° ??'{stripped}' "
                                    f"(score: {current_score:.2f} -> {stripped_score:.2f}, "
                                    f"removed={actually_removed})",
                                    file=sys.stderr,
                                )
                                current_score = stripped_score
                            effective_original = stripped
                            if stripped_score >= 0.8:
                                morpheme_ok = True
                        
                        # ?†• progressive suffix trimming: stripped?ì„œ??ë§¤ì¹­ ?¤íŒ¨ ??
                        # ?ì—????ê¸€?ì”© ?œê±°?˜ë©° ?¬ì‹œ??(?”ì—¬ ì¡°ì‚¬ "??, "?? ???œê±°)
                        if current_score < 0.5 and len(stripped) >= 3:
                            for trim_len in range(1, min(3, len(stripped) - 2)):
                                trimmed = stripped[:-trim_len]
                                if len(trimmed) < 2:
                                    break
                                trim_score = abbreviation_match_score(trimmed, current_title)
                                if trim_score > current_score:
                                    print(
                                        f"[{_ts()}][{self.emoji}] ?? suffix trim: "
                                        f"'{stripped}' ??'{trimmed}' "
                                        f"(score: {current_score:.2f} -> {trim_score:.2f})",
                                        file=sys.stderr,
                                    )
                                    current_score = trim_score
                                    effective_original = trimmed
                                    if trim_score >= 0.8:
                                        morpheme_ok = True
                                    break  # ê°€???‘ì? trim?¼ë¡œ ?±ê³µ?˜ë©´ ì¤‘ë‹¨

            # ?„ì¬ ?„ë³´ê°€ ì¶©ë¶„??ì¢‹ìœ¼ë©??¤í‚µ (?¤ì½”?´ëŠ” ??ƒ ë¡œê·¸)
            print(
                f"[{_ts()}][{self.emoji}] ?“Š ?½ì–´?¤ì½”?? '{original}' ??"
                f"'{current_title}' [score={current_score:.2f}, morpheme_ok={morpheme_ok}]",
                file=sys.stderr,
            )
            if current_score >= 0.8 and morpheme_ok:
                continue

            # ?€?€ ?”’ ?„ì´?”ì–´ C: ëª…ì‹œ???½ì¹­ ì¦ê±° ?µì»¤ ?€?€
            # ê²€??ê²°ê³¼??"?½ì¹­?€ X??, "?µì¹­ X" ?±ì´ ?ˆìœ¼ë©?LLM ê²°ê³¼ ë³´í˜¸
            has_explicit_alias = False
            alias_patterns = [
                _re.compile(rf'?½ì¹­[?€?´ê?]?\s*{_re.escape(original)}'),
                _re.compile(rf'?µì¹­\s*{_re.escape(original)}'),
                _re.compile(rf'ì¤„ì—¬??s*{_re.escape(original)}'),
                _re.compile(rf'ì¤„ì„ë§??€?´ê?]?\s*{_re.escape(original)}'),
            ]
            for sr in search_results:
                sr_content = sr.get("content", "") or sr.get("snippet", "")
                sr_title_text = sr.get("title", "")
                combined = sr_title_text + " " + sr_content
                if any(p.search(combined) for p in alias_patterns):
                    has_explicit_alias = True
                    break

            if has_explicit_alias:
                # ê²€??ê²°ê³¼??ëª…ì‹œ?ìœ¼ë¡?"?½ì¹­?€ original"?´ë¼ê³??˜ì˜´ ???„ì¬ ?œëª© ë³´í˜¸
                print(
                    f"[{_ts()}][{self.emoji}] ?”’ ëª…ì‹œ???½ì¹­ ì¦ê±° ë°œê²¬: "
                    f"'{original}' = '{current_title}' ???½ì–´ ?¤ì½”??êµì • ?¤í‚µ",
                    file=sys.stderr,
                )
                continue

            # ?€?€ 2?¨ê³„: ê²€??ê²°ê³¼?ì„œ ???’ì? ?¤ì½”???„ë³´ ?ìƒ‰ ?€?€
            missing_info = ""
            if not morpheme_ok:
                missing = [m for m in morphemes if m not in current_title.replace(" ", "") and m not in current_title]
                missing_info = f", morpheme?„ë½={missing}"

            print(
                f"[{_ts()}][{self.emoji}] ? ï¸ ?½ì–´ ë§¤ì¹­ ??Œ: '{original}' ??"
                f"'{current_title}' (score={current_score:.2f}{missing_info})",
                file=sys.stderr,
            )

            best_alt_title = None
            best_alt_score = current_score
            best_alt_source = None

            # ?”§ ?„ì´?”ì–´ A-3: ì»¤ë??ˆí‹° ê²Œì‹œê¸€ ?œëª© ì¶œì²˜ êµ¬ë¶„
            _COMMUNITY_DOMAINS = (
                "ruliweb.com", "fmkorea.com", "dcinside.com",
                "arca.live", "x.com", "twitter.com", "reddit.com",
                "theqoo.net", "instiz.net", "mlbpark.donga.com",
                "clien.net", "todayhumor.co.kr", "ppomppu.co.kr",
                "inven.co.kr", "gall.dcinside.com",
                "teamblind.com", "threads.net", "threads.com",
            )
            # ì»¤ë??ˆí‹° ì¶œì²˜ ?œëª© ?ë³„???¸íŠ¸
            community_titles: set[str] = set()
            for sr in search_results:
                sr_url = sr.get("url", "")
                if any(cd in sr_url for cd in _COMMUNITY_DOMAINS):
                    sr_title_raw = sr.get("title", "").strip()
                    if sr_title_raw:
                        community_titles.add(sr_title_raw)
                        # " - " ë¶„í• ???œëª© ë¶€ë¶„ë„ ì¶”ê?
                        if " - " in sr_title_raw:
                            for part in sr_title_raw.split(" - "):
                                community_titles.add(part.strip())

            for candidate in title_pool:
                if candidate == current_title:
                    continue
                # ?„ë³´ ?œëª©???ˆë¬´ ì§§ê±°??ê¸¸ë©´ ?¤í‚µ
                if len(candidate) < 3 or len(candidate) > 40:
                    continue

                # ?š« ì»¤ë??ˆí‹° ê²Œì‹œê¸€ ?œëª©?€ ê³µì‹ ?œëª© ?„ë³´?ì„œ ?œì™¸
                if candidate in community_titles:
                    continue

                score = abbreviation_match_score(effective_original, candidate)

                # morphemes ë³´ì¡°: morphemes??ëª¨ë‘ ?¬í•¨?˜ë©´ ë³´ë„ˆ??
                if morphemes and len(morphemes) >= 2:
                    cand_norm = candidate.replace(" ", "")
                    if all(m in cand_norm or m in candidate for m in morphemes):
                        score = min(score + 0.1, 1.0)

                if score > best_alt_score:
                    best_alt_score = score
                    best_alt_title = candidate
                    # ì¶œì²˜ ?ë³„
                    best_alt_source = "search_pool"
                    for official in all_search_titles:
                        if official["title"] == candidate:
                            best_alt_source = f"platform:{official.get('platform', '?')}"
                            break

            # ?€?€ 3?¨ê³„: êµì²´ ?ëŠ” confidence ?˜í–¥ ?€?€
            # ?”§ ?„ì¬ ?œëª©??ê³µì‹ ?Œë«??ì¶œì²˜ë©?êµì • ê¸°ì? ê°•í™”
            current_from_official = any(
                official["title"] == current_title
                for official in all_search_titles
            )
            replace_margin = 0.30 if current_from_official else 0.15

            if best_alt_title and best_alt_score >= 0.7 and best_alt_score > current_score + replace_margin:
                old_title = current_title
                best_match["title"] = best_alt_title

                # candidates???…ë°?´íŠ¸
                for cand in term.get("candidates", []):
                    if cand.get("official_novel_title") == old_title:
                        cand["official_novel_title"] = best_alt_title

                print(
                    f"[{_ts()}][{self.emoji}] ?”§ ?½ì–´ ?¤ì½”??ê¸°ë°˜ ?œëª© êµì •: "
                    f"'{old_title}'(score={current_score:.2f}) ??"
                    f"'{best_alt_title}'(score={best_alt_score:.2f}) "
                    f"(source={best_alt_source})",
                    file=sys.stderr,
                )
                changed = True

                # ?†• ì½”ë“œ?ˆë²¨ ?ŒíŠ¸ë¥?ctx???€????Verifier/Arbiterê°€ ì°¸ê³ 
                if ctx:
                    if not hasattr(ctx, 'code_level_hints'):
                        ctx.code_level_hints = []
                    ctx.code_level_hints.append({
                        "type": "abbreviation_correction",
                        "original_term": original,
                        "effective_keyword": effective_original,
                        "old_title": old_title,
                        "corrected_title": best_alt_title,
                        "abbreviation_score": round(best_alt_score, 2),
                        "source": best_alt_source or "search_pool",
                        "reasoning": f"?½ì–´ '{effective_original}'??ê°??Œì ˆ??'{best_alt_title}'???¨ì–´ ì²?ê¸€?ì? ?œì°¨ ë§¤ì¹­??(score={best_alt_score:.2f})",
                    })
            elif current_score < 0.2 and not has_explicit_alias:
                # ?›¡ï¸??½ì–´?¤ì½”??ê·¹ë‹¨???€ì¡?(0.2 ë¯¸ë§Œ) ??? ë£¨?œë„¤?´ì…˜ ?˜ì‹¬
                # ?‘ê? ?„ëª…???‘í’ˆëª…ìœ¼ë¡?ë§¤ì¹­?˜ëŠ” ?±ì˜ ?¤ë¥˜ ë°©ì?
                # morpheme_ok ?¬ë??€ ë¬´ê??˜ê²Œ ê°•ì œ ?˜í–¥/ë¬´íš¨??
                # ? ï¸ ?? ê²€??ê²°ê³¼??ëª…ì‹œ???½ì¹­ ì¦ê±°ê°€ ?ˆìœ¼ë©??¤í‚µ
                # ?†• BUG-2: effective_original??ë³´ì •?˜ì–´ ?’ì? ?ìˆ˜ë¥?ê°€ì§€ë©?ê°€???°íšŒ
                effective_score = abbreviation_match_score(effective_original, current_title) if effective_original != original else current_score
                if effective_score >= 0.5:
                    print(
                        f"[{_ts()}][{self.emoji}] ?¹ï¸ ?½ì–´ ê°€???°íšŒ: "
                        f"original '{original}' score={current_score:.2f} < 0.2?´ì?ë§? "
                        f"effective '{effective_original}' score={effective_score:.2f} ??0.5 "
                        f"??confidence ? ì?",
                        file=sys.stderr,
                    )
                else:
                    old_conf = best_match.get("confidence", "medium")
                    best_match["confidence"] = "low"
                    if result.get("overall_confidence") in ("high", "medium"):
                        result["overall_confidence"] = "low"
                    print(
                        f"[{_ts()}][{self.emoji}] ?›¡ï¸??½ì–´ ?¤ì½”??ê·¹ë‹¨???€ì¡?(score={current_score:.2f}): "
                        f"'{original}' ??'{current_title}' ??confidence: {old_conf}?’low "
                        f"(? ë£¨?œë„¤?´ì…˜ ?˜ì‹¬)",
                        file=sys.stderr,
                    )
                changed = True
            elif current_score < 0.5 and not morpheme_ok:
                # ?½ì–´ ?¤ì½”?´ë„ ??³  morpheme??ë¶ˆì¼ì¹???confidence ?˜í–¥
                old_conf = best_match.get("confidence", "medium")
                if old_conf == "high":
                    best_match["confidence"] = "medium"
                    if result.get("overall_confidence") == "high":
                        result["overall_confidence"] = "medium"
                    print(
                        f"[{_ts()}][{self.emoji}] ? ï¸ ?½ì–´ ?¤ì½”????Œ+morpheme ë¶ˆì¼ì¹???"
                        f"confidence: {old_conf}?’medium (?€???†ìŒ)",
                        file=sys.stderr,
                    )

        return result

    def _rescue_null_title(
        self,
        original: str,
        term: Dict[str, Any],
        title_pool: list[str],
        official_titles: list[Dict[str, str]],
        search_results: list[Dict[str, Any]],
        ctx: Any,
    ) -> tuple:
        """
        ?? LLM??best_match.title=null??ë°˜í™˜??ê²½ìš°, ê²€??ê²°ê³¼?ì„œ ì½”ë“œ ?ˆë²¨ë¡??ë™ ë§¤ì¹­.

        1) ê³µì‹ ?Œë«??official_titles)?ì„œ abbreviation_match_scoreê°€ ê°€???’ì? ?œëª©
        2) ê²€??ê²°ê³¼ content?ì„œ "ë¬¸í”¼?„ì— X?€ ?Œì„¤" ?¨í„´?¼ë¡œ ì¶”ì¶œ???œëª©
        3) ê²€??ê²°ê³¼ ?œëª©?ì„œ " - ?‘í’ˆëª? ?¨í„´ (ë¸”ë¼?¸ë“œ ??ì»¤ë??ˆí‹°???¬í•¨ - ê³µì‹ëª…ì¹­ ?¸ìš©)

        Returns:
            (rescue_title, score, source) or (None, 0.0, None)
        """
        # ?€?€ ì»¤ë??ˆí‹° ?€???¬ì „ (BUG-5, BUG-6) ?€?€
        _COMMUNITY_SLANG = {
            "³ëº§", "À¥¼Ò¼³", "µğ½Ã", "°¶", "°¶·¯¸®", "Â©", "¹Ò", "µå¸³",
            "È«º¸", "°øÁö", "ÀÌº¥Æ®", "¹èÁö", "¹ö°ÅÇÇ¾Æ", "½Ã¸®Áî", "³×ÀÌ¹ö",
            "Ä«Ä«¿À", "¹®ÇÇ¾Æ", "³ëº§ÇÇ¾Æ",
        }

        # ?€?€ ?¥ë¥´ ?¸ë¡œ???´ë¦¬???¤ì›Œ??(BUG-1) ?€?€
        _GENRE_TROPE_KEYWORDS = {
            "È¸±Í", "È¯»ı", "¹«¸²", "¾ÆÄ«µ¥¹Ì", "ÇåÅÍ", "·¯ºê", "º¹¼ö",
            "ºùÀÇ", "ºĞ¾ç", "ÇÏ·½", "¼ºÁÂ", "°­È­", "°¢¼º", "´øÀü",
            "¸¶¹ı", "¿ëº´", "°Ë¼ú", "ÅÊÅ·", "¿µÁö", "¹ı»ç", "¸¶°è",
            "ÃµÀç", "»ıÁ¸", "ÁıÂø", "Àç¹ú", "¿µ¿õ", "¿ÕÀÚ", "¿©ÁÖ", "³²ÁÖ",
        }

        # ?†• BUG-5/6: ì»¤ë??ˆí‹° ?€?´ëŠ” Rescue ?€?ì—???œì™¸
        original_clean = original.strip().replace(" ", "")
        if original_clean in _COMMUNITY_SLANG:
            print(
                f"[{_ts()}][{self.emoji}] ?š« Rescue ?¤í‚µ: "
                f"'{original}'?€ ì»¤ë??ˆí‹° ?€??(COMMUNITY_SLANG)",
                file=sys.stderr,
            )
            return (None, 0.0, None)

        # ?†• BUG-1: ?¥ë¥´ ?¸ë¡œ???¤ì›Œ?œë§Œ?¼ë¡œ êµ¬ì„±???½ì–´??Rescue ?œí•œ
        # ? ï¸ ?? KNOWN_ABBREVIATIONS???±ë¡???½ì¹­?´ê±°??
        #    ê²€??ê²°ê³¼?ì„œ ?‘í’ˆ ?½ì¹­?¼ë¡œ ?¬ìš©?˜ëŠ” ì¦ê±°ê°€ ?ˆìœ¼ë©??µê³¼
        _KNOWN_ABBREVIATIONS_PRECHECK = set(KNOWN_ABBREVIATIONS.keys())
        original_words = set(_re.sub(r'[^\w]', ' ', original_clean).split())
        trope_words_in_original = {
            w for w in original_words
            if w and any(t in w or w in t for t in _GENRE_TROPE_KEYWORDS)
        }
        if original_words and trope_words_in_original == original_words and len(original_words) >= 1:
            # ?”¥ ?Œë ¤ì§??½ì¹­?´ë©´ ?¸ë¡œ??ì²´í¬ ë¬´ì‹œ
            if original_clean in _KNOWN_ABBREVIATIONS_PRECHECK:
                print(
                    f"[{_ts()}][{self.emoji}] ???¸ë¡œ??ì²´í¬ ?µê³¼: "
                    f"'{original}' is listed in KNOWN_ABBREVIATIONS",
                    file=sys.stderr,
                )
            else:
                # ?”¥ ê²€??ê²°ê³¼?ì„œ ???©ì–´ê°€ ?‘í’ˆ ?½ì¹­?¼ë¡œ ?°ì´??ì¦ê±° ?•ì¸
                search_evidence_found = False
                for sr in search_results:
                    sr_text = (sr.get("title", "") + " " + (sr.get("content") or "")).lower()
                    # "ì¦‰ì‚¬ë¬´ë¦¼ ?‘ê?", "ì¦‰ì‚¬ë¬´ë¦¼ ë¦¬ë·°", "ì¦‰ì‚¬ë¬´ë¦¼ ì¶”ì²œ" ?????‘í’ˆ?¼ë¡œ ?¬ìš©
                    if original_clean in sr_text:
                        for indicator in ("ÀÛ°¡", "¸®ºä", "ÃßÃµ", "¿¬Àç", "À¥¼Ò¼³", "¼Ò¼³", "ÀÛÇ°"):
                            if indicator in sr_text:
                                search_evidence_found = True
                                break
                    if search_evidence_found:
                        break
                
                if search_evidence_found:
                    print(
                        f"[{_ts()}][{self.emoji}] ???¸ë¡œ??ì²´í¬ ?µê³¼: "
                        f"'{original}'?€ ê²€??ê²°ê³¼?ì„œ ?‘í’ˆ ?½ì¹­ ì¦ê±° ë°œê²¬",
                        file=sys.stderr,
                    )
                else:
                    # ë³¸ë¬¸???‘í’ˆ ?Œë«??URL???ˆëŠ”ì§€ ?•ì¸
                    post_data = getattr(ctx, 'post_data', {}) or {}
                    post_body_parts = []
                    for block in post_data.get("content_blocks", []):
                        if isinstance(block, dict) and block.get("text"):
                            post_body_parts.append(block["text"])
                        elif isinstance(block, str):
                            post_body_parts.append(block)
                    post_body = " ".join(post_body_parts)
                    comments_text = " ".join(getattr(ctx, 'comments', []) or [])
                    full_text = f"{post_data.get('title', '')} {post_body} {comments_text}"
                    has_platform_url = any(
                        d in full_text for d in ("novelpia.com", "munpia.com", "series.naver.com", "page.kakao.com")
                    )
                    if not has_platform_url:
                        print(
                            f"[{_ts()}][{self.emoji}] ?š« Rescue ?¤í‚µ: "
                            f"'{original}'?€ ?¥ë¥´ ?¸ë¡œ???¤ì›Œ?œë§Œ?¼ë¡œ êµ¬ì„± "
                            f"(words={original_words}, trope_match={trope_words_in_original}) "
                            f"+ ë³¸ë¬¸???Œë«??URL ?†ìŒ + ê²€??ì¦ê±° ?†ìŒ",
                            file=sys.stderr,
                        )
                        return (None, 0.0, None)

        # ?†• BUG-1: discourse_warning???ˆìœ¼ë©?rescue ?¤ì½”??ê¸°ì? ?í–¥ (0.75 ??0.85)
        has_discourse_warning = bool(getattr(ctx, 'discourse_warning', None)) if ctx else False
        rescue_min_score = 0.85 if has_discourse_warning else 0.75

        # ?†• P1-2: ?¬ìŠ¤?¸ê? ?Œë«???¼ë°˜ ?¼ì˜/?¥ë¥´ ?¸ë¡œ???¼ì˜??ê²½ìš° Rescue ?¤í‚µ
        # "?‘íˆ°?€ ë¹„ì²˜?€ ?„ë‹Œ ?ˆë¡œ??.." ê°™ì? ?Œë«???„ë°˜ ?¼ì˜?ì„œ ?°ì—° ë§¤ì¹­ ë°©ì?
        discourse_out = None
        if ctx:
            discourse_out = getattr(ctx, 'expert_outputs', {}).get('discourse_analyzer') or {}
        if discourse_out:
            disc_type = (discourse_out.get("discourse_type") or "").lower()
            if disc_type in ("platform_general", "trope_discussion", "community_meta"):
                return (None, 0.0, None)
        # ì»¤ë??ˆí‹° ê¸€ ?œëª©?€ ?„ë³´?ì„œ ?œì™¸ (?½ì¹­ ?ì²´ê°€ ?¤ì–´?ˆëŠ” ê¸€?€ false positive)
        _COMMUNITY_DOMAINS = (
            "ruliweb.com", "fmkorea.com", "dcinside.com",
            "arca.live", "theqoo.net", "clien.net",
            "inven.co.kr", "ppomppu.co.kr", "todayhumor.co.kr",
        )
        community_titles: set[str] = set()
        for sr in search_results:
            sr_url = sr.get("url", "")
            if any(cd in sr_url for cd in _COMMUNITY_DOMAINS):
                sr_t = (sr.get("title") or "").strip()
                if sr_t:
                    community_titles.add(sr_t)

        best_title = None
        best_score = 0.0
        best_source = None

        # ?€?€ ?†• BUG-5: ?Œë ¤ì§??½ì–´ ?¬ì „ ì§ì ‘ ë§¤í•‘ (LLM ?¤íŒ¨ ??ì½”ë“œ?ˆë²¨ ë³´ì •) ?€?€
        # (KNOWN_ABBREVIATIONS??ëª¨ë“ˆ ?˜ì? ?ìˆ˜ ì°¸ì¡°)
        known_title = KNOWN_ABBREVIATIONS.get(original_clean)
        if known_title:
            # ê²€ì¦? ê²€??ê²°ê³¼???´ë‹¹ ?œëª©???ˆëŠ”ì§€ ?•ì¸ (?˜ê° ë°©ì?)
            found_in_search = False
            for sr in search_results:
                sr_text = (sr.get("title", "") + " " + (sr.get("content") or sr.get("snippet") or ""))
                if known_title.replace(" ", "") in sr_text.replace(" ", ""):
                    found_in_search = True
                    break
            if found_in_search or known_title in [ot["title"] for ot in official_titles]:
                print(
                    f"[{_ts()}][{self.emoji}] ?“˜ Known abbreviation: "
                    f"'{original}' ??'{known_title}' (KNOWN_ABBREVIATIONS)",
                    file=sys.stderr,
                )
                return known_title, 0.95, "known_abbreviation"
            else:
                # ê²€??ê²°ê³¼???†ì–´???’ì? ? ë¢°?„ë¡œ ?„ë³´ ?œì‹œ
                print(
                    f"[{_ts()}][{self.emoji}] ?“˜ Known abbreviation (ë¯¸ê?ì¦?: "
                    f"'{original}' ??'{known_title}' (ê²€??ê²°ê³¼?ì„œ ë¯¸í™•?? ?„ë³´ë¡??¤ì •)",
                    file=sys.stderr,
                )
                best_title = known_title
                best_score = 0.80
                best_source = "known_abbreviation_unverified"

        # ?†• ?‘ê? ?˜ì´ì§€ ?¨í„´: "~?˜ì˜ ?‘í’ˆ", "?‘í’ˆ ëª©ë¡" ?±ì? ?‘í’ˆëª…ì´ ?„ë‹˜
        _AUTHOR_PAGE_PATTERNS = (
            "´ÔÀÇ ÀÛÇ°", "ÀÛÇ° ¸ñ·Ï", "ÇÁ·ÎÇÊ",
            "ÀÛ°¡ Á¤º¸", "ÀÛ°¡ ÆäÀÌÁö", "´ÔÀÇ ¼Ò¼³", "ÀÛ°¡ÀÇ ÀÛÇ°",
            "ÀÛÇ°¼Ò°³", "ÀÛÇ° ¼Ò°³", "ÀÛ°¡ ¼Ò°³",
        )

        # ?€?€ Pass 1: ê³µì‹ ?Œë«???œëª© ?°ì„  ?€?€
        for ot in official_titles:
            candidate = ot["title"]
            if len(candidate) < 4 or len(candidate) > 40:
                continue
            # ?†• ?‘ê? ?˜ì´ì§€ ?œëª©?€ ?‘í’ˆëª…ì´ ?„ë‹˜ ???¤í‚µ
            if any(p in candidate for p in _AUTHOR_PAGE_PATTERNS):
                continue
            score = abbreviation_match_score(original, candidate)
            if score > best_score:
                best_score = score
                best_title = candidate
                best_source = f"platform:{ot.get('platform', '?')}"

        # ?€?€ Pass 2: ?„ì²´ title_pool (ì»¤ë??ˆí‹° ?œì™¸) ?€?€
        for candidate in title_pool:
            if candidate in community_titles:
                continue
            if len(candidate) < 4 or len(candidate) > 40:
                continue
            # ?†• ?‘ê? ?˜ì´ì§€ ?œëª©?€ ?‘í’ˆëª…ì´ ?„ë‹˜ ???¤í‚µ
            if any(p in candidate for p in _AUTHOR_PAGE_PATTERNS):
                continue
            score = abbreviation_match_score(original, candidate)
            if score > best_score:
                best_score = score
                best_title = candidate
                best_source = "title_pool"

        # ?€?€ Pass 3: ê²€??ê²°ê³¼ content?ì„œ "X?€ ?Œì„¤" / "X?¼ëŠ” ?‘í’ˆ" ?¨í„´ ?€?€
        import re as _re_rescue
        content_title_patterns = [
            _re_rescue.compile(
                r'(?:ë¬¸í”¼???¸ë²¨?¼ì•„|ì¹´ì¹´?¤í˜?´ì?|?¤ì´ë²?s*?œë¦¬ì¦?ì¡°ì•„??(?:???\s+'
                r'(.{3,25}?)(?:?€|?¼ëŠ”|?´ë?|?´ë¼??\s*(?:?Œì„¤|?‘í’ˆ|?¹ì†Œ??'
            ),
            _re_rescue.compile(
                r'(?:?Œì„¤|?‘í’ˆ|?¹ì†Œ??\s*["\']?(.{3,25}?)["\']?\s*(?:?´ë¼???¼ëŠ”|?´ë?|?€)'
            ),
        ]
        for sr in search_results:
            content = (sr.get("content") or sr.get("snippet") or "")
            for pat in content_title_patterns:
                for m in pat.finditer(content):
                    candidate = m.group(1).strip()
                    candidate = _re_rescue.sub(r'[\.\s]+$', '', candidate)
                    if 3 <= len(candidate) <= 30:
                        score = abbreviation_match_score(original, candidate)
                        if score > best_score:
                            best_score = score
                            best_title = candidate
                            best_source = "content_pattern"

        # ?€?€ Pass 4: "ë¸”ë¼?¸ë“œ | ?¹ì†Œ??ì¢…í† ë°? ?œëª©" ???œëª© ?¨í„´ ?€?€
        title_suffix_patterns = [
            _re_rescue.compile(r'[-:|]\s*(.{4,30})$'),
        ]
        for sr in search_results:
            sr_title = (sr.get("title") or "").strip()
            if not sr_title:
                continue
            for pat in title_suffix_patterns:
                m = pat.search(sr_title)
                if m:
                    candidate = m.group(1).strip()
                    if 4 <= len(candidate) <= 30 and candidate not in community_titles:
                        score = abbreviation_match_score(original, candidate)
                        if score > best_score:
                            best_score = score
                            best_title = candidate
                            best_source = "title_suffix"

        # ?€?€ Pass 5: Morpheme ê¸°ë°˜ ë¶€ë¶?ë§¤ì¹­ ?€?€
        # LLM??morphemesë¡?ë¶„ë¦¬???¸ê·¸ë¨¼íŠ¸ ì¤? ?¸ëª…(ìºë¦­?????œì™¸???µì‹¬ ?¤ì›Œ?œë§Œ
        # ì¡°í•©?˜ì—¬ abbreviation_match_score ?¬ì‹œ??
        # ?? "ì¦‰ì‚¬ë¬´ë¦¼?´ìœ ë°? ??morphemes=["ì¦‰ì‚¬","ë¬´ë¦¼","?´ìœ ë°?]
        #     "?´ìœ ë°??€ character ???œì™¸ ??"ì¦‰ì‚¬ë¬´ë¦¼"?¼ë¡œ ?¬ê???
        if best_score < 0.75:
            morphemes = term.get("morphemes") or []
            if morphemes and len(morphemes) >= 2:
                # ?„ë³´?ì„œ character/authorë¡?ì¶”ì •?˜ëŠ” morpheme ?œê±°
                gk_out = ctx.expert_outputs.get("gatekeeper") or {}
                gk_entities = gk_out.get("detected_entities") or {}
                char_names = set(gk_entities.get("possible_characters") or [])
                author_names = set(gk_entities.get("possible_authors") or [])
                exclude_names = char_names | author_names

                # grounding?ì„œ character_mention??ê²½ìš°???•ì¸
                grounding = term.get("grounding") or {}
                if grounding.get("anchor_type") == "character_mention":
                    # anchor_evidence?ì„œ ?¸ëª… ì¶”ì¶œ
                    evidence = grounding.get("anchor_evidence", "")
                    for morph in morphemes:
                        if morph in evidence and len(morph) >= 2:
                            exclude_names.add(morph)

                # Decoderê°€ is_author_name?¼ë¡œ ë§ˆí‚¹???¤ë¥¸ term??ì°¸ê³ 
                for other_term in (term.get("_sibling_terms") or []):
                    if other_term.get("is_author_name"):
                        ai = other_term.get("author_info") or {}
                        an = ai.get("name") or other_term.get("original")
                        if an:
                            exclude_names.add(an)

                # ?†• ê°™ì? term??author_info?ì„œ???¸ëª… ì¶”ì¶œ
                # Gatekeeperê°€ ?¸ëª… ë¶„ë¥˜ ëª??ˆì–´??Decoderê°€ ?ë³„??ê²½ìš°
                term_author = term.get("author_info") or {}
                if term_author.get("name"):
                    exclude_names.add(term_author["name"])
                # is_author_name=false?¬ë„, ê²€??ê²°ê³¼?ì„œ ìºë¦­?°ë¡œ ?•ì¸??morpheme ?ì?
                # ê²€??ê²°ê³¼?ì„œ "?´ìœ ë°±ì?", "?´ìœ ë°±ì´" ???¸ëª… ?¨í„´ ?•ì¸
                if not exclude_names:
                    import re as _re_char
                    for morph in morphemes:
                        if len(morph) >= 2:
                            char_pattern = _re_char.compile(
                                rf'{_re_char.escape(morph)}[?€?”ì´ê°€?„ë??˜ë„]'
                            )
                            for sr in search_results:
                                sr_content = (sr.get("content") or sr.get("snippet") or "")
                                sr_title_text = sr.get("title", "")
                                combined = sr_title_text + " " + sr_content
                                if char_pattern.search(combined):
                                    # ??morpheme???¸ëª…(ìºë¦­???‘ê?)??ê°€?¥ì„± ?•ì¸
                                    # ?¤ë¥¸ morpheme??ê°™ì? ê²€?‰ê²°ê³¼ì— ?œëª©?¼ë¡œ ?˜ì˜¤?”ì? ?•ì¸
                                    other_morphs = [m for m in morphemes if m != morph]
                                    other_in_title = any(
                                        om in sr_title_text for om in other_morphs
                                    )
                                    if other_in_title:
                                        exclude_names.add(morph)
                                        break

                # ?¸ëª… ?œì™¸??morphemes ì¡°í•©
                core_morphemes = [m for m in morphemes if m not in exclude_names]
                if core_morphemes and len(core_morphemes) < len(morphemes):
                    abbr_from_morphemes = "".join(core_morphemes)
                    if len(abbr_from_morphemes) >= 3:
                        # ??ì¶•ì†Œ???½ì–´ë¡??„ì²´ ?€ ?¬ìŠ¤ìº?
                        all_candidates = list(set(
                            [ot["title"] for ot in official_titles]
                            + [c for c in title_pool if c not in community_titles]
                        ))
                        for candidate in all_candidates:
                            if len(candidate) < 4 or len(candidate) > 40:
                                continue
                            score = abbreviation_match_score(abbr_from_morphemes, candidate)
                            if score > best_score:
                                best_score = score
                                best_title = candidate
                                best_source = f"morpheme_rescue({abbr_from_morphemes})"

                        # content ?¨í„´???¬ì‹œ??
                        for sr in search_results:
                            content = (sr.get("content") or sr.get("snippet") or "")
                            for pat in content_title_patterns:
                                for m_pat in pat.finditer(content):
                                    candidate = m_pat.group(1).strip()
                                    candidate = _re_rescue.sub(r'[\.\s]+$', '', candidate)
                                    if 3 <= len(candidate) <= 30:
                                        score = abbreviation_match_score(abbr_from_morphemes, candidate)
                                        if score > best_score:
                                            best_score = score
                                            best_title = candidate
                                            best_source = f"morpheme_content({abbr_from_morphemes})"

                        # title suffix ?¨í„´???¬ì‹œ??
                        for sr in search_results:
                            sr_title = (sr.get("title") or "").strip()
                            if not sr_title:
                                continue
                            for pat in title_suffix_patterns:
                                m_pat = pat.search(sr_title)
                                if m_pat:
                                    candidate = m_pat.group(1).strip()
                                    if 4 <= len(candidate) <= 30 and candidate not in community_titles:
                                        score = abbreviation_match_score(abbr_from_morphemes, candidate)
                                        if score > best_score:
                                            best_score = score
                                            best_title = candidate
                                            best_source = f"morpheme_suffix({abbr_from_morphemes})"

                        if best_score >= rescue_min_score:
                            print(
                                f"[{_ts()}][{self.emoji}] ?§© Morpheme rescue: "
                                f"'{original}' ??morphemes={morphemes} ??"
                                f"core='{abbr_from_morphemes}' ??'{best_title}' "
                                f"(score={best_score:.2f}, min={rescue_min_score})",
                                file=sys.stderr,
                            )

        # ?†• BUG-6: rescue ?„ë³´??ì¶œì²˜ ê²€ì¦????Œì„¤ ?Œë«???„ë©”?¸ì´ ?„ë‹ˆë©?ê±°ë?
        _NOVEL_PLATFORM_DOMAINS = (
            "novelpia.com", "munpia.com", "series.naver.com", "page.kakao.com",
            "joara.com", "namu.wiki", "ridibooks.com", "bookoa.com",
            "novelupdates.com", "syosetu.com",
        )
        if best_title and best_source and best_source.startswith("title_"):
            # title_pool/title_suffix ì¶œì²˜ ??ê³µì‹ ?Œë«???„ë©”???¬ë? ?•ì¸
            has_novel_platform_src = False
            for sr in search_results:
                sr_title_raw = (sr.get("title") or "").strip()
                sr_url = sr.get("url", "")
                if best_title in sr_title_raw or best_title == sr_title_raw:
                    if any(d in sr_url for d in _NOVEL_PLATFORM_DOMAINS):
                        has_novel_platform_src = True
                        break
            if not has_novel_platform_src:
                # ì»¤ë??ˆí‹° ê¸€ ?œëª©???Œì„¤ ?œëª©?¼ë¡œ ?¤ì¸?˜ëŠ” ê²?ë°©ì?
                print(
                    f"[{_ts()}][{self.emoji}] ?š« Rescue ê±°ë?: "
                    f"'{best_title}' ì¶œì²˜({best_source})ê°€ ?Œì„¤ ?Œë«???„ë©”?¸ì´ ?„ë‹˜",
                    file=sys.stderr,
                )
                best_title = None
                best_score = 0.0

        # ìµœì†Œ ê¸°ì?: score ??rescue_min_score (BUG-1: discourse ê²½ê³  ??0.85, ê¸°ë³¸ 0.75)
        if best_title and best_score >= rescue_min_score:
            return best_title, best_score, best_source
        return None, 0.0, None

    # ?†• BUG-B ë°©ì–´: ê²€??ê²°ê³¼ ?œëª©?ì„œ ?¬ì´?¸ëª…/ê²Œì‹œ???‘ë‘???•ì œ
    _SITE_PREFIX_PATTERNS = [
        # "ë¸”ë¼?¸ë“œ | ?¹ì†Œ??ì¢…í† ë°? ?¤ëŠ˜?„ìš” - ì¦‰ì‚¬ê¸??¤ê³  ë¬´ë¦¼???¨ì–´ì§€??
        # ??"ì¦‰ì‚¬ê¸??¤ê³  ë¬´ë¦¼???¨ì–´ì§€??
        _re.compile(r'^.+?\|\s*.+?:\s*.+?\s*-\s*'),
        # "ë¸”ë¼?¸ë“œ | ?¹ì†Œ??ì¢…í† ë°?- ?‘í’ˆëª?
        _re.compile(r'^.+?\|\s*.+?\s*-\s*'),
        # "[ë¬¸í”¼???‘í’ˆëª?> ?‘í’ˆ?Œê°œ - ?€?…ë¬¸??
        _re.compile(r'^\[.+?\]\s*'),
        # "?‘í’ˆëª?> ?‘í’ˆ?Œê°œ - ?€?…ë¬¸?? ?ì„œ ?·ë?ë¶?
        _re.compile(r'\s*>\s*.+?(?:\s*-\s*.+)?$'),
        # "ë¬¸í”¼??? ì‘ ë¬´í˜‘?Œì„¤ - ?‘í’ˆëª??…í›„ê°?" ?ì„œ ?‘ë‘??
        _re.compile(r'^.+?\s*? ì‘\s*.+?\s*-\s*'),
    ]

    # ?¬ì´?¸ëª…?¼ë¡œ ???°ì´???‘ë‘??ë¦¬ìŠ¤??
    _KNOWN_SITE_PREFIXES = (
        "ºê·£µå", "ÆèÄÚ", "·ç¸®À¥", "ÀÎº¥", "µğ½ÃÀÎ»çÀÌµå",
        "¾ÆÄ«ÀÌºê", "Ã¤³Î", "¿ô±ä´ëÇĞ", "À¯¸Ó", "ÀÎ½ºÆ¼Áî",
        "Ä«Æä", "³ª¹«À§Å°", "Á¾Åä¹æ",
        "¸®µğºÏ½º", "¸®µğ", "Ä«Ä«¿ÀÆäÀÌÁö",
        "³×ÀÌ¹ö ½Ã¸®Áî", "½Ã¸®Áî", "Á¶¾Æ¶ó", "¹®ÇÇ¾Æ", "³ëº§ÇÇ¾Æ",
    )

    # ?¬ì´?¸ëª… ?¤ì—¼ ?¨í„´ (?œëª© ?´ë??ì„œ??ê°ì?)
    _SITE_NOISE_PATTERNS = (
        "Á¾Åä¹æ", "ºê·£µå |", "¸¶ÀÌ³Ê °¶·¯¸®", "| ¼Ò¼³", "| Àå¸£¼Ò¼³",
        "> ÀÛÇ°¼Ò°³", "- ³ª¹«À§Å°", "- ³×ÀÌ¹ö ºí·Î±×",
        "- ¸®µğ", "- yes24", "- ÆèÄÚ",
        "- À¥Å÷/¼Ò¼³", "³ëº§ÇÇ¾Æ -",
    )

    def _clean_search_result_title(self, raw_title: str) -> list[str]:
        """ê²€??ê²°ê³¼ ?œëª©?ì„œ ?¬ì´?¸ëª…/ê²Œì‹œ???‘ë‘?´ë? ?•ì œ?˜ì—¬ ?‘í’ˆëª??„ë³´ ëª©ë¡ ë°˜í™˜.
        
        "ë¸”ë¼?¸ë“œ | ?¹ì†Œ??ì¢…í† ë°? ?¤ëŠ˜?„ìš” - ì¦‰ì‚¬ê¸??¤ê³  ë¬´ë¦¼???¨ì–´ì§€??
        ??["ë¸”ë¼?¸ë“œ | ?¹ì†Œ??ì¢…í† ë°? ?¤ëŠ˜?„ìš” - ì¦‰ì‚¬ê¸??¤ê³  ë¬´ë¦¼???¨ì–´ì§€??,
            "ì¦‰ì‚¬ê¸??¤ê³  ë¬´ë¦¼???¨ì–´ì§€??,
            "?¤ëŠ˜?„ìš” - ì¦‰ì‚¬ê¸??¤ê³  ë¬´ë¦¼???¨ì–´ì§€??]
        
        ?ë³¸ ?œëª©?€ ??ƒ ?¬í•¨?˜ê³ , ë¶„ë¦¬??ë¶€ë¶„ë„ ?„ë³´ë¡?ì¶”ê?.
        """
        # ?ë³¸???¬ì´?¸ëª… ?¤ì—¼???ˆìœ¼ë©??ë³¸??ê²°ê³¼?ì„œ ?œì™¸
        _has_site_noise = any(p in raw_title for p in self._SITE_NOISE_PATTERNS)
        results: list[str] = [] if _has_site_noise else [raw_title]
        
        # " - " êµ¬ë¶„?ë¡œ ë¶„í•  (ê°€???”í•œ ?¨í„´)
        if " - " in raw_title:
            parts = raw_title.split(" - ")
            for part in parts:
                part = part.strip()
                # ?ˆë¬´ ì§§ì? ?¬ì´?¸ëª…?´ë‚˜ ì¹´í…Œê³ ë¦¬ë§??ˆëŠ” ë¶€ë¶„ì? ?œì™¸
                if len(part) < 3:
                    continue
                # ?Œë ¤ì§??¬ì´?¸ëª… ?‘ë‘?´ë©´ ?œì™¸
                if any(part.startswith(sp) for sp in self._KNOWN_SITE_PREFIXES):
                    continue
                # " | " ???¬ì´??êµ¬ë¶„?ê? ?¬í•¨??ë¶€ë¶„ì? ?œì™¸
                if " | " in part:
                    continue
                if part not in results and len(part) <= 50:
                    results.append(part)
        
        # " | " êµ¬ë¶„?ë¡œ ë¶„í•  (ë¸”ë¼?¸ë“œ ??
        if " | " in raw_title:
            parts = raw_title.split(" | ")
            for part in parts:
                part = part.strip()
                if len(part) < 3 or len(part) > 50:
                    continue
                if any(part.startswith(sp) for sp in self._KNOWN_SITE_PREFIXES):
                    continue
                if " - " in part:
                    # "?¹ì†Œ??ì¢…í† ë°? ?¤ëŠ˜?„ìš” - ?‘í’ˆëª? ??ë§ˆì?ë§?" - " ?´í›„
                    sub = part.split(" - ")[-1].strip()
                    if sub and sub not in results and 3 <= len(sub) <= 50:
                        results.append(sub)
                if part not in results:
                    results.append(part)
        
        # ": " êµ¬ë¶„??(ê²Œì‹œ?? ?œëª©)
        if ": " in raw_title:
            after_colon = raw_title.split(": ")[-1].strip()
            if after_colon and after_colon not in results and 3 <= len(after_colon) <= 50:
                results.append(after_colon)
        
        return results

    def _extract_title_candidates_from_text(
        self, text: str, pool: list[str],
    ) -> None:
        """
        ê²€??ê²°ê³¼ content/snippet?ì„œ ? ì¬???‘í’ˆ ?œëª©??ì¶”ì¶œ?˜ì—¬ pool??ì¶”ê?.

        ?¨í„´:
        1. "?œëª© ê·¸ë?ë¡?X" ??X
        2. ?Œë«?¼ëª… + ?‘í’ˆëª?êµ¬ë¬¸
        3. ?¥ë¥´ ?‘ë‘??+ ?‘í’ˆëª?(munpia ê²€???˜ì´ì§€)
        4. Kiwi ëª…ì‚¬ 2~4ê°??°ê²° êµ¬ë¬¸
        """
        # ?¨í„´ 1: "?œëª© ê·¸ë?ë¡?X"
        for m in _re.finditer(r'?œëª©\s*ê·¸ë?ë¡?s+(.+?)(?:??????ë¥???ê°€|??\s', text):
            cand = m.group(1).strip()
            if 3 <= len(cand) <= 30:
                pool.append(cand)

        # ?¨í„´ 2: "ë¬¸í”¼?„ì— X?€" / "X?€ ?Œì„¤"
        for m in _re.finditer(
            r'(?:¹®ÇÇ¾Æ|³ëº§ÇÇ¾Æ|Ä«Ä«¿ÀÆäÀÌÁö|³×ÀÌ¹ö½Ã¸®Áî|Á¶¾Æ¶ó)(?:¿¡¼­)?\s+(.+?)'
            r'(?:\s*À»|\s*´Â|\s*ÀÌ|\s*¶ó|[,.])',
            text
        ):
            cand = m.group(1).strip()
            if 3 <= len(cand) <= 30:
                pool.append(cand)

        # ?¨í„´ 3: munpia ê²€???˜ì´ì§€ ?¥ë¥´ ?‘ë‘??
        genre_prefixes = [
            "¹«Çù", "ÆÇÅ¸Áö", "ÇöÆÇÅ¸Áö", "·Î¸Ç½º", "·ÎÆÇ", "SF",
            "°ÔÀÓ", "Ç»Àü", "BL", "¶óÀÌÆ®³ëº§", "´ëÃ¼¿ª»ç", "½ºÆ÷Ã÷",
            "¹Ì½ºÅÍ¸®", "½º¸±·¯", "µå¶ó¸¶", "¾×¼Ç", "¸ğÇè", "ÇĞ¿ø",
        ]
        for genre in genre_prefixes:
            for m in _re.finditer(
                rf'{genre}\.\s*(?:NEW\s*)?(.+?)(?:\.\s*ÃÑ\s*\d+È­\.\s*\d+|$)',
                text, _re.DOTALL,
            ):
                cand = _re.sub(r'[.\s]+$', '', m.group(1)).strip()
                if 3 <= len(cand) <= 30:
                    pool.append(cand)

        # ?¨í„´ 4: Kiwi ëª…ì‚¬ ?°ê²° (?„ë³´ ?œëª© ??ëª…ì‚¬ ì¶”ì¶œ)
        nouns = kiwi_nouns(self._kiwi, text)
        # ?¸ì ‘ ëª…ì‚¬ 2~3ê°??°ê²°???„ë³´ë¡?ì¶”ê?
        for wlen in range(2, min(4, len(nouns) + 1)):
            for start in range(len(nouns) - wlen + 1):
                phrase = " ".join(nouns[start:start + wlen])
                if 4 <= len(phrase) <= 25:
                    pool.append(phrase)
    
    def _guard_platform_feature_as_title(self, result: Dict[str, Any], ctx: Any) -> Dict[str, Any]:
        """
        ?”¥ Phase27-C: ?Œë«??ê¸°ëŠ¥ ?©ì–´ ê°€??

        ?¬ìŠ¤???œëª©???Œë«???½ì¹­(?¸í”¼?? ë¬¸í”¼????ê³?ê¸°ëŠ¥ ?©ì–´(ì½? ë±ƒì?, ?´ëª¨?°ì½˜ ??ê°€
        ?¨ê»˜ ?±ì¥?˜ë©´ ???Œì„¤ ?œëª©???„ë‹ˆ???Œë«??ë©”í? ê¸€.

        ?? "?¸í”¼??ê°€?´ë°?ì„œ ë¹??˜ì˜¤??ì½˜ì´ ?ˆëŠ”ê±°ë³´?? ??meta (?Œì„¤ ?„ë‹˜)
            "ë¶€ê¸°í”¼???±ë¼??ë±ƒì? ê°œì³ê·€?½ë„¤" ??meta (?Œì„¤ ?„ë‹˜)
        """
        post_title = ""
        gk = ctx.expert_outputs.get("gatekeeper") or {}
        raw_post = getattr(ctx, 'raw_post', None)
        if raw_post:
            post_title = raw_post.get("title", "") if isinstance(raw_post, dict) else ""
        if not post_title:
            # Gatekeeper??notes?ì„œ ?œëª© ì¶”ì¶œ ?œë„
            post_title = gk.get("notes", "")

        if not post_title:
            return result

        title_lower = post_title.lower()

        # ?Œë«???½ì¹­???œëª©???ˆëŠ”ì§€ ?•ì¸
        has_platform = any(pa in title_lower for pa in PLATFORM_ABBREVIATIONS)
        if not has_platform:
            return result

        # ?Œë«??ê¸°ëŠ¥ ?©ì–´ê°€ ?œëª©???ˆëŠ”ì§€ ?•ì¸
        feature_hits = [ft for ft in PLATFORM_FEATURE_TERMS if ft in title_lower]
        if not feature_hits:
            return result

        # ?????ˆìœ¼ë©????Œì„¤???„ë‹Œ ?Œë«??ë©”í? ê¸€
        print(
            f"[{_ts()}][{self.emoji}] ?›¡ï¸??Œë«??ê¸°ëŠ¥ ê°€?? "
            f"?œëª©???Œë«???½ì¹­ + ê¸°ëŠ¥ ?©ì–´({feature_hits}) ?™ì‹œ ì¡´ì¬ "
            f"??ëª¨ë“  ?„ë³´ title=null, confidence=none",
            file=sys.stderr
        )

        for term in result.get("decoded_terms", []):
            best_match = term.get("best_match") or {}
            if best_match.get("title"):
                best_match["title"] = None
                best_match["confidence"] = "none"
            for cand in term.get("candidates", []):
                cand["official_novel_title"] = None

        result["overall_confidence"] = "none"
        result["notes"] = (result.get("notes", "") or "") + \
            f" [?Œë«??ê¸°ëŠ¥ ê°€?? ?œëª©???Œë«???½ì¹­+ê¸°ëŠ¥ ?©ì–´({feature_hits}) ??meta ?ì •."

        return result

    def _guard_association_pattern(self, result: Dict[str, Any], ctx: Any) -> Dict[str, Any]:
        """
        ?”¥ Phase27-B: ?°ìƒ ?¨í„´ ê°€??

        ?œëª©??"X?´ë? ?¨ì–´ê°€ ? ì˜¬?ëŠ”??, "X ?ê°?? ???°ìƒ ?¨í„´???ˆìœ¼ë©?
        Xë¥??Œì„¤ ?œëª©?¼ë¡œ ë§¤ì¹­?˜ì? ëª»í•˜?„ë¡ ì°¨ë‹¨.

        ?? "?´ê±° ë³´ê³  ?„íƒœ?œë‚¨?´ë? ?¨ì–´ê°€ ? ì˜¬?ëŠ”?? ??"?„íƒœ?œë‚¨"?€ ?¼ë°˜ ?©ì–´ ?°ìƒ
        """
        post_title = ""
        raw_post = getattr(ctx, 'raw_post', None)
        if raw_post:
            post_title = raw_post.get("title", "") if isinstance(raw_post, dict) else ""

        if not post_title:
            return result

        # ?°ìƒ ?¨í„´ ë§¤ì¹­
        matched_pattern = None
        for pattern in ASSOCIATION_PATTERNS:
            if pattern in post_title:
                matched_pattern = pattern
                break

        if not matched_pattern:
            return result

        # ë³¸ë¬¸???‘í’ˆ ê³ ìœ  ?•ë³´(ìºë¦­?°ëª…, ì¤„ê±°ë¦???ê°€ ?ˆëŠ”ì§€ ?•ì¸
        # Gatekeeperê°€ ê°ì???entities ì¤?possible_charactersê°€ ?ˆìœ¼ë©??¤ì œ ?‘í’ˆ ? ë¡ ?????ˆìŒ
        gk = ctx.expert_outputs.get("gatekeeper") or {}
        gk_entities = gk.get("detected_entities") or {}
        has_characters = bool(gk_entities.get("possible_characters"))

        # DiscourseAnalyzerê°€ novel_literatureê°€ ?„ë‹Œ ?„ë©”?¸ìœ¼ë¡??ì •?ˆëŠ”ì§€ ?•ì¸
        discourse_out = ctx.expert_outputs.get("discourse") or {}
        discourse_analysis = discourse_out.get("discourse_analysis") or {}
        domain = discourse_analysis.get("primary_domain", "")
        is_novel_domain = domain == "novel_literature"

        # ?°ìƒ ?¨í„´???ˆê³ , ?Œì„¤ ?„ë©”?¸ë„ ?„ë‹ˆê³? ìºë¦­?°ë„ ?†ìœ¼ë©???ì°¨ë‹¨
        if not is_novel_domain and not has_characters:
            print(
                f"[{_ts()}][{self.emoji}] ?›¡ï¸??°ìƒ ?¨í„´ ê°€?? "
                f"?œëª©??'{matched_pattern}' ?¨í„´ ê°ì? + "
                f"domain={domain}(? novel_literature) + ìºë¦­???†ìŒ "
                f"??ëª¨ë“  ?„ë³´ confidence=low",
                file=sys.stderr
            )

            for term in result.get("decoded_terms", []):
                best_match = term.get("best_match") or {}
                if best_match.get("title"):
                    best_match["confidence"] = "low"

            if result.get("overall_confidence") in ("high", "medium"):
                result["overall_confidence"] = "low"

            result["notes"] = (result.get("notes", "") or "") + \
                f" [?°ìƒ ?¨í„´ ê°€?? '{matched_pattern}' ???¼ë°˜ ?©ì–´ ?°ìƒê¸€ë¡?ì¶”ì •."

        return result

    def _rescue_author_as_work_abbreviation(self, result: Dict[str, Any], ctx: Any) -> Dict[str, Any]:
        """
        ?”¥ ?‘ê?ëª??½ì¹­ rescue: Decoderê°€ is_author_name=trueë¡??ë‹¨??term??
        ?¤ì œë¡œëŠ” ?‘í’ˆ???½ì¹­??ê²½ìš°ë¥?ê²€??ê²°ê³¼?ì„œ ê°ì??˜ì—¬ ?‘í’ˆ ?ë³„ë¡??„í™˜.
        
        ?? "?´í…”ê¸? ??Decoderê°€ ?‘ê?ëª…ìœ¼ë¡??ë‹¨ ??ê²€?‰ì—??
        "ê´´ë‹´ ?¸í…” ?ˆì¶œê¸????½ì¹­?€ ê´´ë‹´?? ë°œê²¬ ???‘ê??ì • ì·¨ì†Œ, ?‘í’ˆ ?œëª© ?¤ì •
        """
        decoded_terms = result.get("decoded_terms", [])
        search_results = getattr(ctx, 'search_results', []) or []
        
        if not search_results:
            return result
        
        import re as _re_rescue
        
        for term in decoded_terms:
            if not term.get("is_author_name"):
                continue
            
            original = (term.get("original") or "").strip()
            if not original or len(original) < 2:
                continue
            
            # ?´ë? ?¤ë¥¸ term???‘í’ˆ??High confidenceë¡??ë³„?ˆìœ¼ë©??¤í‚µ
            other_has_high_title = any(
                t.get("best_match", {}).get("title")
                and t.get("best_match", {}).get("confidence") == "high"
                and not t.get("is_author_name")
                for t in decoded_terms
                if t is not term
            )
            if other_has_high_title:
                continue
            
            # original?ì„œ ?µì‹¬ ?´ë¦„ ì¶”ì¶œ (?? "?´í…”ê¸??‘ê?" ??"?´í…”ê¸?)
            author_info = term.get("author_info") or {}
            author_name = (author_info.get("name") or original).strip()
            # "?‘ê?" ?‘ë????œê±°
            if author_name.endswith("?‘ê?") and len(author_name) > 2:
                author_name = author_name[:-2].strip()
            author_clean = author_name.replace(" ", "")
            
            found_title = None
            found_url = None
            found_platform = None
            
            for sr in search_results:
                sr_title = sr.get("title", "")
                sr_content = sr.get("content", "") or sr.get("snippet", "")
                sr_combined = f"{sr_title} {sr_content}"
                sr_url = sr.get("url", "")
                
                # ?¨í„´ 1: "?½ì¹­?€ X" ??Xê°€ author_nameê³?? ì‚¬
                abbr_match = _re_rescue.search(
                    r'?½ì¹­[?€?´ê?]?\s*([ê°€-??{2,8})',
                    sr_combined,
                )
                if abbr_match:
                    detected_abbr = abbr_match.group(1)
                    # author_cleanê³?detected_abbr ? ì‚¬??
                    overlap = sum(1 for c in author_clean if c in detected_abbr)
                    similarity = overlap / max(len(author_clean), len(detected_abbr), 1)
                    if similarity >= 0.5:
                        # ??ê²€??ê²°ê³¼?ì„œ ?•ì‹ ?œëª© ì¶”ì¶œ
                        if "namu.wiki" in sr_url:
                            found_title = sr_title.strip()
                            found_url = sr_url
                        elif not found_title:
                            # sr_title?ì„œ " - " ?´ì „ ë¶€ë¶?
                            if " - " in sr_title:
                                candidate = sr_title.split(" - ")[0].strip()
                                if len(candidate) >= 3 and candidate != author_name:
                                    found_title = candidate
                                    found_url = sr_url
                
                # ?¨í„´ 2: "ì¤„ì—¬??X", "X?¼ê³  ì¤„ì¸" 
                if not found_title:
                    abbr_match2 = _re_rescue.search(
                        rf'ì¤„ì—¬??s*{_re_rescue.escape(author_name)}',
                        sr_combined,
                    )
                    if abbr_match2 and " - " in sr_title:
                        found_title = sr_title.split(" - ")[0].strip()
                        found_url = sr_url
                
                # ?¨í„´ 3: "X?¼ëŠ” ê¸€/?Œì„¤" + ê°™ì? ?˜ì´ì§€???•ì‹ ?œëª©
                if not found_title:
                    ref_match = _re_rescue.search(
                        rf'{_re_rescue.escape(author_name)}[?´ë¼]?(?¼ê³ |?´ë¼ê³?\s*(ë¶€ë¥?ì¤?',
                        sr_combined,
                    )
                    if ref_match:
                        # sr_combined?ì„œ ?•ì‹ ?‘í’ˆëª??„ë³´ ì¶”ì¶œ
                        title_match = _re_rescue.search(
                            r'([°¡-ÆR][°¡-ÆR\s]{2,18}[°¡-ÆR])',
                            sr_title,
                        )
                        if title_match:
                            candidate = title_match.group(1).strip()
                            if (len(candidate) > len(author_name) + 2
                                and candidate != author_name
                                and not candidate.endswith("°¶·¯¸®")
                                and not candidate.endswith("Ã¤³Î")):
                                found_title = candidate
                                found_url = sr_url
                
                # ?¨í„´ 4: ê³µì‹ ?Œë«?¼ì—??author_name???µì‹¬ ?Œì ˆ???œëª©???¬í•¨
                if not found_title:
                    platform_domains = ("novelpia.com", "munpia.com", "page.kakao.com", "series.naver.com")
                    if any(d in sr_url for d in platform_domains):
                        if " - " in sr_title:
                            potential = sr_title.split(" - ")[0].strip()
                            # author_clean ?Œì ˆ??60% ?´ìƒ???•ì‹ ?œëª©???¬í•¨
                            potential_clean = potential.replace(" ", "")
                            char_overlap = sum(1 for c in author_clean if c in potential_clean)
                            if (char_overlap >= len(author_clean) * 0.6 
                                and len(potential) > len(author_name)
                                and potential != author_name):
                                found_title = potential
                                found_url = sr_url
                                found_platform = next(
                                    (d.split(".")[0] for d in platform_domains if d in sr_url),
                                    None,
                                )
                
                if found_title:
                    break
            
            if found_title:
                # author ??abbreviation?¼ë¡œ ?„í™˜
                term["is_author_name"] = False
                best_match = term.get("best_match") or {}
                old_title = best_match.get("title")
                best_match["title"] = found_title
                best_match["confidence"] = "medium"
                term["best_match"] = best_match
                
                if not term.get("candidates"):
                    term["candidates"] = []
                term["candidates"].insert(0, {
                    "official_novel_title": found_title,
                    "url": found_url,
                    "platform": found_platform,
                    "decode_logic": (
                        f"[?‘ê?ëª??½ì¹­ rescue] '{author_name}'(is_author) "
                        f"??ê²€?‰ì—???‘í’ˆ ?½ì¹­ ì¦ê±° ??'{found_title}'"
                    ),
                    "morphological_score": 0.6,
                })
                
                if result.get("overall_confidence") in ("none", "low"):
                    result["overall_confidence"] = "medium"
                
                print(
                    f"[{_ts()}][{self.emoji}] ?”„ ?‘ê?ëª??½ì¹­ rescue: "
                    f"'{author_name}'(is_author) ??'{found_title}' ?‘í’ˆ ?ë³„ ?„í™˜",
                    file=sys.stderr,
                )
        
        return result

    def _guard_archetype_as_title(self, result: Dict[str, Any], ctx: Any) -> Dict[str, Any]:
        """
        ?”¥ ?¥ë¥´ ?„í‚¤?€???©ì–´ ë°©ì–´: "ì´ˆë???, "ê¸ˆíƒœ??, "ê±°ê·¼?¼í?" ê°™ì?
        ?¥ë¥´ ??•  ?©ì–´ë¥??Œì„¤ ?œëª©?¼ë¡œ ë§¤ì¹­?˜ì? ëª»í•˜?„ë¡ ì°¨ë‹¨.
        
        ì¶”ê?ë¡? ?‘ê?ëª…ì? ?ë³„?ˆì?ë§??œëª©???„í‚¤?€???©ì–´??ê²½ìš°
        ???œëª©??nullë¡?ë³€ê²?(?‘ê???ë§ì?ë§??œëª© ë¯¸í™•??
        """
        # ?‘ê? ?ë³„ ?¬ë? ?•ì¸
        has_author = False
        author_name = None
        for term in result.get("decoded_terms", []):
            if term.get("is_author_name"):
                has_author = True
                ai = term.get("author_info") or {}
                author_name = ai.get("name") or term.get("original")
                break
        
        decoded_terms = result.get("decoded_terms", [])
        for term in decoded_terms:
            if term.get("is_author_name"):
                continue
            
            best_match = term.get("best_match") or {}
            title = best_match.get("title")
            if not title:
                continue
            
            original = term.get("original", "")
            
            # ?ë³¸ ?¤ì›Œ?œê? ?¥ë¥´ ?„í‚¤?€???©ì–´?¸ì? ?•ì¸
            is_archetype = original.strip() in GENRE_ARCHETYPE_TERMS
            
            if not is_archetype:
                continue
            
            # ?„í‚¤?€???©ì–´ê°€ ?œëª© ?„ë³´???¼ë?ë¡??¤ì–´ê°?ê²½ìš°
            # (?? "ì´ˆë??? ??"ì´ˆë???B"ë¡?ë§¤ì¹­) ??ì°¨ë‹¨
            old_conf = best_match.get("confidence", "medium")
            best_match["title"] = None
            best_match["confidence"] = "none"
            
            # overall_confidence???˜í–¥
            if result.get("overall_confidence") in ("high", "medium"):
                result["overall_confidence"] = "low"
            
            reason = f"?„í‚¤?€???©ì–´ '{original}'?€ ?œëª©???„ë‹˜"
            if has_author:
                reason += f" (?‘ê? '{author_name}' ?ë³„?? ?œëª© ë¯¸í™•??"
            
            print(f"[{_ts()}][{self.emoji}] ?›¡ï¸??„í‚¤?€???œëª© ì°¨ë‹¨: "
                  f"'{title}' ??null ({reason}, confidence={old_conf}?’none)",
                  file=sys.stderr)
        
        return result
    
    def _apply_discourse_warning(self, result: Dict[str, Any], ctx: Any) -> Dict[str, Any]:
        """
        ?”¥ Discourse ??°©??Override: non-novel ?„ë©”???ëŠ” ?¥ë¥´ ?¼ë°˜ë¡?ê²½ê³  ??Decoder ? ë¢°??ê°•ì œ ?œë™
        
        DiscourseAnalyzerê°€ memes_humor/daily_life ?±ìœ¼ë¡??ì •?ˆê±°??
        discuss_genre(?¥ë¥´/?¸ë¡œ???¼ë°˜ë¡?ë¡??ì •??ê²½ìš°,
        Decoderê°€ ?‘í’ˆ???ë³„?ˆë”?¼ë„ ë³¸ë¬¸/?“ê????¤ì œ ?‘í’ˆ ê´€??ì¦ê±°ê°€ ?ˆëŠ”ì§€ ?•ì¸.
        ì¦ê±° ?†ìœ¼ë©?? ë¢°??ê°•ì œ ?˜í–¥.
        
        author_talk(?‘ê? ë¹„í‰)?€ ì½”ë“œ ê°•ì œ ?œë™ ?†ì´ LLM ?„ë¡¬?„íŠ¸ ?´í•´?¥ìœ¼ë¡?ì²˜ë¦¬.
        """
        discourse_warning = getattr(ctx, 'discourse_warning', None)
        if not discourse_warning:
            return result
        
        # Decoderê°€ ?¤ì œë¡?ë¬´ì–¸ê°€ë¥??ë³„?ˆëŠ”ì§€ ?•ì¸
        has_match = False
        for term in result.get("decoded_terms", []):
            best = term.get("best_match") or {}
            if best.get("title") and best.get("confidence") in ("high", "medium"):
                has_match = True
                break
        
        if not has_match:
            return result  # ?´ë? ?ë³„ ?¤íŒ¨ ??ì¶”ê? ì²˜ë¦¬ ë¶ˆí•„??
        
        # ë³¸ë¬¸/?“ê????Œì„¤ ê´€??êµ¬ì²´??ì¦ê±°ê°€ ?ˆëŠ”ì§€ ?•ì¸
        post_data = getattr(ctx, 'post_data', {}) or {}
        content_texts = []
        for block in post_data.get("content_blocks", []):
            if isinstance(block, dict) and block.get("text"):
                content_texts.append(block["text"])
            elif isinstance(block, str):
                content_texts.append(block)
        all_text = " ".join(content_texts + (getattr(ctx, 'comments', []) or []))
        all_text_lower = all_text.lower()
        
        # ?Œì„¤ ê´€???¤ì›Œ??ì¡´ì¬ ?¬ë? ?•ì¸
        novel_evidence_keywords = [
            "ÀÛ°¡", "¿¬Àç", "¿Ï°á", "À¥¼Ò¼³", "¼Ò¼³", "¹®ÇÇ¾Æ", "³ëº§ÇÇ¾Æ",
            "Ä«Ä«¿ÀÆäÀÌÁö", "³×ÀÌ¹ö½Ã¸®Áî", "Á¶¾Æ¶ó", "¸®µğºÏ½º",
            "¿øÀÛ", "ÈÄ±â", "¸®ºä", "½ºÆ÷", "½ºÆ÷ÀÏ·¯",
            "ÁÖÀÎ°ø", "È÷·ÎÀÎ", "ºô·±", "¸ÕÄ¡Å²",
            "È¸±Í", "È¯»ı", "ºùÀÇ", "ÀÌ¼¼°è", "ÇåÅÍ",
        ]
        
        is_genre_warning = discourse_warning and ("discuss_genre" in discourse_warning or "genre_discussion" in discourse_warning)
        
        if is_genre_warning:
            # ?¥ë¥´ ?¼ë°˜ë¡?ê²½ê³ : ???„ê²©??ê¸°ì? ????• ëª??¥ë¥´?¤ì›Œ?œëŠ” ì¦ê±° ë¶ˆì¶©ë¶?
            # ?‘í’ˆ ê³ ìœ  ?•ë³´(?‘ê?ëª? ?Œë«?? ?Œì°¨, ?¤í¬?¼ëŸ¬ ??ë§??¸ì •
            novel_evidence_keywords = [
                "ÀÛ°¡", "¿¬Àç", "¿Ï°á", "¹®ÇÇ¾Æ", "³ëº§ÇÇ¾Æ",
                "Ä«Ä«¿ÀÆäÀÌÁö", "³×ÀÌ¹ö½Ã¸®Áî", "Á¶¾Æ¶ó", "¸®µğºÏ½º",
                "¿øÀÛ", "½ºÆ÷", "½ºÆ÷ÀÏ·¯",
                "±Ç", "È­", "±Ç¼ö",
            ]
        
        evidence_found = any(kw in all_text_lower for kw in novel_evidence_keywords)
        
        # ?†• ê²€?‰ì—???•ì¸???‘ê?ëª…ì´ ë³¸ë¬¸/?“ê???ì¡´ì¬?˜ë©´ ??ê°•ë ¥???Œì„¤ ì¦ê±°
        # (?? "?Œë§ˆ????ë³¸ë¬¸???ˆê³  ê²€?‰ì—??"ì£½ì—ˆ??ê¹¨ì–´???˜ì„ "???‘ê?ë¡??•ì¸)
        if not evidence_found:
            _snippet_hints = getattr(ctx, 'snippet_hints', {}) or {}
            _snippet_authors = _snippet_hints.get("author_hints", []) or []
            # Decoder??decoded_terms?ì„œ is_author_name??term??original???¬í•¨
            _decoder_authors = set()
            for _dt in result.get("decoded_terms", []):
                if _dt.get("is_author_name"):
                    _ao = (_dt.get("author_info") or {}).get("name", "")
                    if _ao:
                        _decoder_authors.add(_ao.lower().replace(" ", ""))
                    _orig = _dt.get("original", "")
                    if _orig:
                        _decoder_authors.add(_orig.lower().replace(" ", ""))
            _all_authors = set(
                (a.get("name") if isinstance(a, dict) else str(a)).lower().replace(" ", "")
                for a in _snippet_authors
                if a and len((a.get("name") if isinstance(a, dict) else str(a))) >= 2
            )
            _all_authors |= _decoder_authors
            
            if any(a in all_text_lower.replace(" ", "") for a in _all_authors if a):
                evidence_found = True
                _matched = [a for a in _all_authors if a and a in all_text_lower.replace(" ", "")]
                print(
                    f"[{_ts()}][{self.emoji}] ?”’ Discourse ??°©???œë™ ë©´ì œ: "
                    f"ê²€???•ì¸ ?‘ê?ëª…ì´ ë³¸ë¬¸??ì¡´ì¬ (?‘ê?: {_matched})",
                    file=sys.stderr,
                )
        
        # ë³¸ë¬¸/?“ê????Œì„¤ ê´€??ì¦ê±° ?„ë¬´ ??? ë¢°??ê°•ì œ ?˜í–¥
        # (evidence_found=True?´ë©´ ë©´ì œ)
        if not evidence_found:
            for term in result.get("decoded_terms", []):
                best = term.get("best_match") or {}
                if best.get("title") and best.get("confidence") in ("high", "medium"):
                    old_conf = best["confidence"]
                    best["confidence"] = "low"
                    print(f"[{_ts()}][{self.emoji}] ?š¨ Discourse ??°©???œë™: '{best.get('title')}' "
                          f"confidence={old_conf}?’low (discourse_warning={discourse_warning}, "
                          f"ë³¸ë¬¸???Œì„¤ ê´€??ì¦ê±° ?†ìŒ)", file=sys.stderr)
            
            # overall_confidence???˜í–¥
            if result.get("overall_confidence") in ("high", "medium"):
                result["overall_confidence"] = "low"
        
        return result

    @staticmethod
    def _score_to_confidence(score: Any) -> str:
        """Map numeric score to confidence label."""
        try:
            value = float(score)
        except (TypeError, ValueError):
            return "none"
        if value >= 0.85:
            return "high"
        if value >= 0.55:
            return "medium"
        if value > 0:
            return "low"
        return "none"

    def _reconcile_candidate_consistency(self, result: Dict[str, Any]) -> Dict[str, Any]:
        """
        ?„ë³´ êµ¬ì¡°???„ë“œ?€ ?ìœ ?œìˆ  ?„ë“œ ?•í•©??ë³´ì •.

        ëª©ì :
        - genre_match.is_match?€ decode_logicê°€ ë°˜ë?ë¡??œìˆ ?˜ëŠ” ëª¨ìˆœ ?„í™”
        - title=null ?„ë³´???ìˆ˜/is_match ëª¨ìˆœ ?•ë¦¬
        - best_matchê°€ is_match=false ?„ë³´ë¥?ê°€ë¦¬í‚¤??ê²½ìš° ?ë™ êµì •
        """
        decoded_terms = result.get("decoded_terms", [])
        if not decoded_terms:
            return result

        positive_markers = ("¸ÅÄª", "ÀÏÄ¡", "Á¤ÇÕ", "¿¬°è", "È®Á¤", "¸í½Ã")
        negative_markers = ("ºÒÀÏÄ¡", "Á¦¿Ü", "´©¶ô", "Â÷´Ü", "¹«È¿")

        fixed_field_count = 0
        fixed_best_count = 0

        for term in decoded_terms:
            candidates = term.get("candidates")
            if not isinstance(candidates, list) or not candidates:
                continue

            viable_candidates: list[tuple[float, str]] = []

            for cand in candidates:
                if not isinstance(cand, dict):
                    continue

                title = cand.get("official_novel_title") or cand.get("official_title")
                logic = str(cand.get("decode_logic") or "").strip()

                gm = cand.get("genre_match")
                if gm is None:
                    gm = {}
                    cand["genre_match"] = gm
                elif not isinstance(gm, dict):
                    gm = {}
                    cand["genre_match"] = gm
                    fixed_field_count += 1

                is_match = gm.get("is_match")
                if isinstance(is_match, str):
                    lowered = is_match.strip().lower()
                    if lowered in ("true", "false"):
                        is_match = lowered == "true"
                        gm["is_match"] = is_match
                        fixed_field_count += 1

                source_genre = str(gm.get("source_genre") or "").strip()
                target_genre = str(gm.get("target_genre") or "").strip()
                source_norm = source_genre.replace(" ", "").lower()
                target_norm = target_genre.replace(" ", "").lower()

                notes: list[str] = []

                if title is None and is_match is True:
                    gm["is_match"] = False
                    is_match = False
                    notes.append("title=null ?„ë³´??is_match=falseë¡?ë³´ì •")
                    fixed_field_count += 1

                # source/target ?¥ë¥´ê°€ ëª…ì‹œ?˜ì–´ ?ˆì„ ??êµ¬ì¡° ëª¨ìˆœ ë³´ì •
                if source_norm and target_norm:
                    if source_norm == target_norm and is_match is False:
                        gm["is_match"] = True
                        is_match = True
                        notes.append("source_genre=target_genre ?´ë?ë¡?is_match=trueë¡?ë³´ì •")
                        fixed_field_count += 1
                    elif source_norm != target_norm and is_match is True and title:
                        gm["is_match"] = False
                        is_match = False
                        notes.append("source_genre? target_genre ?´ë?ë¡?is_match=falseë¡?ë³´ì •")
                        fixed_field_count += 1

                # title=None candidate cannot keep positive morphology score
                try:
                    score_value = float(cand.get("morphological_score", 0) or 0)
                except (TypeError, ValueError):
                    score_value = 0.0
                if title is None and score_value > 0:
                    cand["morphological_score"] = 0.0
                    score_value = 0.0
                    notes.append("title=None candidate score reset to 0.0")
                    fixed_field_count += 1

                logic_has_positive = bool(logic) and any(marker in logic for marker in positive_markers)
                logic_has_negative = bool(logic) and any(marker in logic for marker in negative_markers)
                if is_match is False and logic_has_positive and not logic_has_negative:
                    notes.append("decode_logic??ë§¤ì¹­ ?œí˜„?´ë‚˜ is_match=false")
                elif is_match is True and logic_has_negative:
                    notes.append("decode_logic???œì™¸ ?œí˜„?´ë‚˜ is_match=true")

                if notes:
                    note_text = "; ".join(notes)
                    if logic:
                        cand["decode_logic"] = f"[?•í•©?? {note_text}. ?ë¬¸: {logic}"
                    else:
                        cand["decode_logic"] = f"[?•í•©?? {note_text}."
                    fixed_field_count += 1

                # best_match êµì • ?„ë³´êµ? title ì¡´ì¬ + is_matchê°€ falseê°€ ?„ë‹˜
                if title and gm.get("is_match") is not False:
                    try:
                        candidate_score = float(cand.get("morphological_score", 0) or 0)
                    except (TypeError, ValueError):
                        candidate_score = 0.0
                    viable_candidates.append((candidate_score, str(title)))

            best_match = term.get("best_match")
            if not isinstance(best_match, dict):
                continue

            best_title = best_match.get("title")
            if best_title:
                best_is_viable = False
                for cand in candidates:
                    if not isinstance(cand, dict):
                        continue
                    cand_title = cand.get("official_novel_title") or cand.get("official_title")
                    if cand_title != best_title:
                        continue
                    gm = cand.get("genre_match") or {}
                    if gm.get("is_match") is not False:
                        best_is_viable = True
                        break

                if not best_is_viable:
                    if viable_candidates:
                        viable_candidates.sort(key=lambda x: x[0], reverse=True)
                        fallback_score, fallback_title = viable_candidates[0]
                        best_match["title"] = fallback_title
                        best_match["confidence"] = self._score_to_confidence(fallback_score)
                    else:
                        best_match["title"] = None
                        best_match["confidence"] = "none"
                    term["best_match"] = best_match
                    fixed_best_count += 1

        if fixed_field_count or fixed_best_count:
            print(
                f"[{_ts()}][{self.emoji}] ?”§ candidate ?•í•©??ë³´ì •: "
                f"field_fixes={fixed_field_count}, best_match_fixes={fixed_best_count}",
                file=sys.stderr,
            )

        return result
    
    def _get_best_candidate(self, result: Dict[str, Any]) -> Optional[str]:
        """Get the best decoded title from result."""
        for term in result.get("decoded_terms", []):
            best = term.get("best_match", {})
            if best.get("title") and best.get("confidence") in ("high", "medium"):
                return best["title"]
        return None
    
    def needs_verification_search(self, result: Dict[str, Any]) -> bool:
        """Check if decoder requests additional verification search."""
        return result.get("needs_verification", False)
    
    def get_verification_query(self, result: Dict[str, Any]) -> Optional[List[str]]:
        """Get the verification search queries if needed."""
        vs = result.get("verification_search")
        if vs and isinstance(vs, list):
            return vs
        return None
    
    def get_best_candidates(self, result: Dict[str, Any]) -> List[Dict[str, Any]]:
        """Get all candidates with confidence >= medium."""
        candidates = []
        for term in result.get("decoded_terms", []):
            best = term.get("best_match", {})
            if best.get("title") and best.get("confidence") in ("high", "medium"):
                candidates.append({
                    "original_term": term.get("original"),
                    "title": best["title"],
                    "confidence": best["confidence"],
                    "is_author": term.get("is_author_name", False),
                })
        return candidates

    def _extract_official_titles_from_search(self, ctx: Any) -> List[Dict[str, str]]:
        """
        ?”¥ ê²€??ê²°ê³¼?ì„œ ê³µì‹ ?Œë«??novelpia, namu.wiki, munpia)???•í™•???œëª© ì¶”ì¶œ
        
        Returns:
            List of {"title": str, "platform": str, "url": str}
        """
        import re
        official_titles = []
        
        search_results = getattr(ctx, "search_results", []) or []
        official_platforms = OFFICIAL_PLATFORMS
        
        for result in search_results:
            url = result.get("url", "")
            title_from_result = result.get("title", "")
            snippet = result.get("snippet", "")
            
            # ê³µì‹ ?Œë«?¼ì¸ì§€ ?•ì¸
            platform = None
            for p in official_platforms:
                if p in url:
                    platform = p
                    break
            
            if not platform:
                continue
            
            # ë°©ë²• 1: ê²€??ê²°ê³¼??title?ì„œ ì§ì ‘ ì¶”ì¶œ (novelpia ?•ì‹)
            # ?? "?¹ì†Œ?¤ë¡œ ê¿ˆê¾¸???¸ìƒ! - ì£½ì—ˆ??ê¹¨ì–´???˜ì„ "
            if " - " in title_from_result:
                parts = title_from_result.split(" - ")
                if len(parts) >= 2:
                    extracted_title = parts[-1].strip()
                    # ë¶ˆí•„?”í•œ ?‘ë????œê±°
                    extracted_title = re.sub(r'\s*\(r\d+\s*\)\s*$', '', extracted_title)
                    if len(extracted_title) >= 3 and len(extracted_title) <= 50:
                        official_titles.append({
                            "title": extracted_title,
                            "platform": platform,
                            "url": url,
                        })
                        continue
            
            # ë°©ë²• 2: namu.wiki URL?ì„œ ì§ì ‘ ì¶”ì¶œ
            # ?? https://namu.wiki/w/ì£½ì—ˆ??20ê¹¨ì–´??20?˜ì„ 
            if "namu.wiki/w/" in url:
                import urllib.parse
                try:
                    path = url.split("/w/")[-1]
                    # URL ?”ì½”??
                    decoded_path = urllib.parse.unquote(path)
                    # (r?«ì ?? ?•ì‹ ?œê±°
                    decoded_path = re.sub(r'\s*\(r\d+\s*\)\s*$', '', decoded_path)
                    # ?†• ?˜ë¬´?„í‚¤ ?˜ìœ„ ?˜ì´ì§€ ?„í„°: '/?±ì¥?¸ë¬¼', '/?¤ì •' ?±ì? ?ìœ„ ?‘í’ˆëª…ë§Œ ì¶”ì¶œ
                    _NAMU_SUBPAGE_SUFFIXES = (
                        "/µîÀåÀÎ¹°", "/¼³Á¤", "/½ºÅä¸®", "/ÁÙ°Å¸®",
                        "/¿¡ÇÇ¼Òµå", "/Æò°¡", "/¾Ö´Ï", "/¹Ìµğ¾î¹Í½º",
                        "/OST", "/¾È³»", "/¹ß¸Å ÇöÈ²", "/ÀÛÁß ÇàÀû",
                        "/¹ß¸ÅÇöÈ²", "/ÀÛÁßÇàÀû",
                    )
                    for suffix in _NAMU_SUBPAGE_SUFFIXES:
                        if decoded_path.endswith(suffix):
                            decoded_path = decoded_path[:-len(suffix)]
                            break
                    # '/' ?¨ì? ?˜ìœ„ ?˜ì´ì§€???œê±° (?? "? ì˜ ???±ì¥?¸ë¬¼/2ë¶€")
                    if "/" in decoded_path:
                        decoded_path = decoded_path.split("/")[0]
                    if len(decoded_path) >= 3 and len(decoded_path) <= 50:
                        official_titles.append({
                            "title": decoded_path,
                            "platform": platform,
                            "url": url,
                        })
                        continue
                except Exception:
                    pass
            
            # ë°©ë²• 3: ?œëª©ë§??ˆëŠ” ê²½ìš° (?? "ì£½ì—ˆ??ê¹¨ì–´???˜ì„ ")
            clean_title = re.sub(r'\s*\(r\d+\s*\)\s*$', '', title_from_result).strip()
            if len(clean_title) >= 3 and len(clean_title) <= 50 and " - " not in clean_title:
                official_titles.append({
                    "title": clean_title,
                    "platform": platform,
                    "url": url,
                })
        
        # ?”¥ ë°©ë²• 4: munpia/novelpia ê²€???˜ì´ì§€??content ?„ë“œ?ì„œ ê°œë³„ ?‘í’ˆ ?œëª© ì¶”ì¶œ
        # munpia ê²€??ê²°ê³¼ URL: ?menu=detailSearchV2&action=search...
        # content ?•ì‹: "ë¬´í˜‘. NEWì¦‰ì‚¬ê¸??¤ê³  ë¬´ë¦¼???¨ì–´ì§€?? ì´?38??.."
        # title?ëŠ” "ì¦‰ì‚¬ê¸°ë¡œ ë¬´í•œ?±ì¥" (?˜ì´ì§€ ìµœìƒ???‘í’ˆ)???ˆì?ë§?
        # content???¤ì œ ë§¤ì¹­?˜ëŠ” ?¤ë¥¸ ?‘í’ˆ???¬í•¨?˜ì–´ ?ˆì„ ???ˆìŒ
        for result in search_results:
            url = result.get("url", "")
            content = result.get("content", "") or result.get("snippet", "")
            
            # ê²€???˜ì´ì§€?¸ì? ?•ì¸ (munpia/novelpia)
            is_search_page = False
            platform = None
            for p in official_platforms:
                if p in url:
                    platform = p
                    break
            
            if not platform:
                continue
            
            # ê²€???˜ì´ì§€ URL ?¨í„´ ê°ì?
            if any(kw in url for kw in ["search", "detailSearch", "searchKey", "keyword"]):
                is_search_page = True
            
            if not is_search_page or not content:
                continue
            
            # content?ì„œ ?‘í’ˆ ?œëª© ì¶”ì¶œ ?¨í„´:
            # "?¥ë¥´. [NEW]?œëª©. ì´?N?? ?ëŠ” "?¥ë¥´. ?œëª©. ?‘ê?ëª?
            genre_prefixes = [
                "¹«Çù", "ÆÇÅ¸Áö", "ÇöÆÇÅ¸Áö", "·Î¸Ç½º", "·ÎÆÇ", "SF",
                "°ÔÀÓ", "Ç»Àü", "BL", "¶óÀÌÆ®³ëº§", "´ëÃ¼¿ª»ç", "½ºÆ÷Ã÷",
                "¹Ì½ºÅÍ¸®", "½º¸±·¯", "µå¶ó¸¶", "¾×¼Ç", "¸ğÇè", "ÇĞ¿ø",
            ]
            
            for genre in genre_prefixes:
                # ?¨í„´: "ë¬´í˜‘. NEW?œëª©. " ?ëŠ” "ë¬´í˜‘. ?œëª©. "
                pattern = re.compile(
                    rf'{genre}\.\s*(?:NEW\s*)?(.+?)(?:\.\s*ÃÑ\s*\d+È­\.\s*\d+|\.\s*[°¡-ÆR]{{2,4}}(?:\s*ÀÛ°¡)?|$)',
                    re.DOTALL
                )
                for m in pattern.finditer(content):
                    extracted = m.group(1).strip()
                    # ?•ë¦¬: ?ë’¤ ê³µë°±, ë§ˆì¹¨???œê±°
                    extracted = re.sub(r'[\.\s]+$', '', extracted).strip()
                    if 3 <= len(extracted) <= 30:
                        # ?´ë? title ?„ë“œ?€ ê°™ì? ?œëª©?´ë©´ ?¤í‚µ
                        title_from_result = result.get("title", "")
                        if extracted != title_from_result.strip():
                            official_titles.append({
                                "title": extracted,
                                "platform": platform,
                                "url": url,
                                "source": "content_field",
                            })
        
        # ì¤‘ë³µ ?œê±° (?œëª© ê¸°ì?)
        seen = set()
        unique_titles = []
        for t in official_titles:
            if t["title"] not in seen:
                seen.add(t["title"])
                unique_titles.append(t)
        
        return unique_titles
    
    def _correct_title_with_search_result(self, llm_title: str, official_titles: List[Dict[str, str]]) -> str:
        """
        ?”¥ LLM???ì„±???œëª©??ê²€??ê²°ê³¼??ê³µì‹ ?œëª©ê³?ë¹„êµ?˜ì—¬ êµì •
        
        ë¬¸ì œ ?í™©:
        - LLM ?ì„±: "ì£½ì—ˆ??ê¹¨ì–´?˜ë„ ?˜ì„ " (?˜ëª»??ì¡°ì‚¬ "??)
        - ê²€??ê²°ê³¼: "ì£½ì—ˆ??ê¹¨ì–´???˜ì„ " (?•í™•???œëª©)
        
        ?”¥ best-match ë°©ì‹: ëª¨ë“  ?„ë³´ ì¤?ê°€???’ì? ? ì‚¬??? íƒ (first-match ?„ë‹˜)
        ?”¥ LLM ?œëª©??ê²€??ê²°ê³¼???•í™•??ì¡´ì¬?˜ë©´ êµì •?˜ì? ?ŠìŒ
        ?”¥ ë¹ˆë„ ê°€ì¤‘ì¹˜: ê°™ì? ?œëª©???¬ëŸ¬ ê²€??ê²°ê³¼???±ì¥?˜ë©´ ?°ì„ 
        
        Args:
            llm_title: LLM???ì„±???œëª©
            official_titles: ê²€??ê²°ê³¼?ì„œ ì¶”ì¶œ??ê³µì‹ ?œëª© ëª©ë¡
            
        Returns:
            êµì •???œëª© (?¼ì¹˜?˜ëŠ” ê³µì‹ ?œëª©???ˆìœ¼ë©?ê·¸ê²ƒ, ?†ìœ¼ë©??ë³¸)
        """
        if not official_titles:
            return llm_title
        
        from difflib import SequenceMatcher
        from collections import Counter
        
        llm_title_normalized = llm_title.strip()
        
        # ?”¥ Step 0: LLM ?œëª©??ê²€??ê²°ê³¼???•í™•??ì¡´ì¬?˜ë©´ êµì • ë¶ˆí•„??
        for official in official_titles:
            if llm_title_normalized == official["title"].strip():
                return llm_title_normalized
        
        # ?”¥ Step 1: ë¹ˆë„ ê³„ì‚° ??ê°™ì? ?œëª©???¬ëŸ¬ ê²€??ê²°ê³¼???±ì¥?˜ë©´ ? ë¢°?„â†‘
        title_freq = Counter(o["title"].strip() for o in official_titles)
        
        # ?”¥ Step 2: best-match ë°©ì‹ ??ëª¨ë“  ?„ë³´ë¥??‰ê??˜ê³  ìµœê³  ?ìˆ˜ ? íƒ
        best_candidate = None
        best_score = 0.0
        
        for official in official_titles:
            official_title = official["title"].strip()
            
            min_len = min(len(llm_title_normalized), len(official_title))
            if min_len < 3:
                continue
            
            # ê¸¸ì´ ì°¨ì´ê°€ ?ˆë¬´ ?¬ë©´ ?¤í‚µ (?„ì „???¤ë¥¸ ?œëª©)
            if abs(len(llm_title_normalized) - len(official_title)) > 4:
                continue
            
            similarity = SequenceMatcher(None, llm_title_normalized, official_title).ratio()
            
            # ë¹ˆë„ ë³´ë„ˆ?? ê°™ì? ?œëª©??Në²??±ì¥?˜ë©´ +0.02*N (ìµœë? +0.10)
            freq_bonus = min(title_freq[official_title] * 0.02, 0.10)
            adjusted_score = similarity + freq_bonus
            
            if adjusted_score > best_score:
                best_score = adjusted_score
                best_candidate = official
        
        # ?”¥ Step 3: ?„ê³„ê°?0.80 ?´ìƒ???Œë§Œ êµì • (0.70??.80 ?í–¥)
        if best_candidate and best_score >= 0.80:
            corrected = best_candidate["title"].strip()
            if corrected != llm_title_normalized:
                print(f"[{_ts()}][{self.emoji}] ? ï¸ ?œëª© êµì •: LLM='{llm_title}' ??ê³µì‹='{corrected}' "
                      f"(score={best_score:.2f}, platform={best_candidate['platform']})", file=sys.stderr)
                return corrected
        
        return llm_title

    def _guard_no_body_evidence(
        self,
        result: Dict[str, Any],
        gatekeeper_result: Dict[str, Any],
        ctx: Any,
    ) -> Dict[str, Any]:
        """
        ?”¥ ë³¸ë¬¸ ì¦ê±° ê°€?? Decoderê°€ title??ë§¤ì¹­?ˆì?ë§?ë³¸ë¬¸/?“ê???
        ?´ë‹¹ ?‘í’ˆ??êµ¬ì²´??ì¦ê±°ê°€ ?„í? ?†ìœ¼ë©?confidence ?˜í–¥.
        
        FP ?µì‹¬ ?¨í„´ ?€??
        - "?„ì¹´?°ë? ?µê²©? êº¼ë©? (?¥ë¥´ ?¼ë°˜ë¡? ??ê²€?‰â†’"?„ì¹´?°ë????µê²©?? ë§¤ì¹­ ??FP
        - "?¥ë¶•??ë¬´ë¦‰?„ì›?´ì„¸??" (?€??ë°? ??ê²€?‰â†’"? í˜‘?¸ìƒ?ì„œ ?¬ë¼?„ì´ ?´ì•„?¨ëŠ” ë²? ë§¤ì¹­ ??FP
        - "Fê¸‰ìœ¼ë¡?ì£¼ì›Œ??Sê¸? (ë°?? ë¨¸) ??ê²€?‰â†’"?¹ì†Œ?¤ë¡œ ê¿ˆê¾¸???¸ìƒ!" ??FP
        
        ?µì‹¬ ?ë¦¬:
        ê²Œì‹œê¸€ ë³¸ë¬¸/?œëª©??ë§¤ì¹­???‘í’ˆ??ê³ ìœ  ?•ë³´(ìºë¦­?? ì¤„ê±°ë¦? ?‘ê?, ?Œì°¨)ê°€
        ?˜ë‚˜???†ìœ¼ë©? ?´ë‹¹ ë§¤ì¹­?€ ?¤ì›Œ???°ì—° ?¼ì¹˜??ê°€?¥ì„±???’ë‹¤.
        """
        decoded_terms = result.get("decoded_terms", [])
        if not decoded_terms:
            return result
        
        # ê²Œì‹œê¸€ ë³¸ë¬¸+?œëª©+?“ê? ?ìŠ¤???˜ì§‘
        post_data = getattr(ctx, 'post_data', {}) or {}
        post_title = post_data.get("title", "")
        post_body_parts = []
        for block in post_data.get("content_blocks", []):
            if isinstance(block, dict) and block.get("text"):
                post_body_parts.append(block["text"])
        post_body = " ".join(post_body_parts)
        
        comments_text = " ".join(getattr(ctx, 'comments', []) or [])
        full_text = f"{post_title} {post_body} {comments_text}".strip()
        full_text_lower = full_text.lower().replace(" ", "")
        
        if not full_text:
            return result
        
        # Gatekeeperê°€ ê°ì????”í‹°???•ì¸
        gk_entities = gatekeeper_result.get("detected_entities", {}) or {}
        gk_characters = gk_entities.get("possible_characters", []) or []
        gk_authors = gk_entities.get("possible_authors", []) or []
        
        # ?†• ë²”ìš© ?œê°„ì°¸ì¡° ê°€?? ê²Œì‹œê¸€ ?œëª©??"? ì‘/ìµœì‹ ???„ì‘" ?±ì´ ?ˆëŠ”ì§€ ?¬ì „ ê°ì?
        # is_author_name ?¬ë??€ ë¬´ê??˜ê²Œ, ?œê°„ì°¸ì¡° ?¤ì›Œ?œê? ê²Œì‹œê¸€ ?œëª©???ˆìœ¼ë©?
        # ?¹ì • ?‘í’ˆ???´ë–¤ ê²ƒì¸ì§€ ?œì ???°ë¼ ?¬ë¼ì§€ë¯€ë¡??•ì • ë¶ˆê?
        _temporal_keywords_universal = [
            "½ÅÀÛ", "ÃÖ½Å", "ÀÌ¹øÀÛ", "Â÷±âÀÛ", "ÀüÀÛ", "´ÙÀ½ÀÛ", "¸¶°¨",
            "¿Ã¶ó¿È", "¿Ã¶ó¿Â°Å", "³ª¿Â°Å", "ÃÖ½Å¿¬Àç", "¿äÁò¿¬Àç", "Áö±İ¿¬Àç",
        ]
        _post_title_lower = post_title.lower().replace(" ", "")
        _has_temporal_in_post_title = any(
            tk in _post_title_lower for tk in _temporal_keywords_universal
        )
        
        changed = False
        title_clean = ""  # ?”§ ë°©ì–´??ì´ˆê¸°?? ëª¨ë“  term??continue??ê²½ìš° ?€ë¹?
        for term in decoded_terms:
            best = term.get("best_match") or {}
            title = best.get("title")
            confidence = best.get("confidence", "none")
            
            if not title or confidence in ("none", "low"):
                continue
            
            # ?”§ title_clean??ë£¨í”„ ?ë‹¨?ì„œ ë¯¸ë¦¬ ê³„ì‚° (is_author_name ë¸”ë¡?ì„œ???¬ìš©)
            title_clean = title.replace(" ", "").lower()
            
            # ?†• ë²”ìš© ?œê°„ì°¸ì¡° ê°€??(is_author_name ë¬´ê?)
            # ê²Œì‹œê¸€ ?œëª©???œê°„ì°¸ì¡° ?¤ì›Œ?œê? ?ˆê³ , ë§¤ì¹­???‘í’ˆ ?œëª©??ë³¸ë¬¸+?œëª©??ì§ì ‘ ?†ìœ¼ë©?ì°¨ë‹¨
            # ?? "ê°œëŒ ? ì‘ ì´ˆë??¨ì´..." ??"ê°œëŒ"???‘ê??¸ì? LLM??ëª¨ë¥´?”ë¼??
            #     "? ì‘"???œëª©???ˆê³ , ë§¤ì¹­??"NTRê²Œì„???¨ì¥???˜ì—ˆ??ê°€ ë³¸ë¬¸???†ìœ¼ë©?ì°¨ë‹¨
            if _has_temporal_in_post_title:
                _matched_title_clean = title.replace(" ", "").lower()
                _title_in_full_text = _matched_title_clean in full_text_lower
                
                # ë§¤ì¹­???œëª©???Œë ¤ì§??½ì¹­??ì²´í¬
                _known_abbrevs_for_title = set()
                for _ka_key, _ka_val in KNOWN_ABBREVIATIONS.items():
                    if _ka_val.replace(" ", "").lower() == _matched_title_clean:
                        _known_abbrevs_for_title.add(_ka_key.lower().replace(" ", ""))
                _abbrev_in_full_text = any(
                    ab in full_text_lower for ab in _known_abbrevs_for_title if ab
                )
                
                # ê²€??ê²°ê³¼?ì„œ "? ì‘"ê³??´ë‹¹ ?‘í’ˆ??ëª…ì‹œ?ìœ¼ë¡??°ê²°?˜ëŠ” ì¦ê±°ê°€ ?ˆëŠ”ì§€
                _temporal_search_confirmed = False
                search_results_temp = getattr(ctx, 'search_results', []) or []
                for sr in search_results_temp:
                    sr_combined = f"{sr.get('title', '')} {sr.get('content', '')}".lower().replace(" ", "")
                    # ê²€??ê²°ê³¼??ë§¤ì¹­???œëª© + "? ì‘" ?±ì´ ?¨ê»˜ ?˜í??˜ë©´ = ê²€?‰ì´ ???‘í’ˆ??? ì‘?¼ë¡œ ?•ì¸
                    if _matched_title_clean in sr_combined and any(
                        tk in sr_combined for tk in _temporal_keywords_universal
                    ):
                        _temporal_search_confirmed = True
                        break
                
                if not _title_in_full_text and not _abbrev_in_full_text and not _temporal_search_confirmed:
                    old_conf = confidence
                    best["confidence"] = "none"
                    best["title"] = None
                    result["overall_confidence"] = "none"
                    print(
                        f"[{_ts()}][{self.emoji}] ?›¡ï¸?ë²”ìš© ?œê°„ì°¸ì¡° ê°€?? "
                        f"'{term.get('original')}' ??'{title}' ë§¤ì¹­ ì°¨ë‹¨ "
                        f"(ê²Œì‹œê¸€ ?œëª©???œê°„ì°¸ì¡° ?¤ì›Œ??+ ë§¤ì¹­ ?‘í’ˆ??ë³¸ë¬¸/ê²€?‰ì—??ë¯¸í™•?? "
                        f"{old_conf}?’none)",
                        file=sys.stderr,
                    )
                    changed = True
                    continue
            
            # ?†• 0) is_author_name=true??term?€ ë³¸ë¬¸???‘ê?ëª?original)???ˆìœ¼ë©??¤í‚µ
            # ?µì‹¬: "?Œë§ˆ????is_author_name=true?´ê³  best_match.title="ì£½ì—ˆ??ê¹¨ì–´???˜ì„ "????
            # ë³¸ë¬¸??"?Œë§ˆ????ì¡´ì¬?˜ë©´ ê·??ì²´ê°€ ?‘í’ˆ ê³ ìœ  ì¦ê±° (?‘ê?=?‘í’ˆ ?ë³„)
            # ?”¥ ?ˆì™¸: "?‘ê?ëª?+ ?œê°„??ì§€ì¹?? ì‘/ìµœì‹ ????"ë§??ˆê³  ?œëª©/?½ì¹­??ë³¸ë¬¸???†ìœ¼ë©???ê°€???µê³¼
            if term.get("is_author_name"):
                _orig_lower = (term.get("original") or "").replace(" ", "").lower()
                _author_name_lower = ((term.get("author_info") or {}).get("name") or "").replace(" ", "").lower()
                if (_orig_lower and _orig_lower in full_text_lower) or \
                   (_author_name_lower and _author_name_lower in full_text_lower):
                    # ?‘ê?ëª…ì´ ë³¸ë¬¸??ì¡´ì¬ ??ê·¸ëŸ¬???œê°„??ì§€ì¹?§Œ?¼ë¡œ ?°ê²°??ê²½ìš° ?¤í‚µ?˜ë©´ ????
                    _temporal_keywords = [
                        "½ÅÀÛ", "ÃÖ½Å", "ÀÌ¹øÀÛ", "Â÷±âÀÛ", "ÀüÀÛ",
                        "¿Ã¶ó¿È", "¿Ã¶ó¿Â°Å", "³ª¿Â°Å", "ÃÖ½Å¿¬Àç", "¿äÁò¿¬Àç", "Áö±İ¿¬Àç",
                    ]
                    _has_temporal = any(tk in full_text_lower for tk in _temporal_keywords)
                    # ë§¤ì¹­???œëª©?´ë‚˜ ê·??½ì¹­??ë³¸ë¬¸??ì§ì ‘ ?¸ê¸‰?˜ëŠ”ì§€ ?•ì¸
                    _title_in_text = title_clean in full_text_lower
                    # ?œëª©??ì»¤ë??ˆí‹° ?½ì¹­??ì²´í¬ (?? "? í˜¸?´ë¹„")
                    _snippet_abbrevs = []
                    for sr in (getattr(ctx, 'search_results', []) or []):
                        _sr_text = f"{sr.get('title', '')} {sr.get('content', '')}".lower()
                        if title_clean in _sr_text.replace(" ", ""):
                            import re as _re_abbr
                            for m in _re_abbr.findall(r"¾àÄª[Àº´ÂÀÌ°¡]?\s*['\"]?([°¡-ÆRa-zA-Z0-9]{2,6})['\"]?", _sr_text):
                                _snippet_abbrevs.append(m.lower().replace(" ", ""))
                    _abbrev_in_text = any(ab in full_text_lower for ab in _snippet_abbrevs if ab)
                    
                    if _has_temporal and not _title_in_text and not _abbrev_in_text:
                        # ?œê°„??ì§€ì¹?§Œ ?ˆê³  ?œëª©/?½ì¹­ ë¯¸ë“±????ê°€???µê³¼ (?¤í‚µ?˜ì? ?ŠìŒ)
                        print(
                            f"[{_ts()}][{self.emoji}] ?”’ ë³¸ë¬¸ì¦ê±° ê°€???ìš©: "
                            f"'{term.get('original')}' ??'{title}' "
                            f"(is_author_name=true, ?œê°„??ì§€ì¹?§Œ ì¡´ì¬, ?œëª©/?½ì¹­ ë³¸ë¬¸ ë¯¸ë“±??",
                            file=sys.stderr,
                        )
                        # ê°€???µê³¼ ??confidence ?˜í–¥ ì²˜ë¦¬ (?„ë˜ ë¡œì§?¼ë¡œ ê³„ì†)
                    else:
                        print(
                            f"[{_ts()}][{self.emoji}] ?”’ ë³¸ë¬¸ì¦ê±° ê°€???¤í‚µ: "
                            f"'{term.get('original')}' ??'{title}' (is_author_name=true, ë³¸ë¬¸???‘ê?ëª?ì¡´ì¬)",
                            file=sys.stderr,
                        )
                        continue
            
            # ë§¤ì¹­???œëª©???µì‹¬ ?¤ì›Œ?œê? ë³¸ë¬¸???ˆëŠ”ì§€ ?•ì¸
            # (title_clean?€ ë£¨í”„ ?ë‹¨?ì„œ ?´ë? ? ë‹¹??
            
            # 1) ?œëª© ?ì²´ê°€ ë³¸ë¬¸??ëª…ì‹œ?ìœ¼ë¡?ì¡´ì¬?˜ë©´ OK
            if title_clean in full_text_lower:
                continue
            
            # 2) ê²€??ê²°ê³¼?ì„œ ???‘í’ˆ??ìºë¦­???‘ê? ?•ë³´ ì¶”ì¶œ
            work_specific_evidence = []
            search_results = getattr(ctx, 'search_results', []) or []
            for sr in search_results:
                sr_text = f"{sr.get('title', '')} {sr.get('content', '')}".lower()
                sr_url = sr.get("url", "").lower()
                
                # ê³µì‹ ?Œë«?¼ì—?????‘í’ˆ ?•ë³´ê°€ ?ˆìœ¼ë©?ìºë¦­???‘ê? ì¶”ì¶œ
                if title_clean in sr_text.replace(" ", ""):
                    # ??ê²€??ê²°ê³¼?ì„œ ?‘ê?ëª??¨í„´ ì¶”ì¶œ
                    import re as _re_local
                    author_patterns = _re_local.findall(
                        r'?‘ê?[:\s]+([ê°€-??{2,5})|([ê°€-??{2,5})\s*?‘ê?',
                        sr_text,
                    )
                    for match in author_patterns:
                        name = match[0] or match[1]
                        if name:
                            work_specific_evidence.append(("author", name))
            
            # 3) Gatekeeper ?”í‹°??ì¤????‘í’ˆê³?ê´€?¨ëœ ê²ƒì´ ë³¸ë¬¸???ˆëŠ”ì§€ ?•ì¸
            has_character_evidence = any(
                ch.lower().replace(" ", "") in full_text_lower
                for ch in gk_characters
                if ch and len(ch) >= 2
            )
            has_author_evidence = any(
                au.lower().replace(" ", "") in full_text_lower
                for au in gk_authors
                if au and len(au) >= 2
            )
            
            # ?†• 3-B) Decoderê°€ is_author_name=trueë¡??ë³„???¤ë¥¸ term???‘ê?ëª…ë„ ì²´í¬
            # ?µì‹¬: "?Œë§ˆ????is_author_name=true?´ê³  best_match.title="ì£½ì—ˆ??ê¹¨ì–´???˜ì„ "?´ë©´,
            # "ì£½ê¹¨?? term??ë³¸ë¬¸ì¦ê±° ê°€?œì—??"?Œë§ˆ???€ ?‘í’ˆ ê³ ìœ  ì¦ê±°ë¡?ì·¨ê¸‰
            has_author_verified_by_decoder = False
            for other_term in decoded_terms:
                if other_term is term:
                    continue
                if not other_term.get("is_author_name"):
                    continue
                # ???‘ê? term???„ì¬ termê³?ê°™ì? ?‘í’ˆ??ê°€ë¦¬í‚¤?”ì? ?•ì¸
                other_title = (other_term.get("best_match") or {}).get("title", "")
                if not other_title:
                    continue
                if other_title.replace(" ", "").lower() == title_clean:
                    # ê°™ì? ?‘í’ˆ! ?‘ê?ëª…ì´ ë³¸ë¬¸???ˆëŠ”ì§€ ?•ì¸
                    author_original = (other_term.get("original") or "").replace(" ", "").lower()
                    author_name_from_info = ((other_term.get("author_info") or {}).get("name") or "").replace(" ", "").lower()
                    if (author_original and author_original in full_text_lower) or \
                       (author_name_from_info and author_name_from_info in full_text_lower):
                        has_author_verified_by_decoder = True
                        has_author_evidence = True  # ê¸°ì¡´ ?Œë˜ê·¸ë„ ?¸íŒ…
                        print(
                            f"[{_ts()}][{self.emoji}] ?”’ ?‘ê?-?‘í’ˆ ?°ê²° ê²€ì¦? "
                            f"'{other_term.get('original')}' (?‘ê?) ??'{title}' "
                            f"(Decoderê°€ is_author_name?¼ë¡œ ?•ì¸, ë³¸ë¬¸???‘ê?ëª?ì¡´ì¬)",
                            file=sys.stderr,
                        )
                        break
            
            # ?†• ?‘ê?ê°€ Decoder???˜í•´ ê²€ì¦ë˜?ˆìœ¼ë©?ë³¸ë¬¸ì¦ê±° ê°€???¤í‚µ
            if has_author_verified_by_decoder:
                print(
                    f"[{_ts()}][{self.emoji}] ?”’ ë³¸ë¬¸ì¦ê±° ê°€???¤í‚µ: "
                    f"'{original_term}' ??'{title}' (ë³¸ë¬¸ ?‘ê?ëª…ì´ ?´ë‹¹ ?‘í’ˆ???‘ê?ë¡?Decoder ê²€ì¦ë¨)",
                    file=sys.stderr,
                )
                continue
            
            # ?†• 4-A) snippet_hints?ì„œ ?‘ê?ëª…ì´ ?•ì¸?˜ê³ , ê·??‘ê?ëª…ì´ ë³¸ë¬¸???ˆìœ¼ë©?ë³¸ë¬¸ì¦ê±° ê°€???¤í‚µ
            # ?µì‹¬: ê²€?‰ì—??'?Œë§ˆ??=?‘ê?, 'ì£½ê¹¨??=?‘í’ˆ???•ì¸?˜ì—ˆê³? ë³¸ë¬¸??'?Œë§ˆ?????ˆìœ¼ë©?
            # ?‘ê?ëª??ì²´ê°€ ?‘í’ˆ ê³ ìœ  ì¦ê±° (LLM decoded_terms???˜ì¡´?˜ì? ?ŠìŒ)
            if not has_author_evidence and ctx:
                _snippet_hints = getattr(ctx, 'snippet_hints', None)
                if _snippet_hints:
                    # author_hints?ì„œ ë³¸ë¬¸???ˆëŠ” ?‘ê?ëª?ì°¾ê¸°
                    _author_hints = _snippet_hints.get('author_hints', []) or []
                    for _ah in _author_hints:
                        _ah_name = (_ah.get('name') or '').replace(' ', '').lower()
                        if _ah_name and _ah_name in full_text_lower:
                            # ???‘ê?ê°€ ?„ì¬ ë§¤ì¹­???‘í’ˆê³?ê´€?¨ìˆ?”ì?:
                            # ê²€??ê²°ê³¼?ì„œ ?‘ê?ëª?+ ?‘í’ˆ ?œëª©??ê°™ì? ê²°ê³¼???˜í??˜ëŠ”ì§€ ?•ì¸
                            for sr in search_results:
                                sr_combined = f"{sr.get('title', '')} {sr.get('content', '')}".replace(' ', '').lower()
                                if _ah_name in sr_combined and title_clean in sr_combined:
                                    has_author_evidence = True
                                    print(
                                        f"[{_ts()}][{self.emoji}] ?”’ ë³¸ë¬¸ì¦ê±° ê°€???¤í‚µ: "
                                        f"'{_ah.get('name')}' (snippet_hints ?‘ê?) ??ë³¸ë¬¸, ?‘í’ˆ='{title}'",
                                        file=sys.stderr,
                                    )
                                    break
                            if has_author_evidence:
                                break
                
                # _resolved_mappings?ì„œ ë§¤í•‘???½ì¹­???‘ê?ê°€ ë³¸ë¬¸???ˆëŠ” ê²½ìš°
                if not has_author_evidence:
                    _resolved_authors = getattr(ctx, '_resolved_authors', []) or []
                    for _ra in _resolved_authors:
                        _ra_clean = str(_ra).replace(' ', '').lower()
                        if _ra_clean and _ra_clean in full_text_lower:
                            # ???‘ê?ëª…ì´ ê²€?‰ì—???„ì¬ ?‘í’ˆê³??¨ê»˜ ?˜í??˜ëŠ”ì§€ ?•ì¸
                            for sr in search_results:
                                sr_combined = f"{sr.get('title', '')} {sr.get('content', '')}".replace(' ', '').lower()
                                if _ra_clean in sr_combined and title_clean in sr_combined:
                                    has_author_evidence = True
                                    print(
                                        f"[{_ts()}][{self.emoji}] ?”’ ë³¸ë¬¸ì¦ê±° ê°€???¤í‚µ: "
                                        f"'{_ra}' (Gatekeeper ?‘ê?) ??ë³¸ë¬¸, ê²€?‰ì—???‘í’ˆ ?°ê²° ?•ì¸",
                                        file=sys.stderr,
                                    )
                                    break
                            if has_author_evidence:
                                break
            
            # ?†• 4-A-2) ë³¸ë¬¸ ìºë¦­??+ ê²€?‰ì—???´ë‹¹ ?‘í’ˆ???±ì¥?¸ë¬¼ë¡??•ì¸ ??ê°•í•œ ì¦ê±°
            # ?µì‹¬: "?œë¬´????ë³¸ë¬¸???ˆê³ , ê²€??ê²°ê³¼?ì„œ "ì¦‰ì‚¬ê¸??¤ê³  ë¬´ë¦¼???¨ì–´ì§€?? + "?œë¬´????
            # ?¨ê»˜ ?˜í??˜ë©´, ìºë¦­?°ê? ?´ë‹¹ ?‘í’ˆ???í•œ?¤ëŠ” ê²ƒì´ ê²€ì¦ë¨
            has_character_verified_in_search = False
            original_term = (term.get("original") or "").replace(" ", "").lower()
            # ?½ì¹­?’ì •?ì œëª?ë§¤í•‘???ˆìœ¼ë©? ?½ì¹­?¼ë¡œ??ê²€??ê²°ê³¼ ë§¤ì¹­ ?œë„
            _title_aliases = {title_clean}
            if original_term:
                _title_aliases.add(original_term)
            # KNOWN_ABBREVIATIONS ??§¤?‘ë„ ì¶”ê?
            for _ka_key, _ka_val in KNOWN_ABBREVIATIONS.items():
                if _ka_val.replace(" ", "").lower() == title_clean:
                    _title_aliases.add(_ka_key.lower())
            
            if has_character_evidence and search_results:
                for ch in gk_characters:
                    if not ch or len(ch) < 2:
                        continue
                    ch_clean = ch.lower().replace(" ", "")
                    if ch_clean not in full_text_lower:
                        continue
                    # ??ìºë¦­?°ëª…??ê²€??ê²°ê³¼?ì„œ ë§¤ì¹­???‘í’ˆ(?ëŠ” ?½ì¹­)ê³??¨ê»˜ ?˜í??˜ëŠ”ì§€ ?•ì¸
                    for sr in search_results:
                        sr_text = f"{sr.get('title', '')} {sr.get('content', '')}".lower().replace(" ", "")
                        # ?‘í’ˆ ?œëª©?´ë‚˜ ?½ì¹­ê³?ìºë¦­?°ëª…??ê°™ì? ê²€??ê²°ê³¼???ˆìœ¼ë©?ê²€ì¦ë¨
                        if any(alias in sr_text for alias in _title_aliases) and ch_clean in sr_text:
                            has_character_verified_in_search = True
                            print(
                                f"[{_ts()}][{self.emoji}] ?”’ ìºë¦­???‘í’ˆ ?°ê²° ê²€ì¦? "
                                f"'{ch}' ??'{title}' (ê²€??ê²°ê³¼?ì„œ ?•ì¸)",
                                file=sys.stderr,
                            )
                            break
                    if has_character_verified_in_search:
                        break
            
            # ?†• ìºë¦­?°ê? ê²€?‰ìœ¼ë¡?ê²€ì¦ë˜?ˆìœ¼ë©?ë³¸ë¬¸ì¦ê±° ê°€???¤í‚µ
            if has_character_verified_in_search:
                print(
                    f"[{_ts()}][{self.emoji}] ?”’ ë³¸ë¬¸ì¦ê±° ê°€???¤í‚µ: "
                    f"'{original_term}' ??'{title}' (ë³¸ë¬¸ ìºë¦­?°ê? ?‘í’ˆ ?±ì¥?¸ë¬¼ë¡?ê²€??ê²€ì¦ë¨)",
                    file=sys.stderr,
                )
                continue
            
            # 4) ê²€?‰ì—??ì¶”ì¶œ???‘ê?ëª…ì´ ë³¸ë¬¸???ˆëŠ”ì§€
            has_work_specific = any(
                name.lower().replace(" ", "") in full_text_lower
                for etype, name in work_specific_evidence
            )
            
            # 5) ?ë³¸ ?¤ì›Œ???½ì–´)?€ ë§¤ì¹­ ?œëª©???•íƒœ??ê²¹ì¹¨ ?•ì¸
            original_term = (term.get("original") or "").replace(" ", "").lower()
            
            # 5-1) ê²€??ê²°ê³¼??ëª…ì‹œ???½ì¹­ ì¦ê±°ê°€ ?ˆìœ¼ë©?ë³¸ë¬¸ì¦ê±° ê°€???¤í‚µ
            import re as _re_alias
            _alias_patterns = [
                _re_alias.compile(rf'?½ì¹­[?€?´ê?]?\s*{_re_alias.escape(original_term)}'),
                _re_alias.compile(rf'?µì¹­\s*{_re_alias.escape(original_term)}'),
                _re_alias.compile(rf'ì¤„ì—¬??s*{_re_alias.escape(original_term)}'),
                _re_alias.compile(rf'ì¤„ì„ë§??€?´ê?]?\s*{_re_alias.escape(original_term)}'),
            ]
            has_explicit_alias_evidence = False
            for sr in search_results:
                sr_combined = f"{sr.get('title', '')} {sr.get('content', '')}".lower()
                if any(p.search(sr_combined) for p in _alias_patterns):
                    has_explicit_alias_evidence = True
                    break
            
            if has_explicit_alias_evidence:
                print(
                    f"[{_ts()}][{self.emoji}] ?”’ ë³¸ë¬¸ì¦ê±° ê°€???¤í‚µ: "
                    f"'{original_term}' ??'{title}' (ê²€??ê²°ê³¼??ëª…ì‹œ???½ì¹­ ì¦ê±° ?ˆìŒ)",
                    file=sys.stderr,
                )
                continue
            
            # ?ë³¸ ?¤ì›Œ?œê? ?¥ë¥´ ?¤ì›Œ???¨í„´?¸ì? ?•ì¸
            from ..rules import GENRE_KEYWORDS, GENRE_ARCHETYPE_TERMS
            is_genre_keyword = (
                original_term in {g.lower().replace(" ", "") for g in GENRE_KEYWORDS}
                or original_term in {g.lower().replace(" ", "") for g in GENRE_ARCHETYPE_TERMS}
                or any(original_term.startswith(g.lower()[:2]) and len(original_term) <= len(g) + 2
                       for g in GENRE_KEYWORDS if len(g) >= 2)
            )
            
            # ë³¸ë¬¸???‘í’ˆ ê³ ìœ  ì¦ê±°ê°€ ?˜ë‚˜???†ìœ¼ë©?confidence ?˜í–¥
            if (not has_character_evidence
                and not has_author_evidence
                and not has_work_specific):
                
                # ì¶”ê? ì¡°ê±´: ë³¸ë¬¸??ë§¤ìš° ì§§ê±°???´ë?ì§€ ?„ì£¼??ê²½ìš° ???„ê²©
                body_len = len(post_body.strip())
                
                if is_genre_keyword:
                    # ?¥ë¥´ ?¤ì›Œ?????‘í’ˆ ë§¤ì¹­?€ ê±°ì˜ ??ƒ FP
                    old_conf = confidence
                    best["confidence"] = "none"
                    best["title"] = None
                    result["overall_confidence"] = "none"
                    print(
                        f"[{_ts()}][{self.emoji}] ?›¡ï¸?ë³¸ë¬¸ì¦ê±° ê°€??(?¥ë¥´?’ì‘??ì°¨ë‹¨): "
                        f"'{original_term}' ??'{title}' ë§¤ì¹­ ì°¨ë‹¨ "
                        f"(?¥ë¥´ ?¤ì›Œ??+ ë³¸ë¬¸???‘í’ˆ ì¦ê±° ?†ìŒ, {old_conf}?’none)",
                        file=sys.stderr,
                    )
                    changed = True
                elif body_len < 50:
                    # ë§¤ìš° ì§§ì? ë³¸ë¬¸ + ì¦ê±° ?†ìŒ ???’ì? FP ê°€?¥ì„±
                    # ?†• ?ˆì™¸: ?œëª© ?½ì–´ ë§¤ì¹­ score ??0.85?´ë©´ medium ? ì?
                    # ("ì¦‰ì‚¬ë¬´ë¦¼"??.90, "ë¹Œí™˜"??.95 ??ëª…í™•??ì¶•ì•½?´ëŠ” ë³´í˜¸)
                    abbr_score = abbreviation_match_score(original_term, title)
                    if abbr_score >= 0.85:
                        # ?½ì–´ ë§¤ì¹­??ê°•ë ¥?˜ë©´ ì§§ì? ë³¸ë¬¸?´ì–´??medium ? ì?
                        old_conf = confidence
                        if old_conf == "high":
                            best["confidence"] = "medium"
                            print(
                                f"[{_ts()}][{self.emoji}] ?›¡ï¸?ë³¸ë¬¸ì¦ê±° ê°€??(ì§§ì? ë³¸ë¬¸+ê°•í•œ ?½ì–´): "
                                f"'{original_term}' ??'{title}' confidence ?˜í–¥ "
                                f"(ë³¸ë¬¸ {body_len}?? abbr_score={abbr_score:.2f}, {old_conf}?’medium)",
                                file=sys.stderr,
                            )
                            changed = True
                        # medium ?´í•˜??? ì?
                    else:
                        old_conf = confidence
                        best["confidence"] = "low"
                        print(
                            f"[{_ts()}][{self.emoji}] ?›¡ï¸?ë³¸ë¬¸ì¦ê±° ê°€??(ì§§ì? ë³¸ë¬¸): "
                            f"'{original_term}' ??'{title}' confidence ?˜í–¥ "
                            f"(ë³¸ë¬¸ {body_len}??+ ?‘í’ˆ ì¦ê±° ?†ìŒ, {old_conf}?’low)",
                            file=sys.stderr,
                        )
                        changed = True
                elif confidence in ("high",):
                    # High confidence?¸ë° ë³¸ë¬¸ ì¦ê±° ?†ìŒ ??Medium?¼ë¡œ ?˜í–¥
                    # ?†• ?ˆì™¸: ?½ì–´ ë§¤ì¹­??ê°•ë ¥?˜ë©´(score??.85) ?˜í–¥ ?ˆí•¨
                    abbr_score_high = abbreviation_match_score(original_term, title)
                    if abbr_score_high >= 0.85:
                        print(
                            f"[{_ts()}][{self.emoji}] ?”’ ë³¸ë¬¸ì¦ê±° ê°€???¤í‚µ (ê°•í•œ ?½ì–´): "
                            f"'{original_term}' ??'{title}' "
                            f"(abbr_score={abbr_score_high:.2f}??.85 ??high ? ì?)",
                            file=sys.stderr,
                        )
                        # high ? ì?, ë³€ê²??†ìŒ
                    else:
                        best["confidence"] = "medium"
                        print(
                            f"[{_ts()}][{self.emoji}] ?›¡ï¸?ë³¸ë¬¸ì¦ê±° ê°€??(ì¦ê±° ë¯¸ì•½): "
                            f"'{original_term}' ??'{title}' confidence ?˜í–¥ "
                            f"(ë³¸ë¬¸???‘í’ˆ ê³ ìœ  ?•ë³´ ?†ìŒ, abbr_score={abbr_score_high:.2f}, high?’medium)",
                            file=sys.stderr,
                        )
                        changed = True
        
        if changed:
            # overall_confidence???¬ê³„??
            all_confs = [
                t.get("best_match", {}).get("confidence", "none")
                for t in decoded_terms
                if t.get("best_match", {}).get("title")
            ]
            if all_confs:
                conf_rank = {"high": 3, "medium": 2, "low": 1, "none": 0}
                max_conf = max(all_confs, key=lambda c: conf_rank.get(c, 0))
                result["overall_confidence"] = max_conf
        
        return result

