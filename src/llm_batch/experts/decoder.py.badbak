                user_prompt += "  ?? ?½ì¹­ ë§¤í•‘?´ë‚˜ ë³¸ë¬¸ ë§¥ë½ê³?ëª¨ìˆœ?˜ë©´ ë³¸ë¬¸ ë§¥ë½???°ì„ ?˜ì„¸??\n\n"
            
