                    for h in hints["abbreviation_hints"][:5]:
                        user_prompt += f"  - '{h.get('abbrev', '')}' ??'{h.get('full', '')}'\n"
                    user_prompt += "\n"
                
                user_prompt += "? ï¸ ???ŒíŠ¸??ì½”ë“œ ?ë™ ì¶”ì¶œ?´ë?ë¡??¤ë¥˜ê°€ ?ˆì„ ???ˆìŠµ?ˆë‹¤. ê²€??ê²°ê³¼ ?ë¬¸ê³?êµì°¨ ?•ì¸?˜ì„¸??\n"
        
        # ?”„ ì¦ê±° ê¸°ë°˜ ë§¥ë½ ì¶”ë¡  (Evidence-Based Context Reasoning)
        # ê²€?‰ìœ¼ë¡?ë°œê²¬???¬ì‹¤(?½ì¹­?’ì œëª? ?¸ë¬¼=ìºë¦­???‘ê?)??? ë?ë¡?
        # ë³¸ë¬¸/?“ê????¤ì‹œ ?½ê³ , ê¸€???¤ì œ ë§¥ë½??LLM???ìœ ë¡?²Œ ì¶”ë¡ ?˜ë„ë¡?? ë„
        _do_reasoning = False
        _resolved_mappings = []
        _gk_characters = []
        _gk_authors = []
        _post_title_r = ""
        
        if ctx:
