            search_results_json=_sr_json,
            slang_dictionary=_dict_json,
        ) + context_section + session_section
        
        # ?”¥ Discourse ??°©??ê²½ê³ : non-novel ?„ë©”???ì • ??Decoder?ê²Œ ê²½ê³ 
        if ctx and getattr(ctx, 'discourse_warning', None):
