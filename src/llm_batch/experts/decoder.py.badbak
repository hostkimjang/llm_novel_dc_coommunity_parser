                user_prompt += "?„ë˜??ê²€??ê²°ê³¼??snippet/?˜ì´ì§€?ì„œ ì½”ë“œê°€ ?ë™ ì¶”ì¶œ???•ë³´?…ë‹ˆ??\n"
                user_prompt += "???•ë³´ë¥?ì°¸ê³ ?˜ì—¬ ?½ì¹­ ?´ì„ ?•í™•?„ë? ?’ì´?¸ìš”.\n\n"
                
                if hints.get("title_hints"):
                    user_prompt += "?“– ë°œê²¬???Œì„¤ ?œëª© ?„ë³´:\n"
                    seen = set()
                    for h in hints["title_hints"][:8]:
                        t = h.get("title", "")
                        if t and t not in seen:
                            seen.add(t)
                            src = h.get("source", "")
                            user_prompt += f"  - \"{t}\" (ì¶œì²˜: {src})\n"
                    user_prompt += "\n"
                
                if hints.get("author_hints"):
                    user_prompt += "?ï¸ ë°œê²¬???‘ê?ëª??„ë³´:\n"
                    seen = set()
                    for h in hints["author_hints"][:5]:
                        n = h.get("name", "")
                        if n and n not in seen:
