                user_prompt += "?µì‹¬ ?¤ì›Œ?œê? ì»¤ë??ˆí‹° ?ì²´ ?€???? ?¥ë¶•=?¥ë¥´?Œì„¤ê°?? ì?, ê²œë¶•=ê²Œì„ê°?? ì?, ?„ì¥=ê°¤ëŸ¬ë¦?ê´€ë¦¬ì)?????ˆìŠµ?ˆë‹¤.\n"
                user_prompt += "ê²€??ê²°ê³¼?ì„œ ?´ë‹¹ ?¨ì–´ê°€ ?Œì„¤ 'ìºë¦­???´ë¦„'?¼ë¡œ ?˜ì˜¤?”ë¼?? ê·¸ê²ƒ?????¬ìŠ¤?¸ì˜ ë§¥ë½ê³??¼ì¹˜?˜ëŠ”ì§€ ?„ê²©???•ì¸?˜ì„¸??\n"
                user_prompt += "ë³¸ë¬¸/?“ê????‘í’ˆ ì¤„ê±°ë¦?·ì‘ê°€ëª…Â·í”Œ?«í¼ URL???„í? ?†ìœ¼ë©???best_match.title=null, confidence=none?¼ë¡œ ?ì •?˜ì„¸??\n"

        # ?†• BUG-4: ë³µí•© ì¶•ì•½??ë¶„ë¦¬ ?ŒíŠ¸
        # "ì¦‰ì‚¬ë¬´ë¦¼?´ìœ ë°? = ?‘í’ˆ?½ì–´+ìºë¦­?°ëª… ê²°í•© ??LLM?ê²Œ ë¶„ë¦¬ ?œë„ ?ˆë‚´
        user_prompt += "\n\n=== COMPOUND TERM HINT ===\n"
        user_prompt += "?¤ì›Œ?œê? 4?Œì ˆ ?´ìƒ?´ê³  ê³µë°±???†ìœ¼ë©? [?‘í’ˆ ?½ì–´ + ìºë¦­???‘ê?ëª???ê²°í•©???•íƒœ?????ˆìŠµ?ˆë‹¤.\n"
        user_prompt += "?? 'ì¦‰ì‚¬ë¬´ë¦¼?´ìœ ë°? ??'ì¦‰ì‚¬ë¬´ë¦¼'(?‘í’ˆ ?½ì–´) + '?´ìœ ë°?(ìºë¦­?°ëª…)\n"
        user_prompt += "?? 'ë§ê²œ?±í™©ê±´ìš±' ??'ë§ê²œ??(?‘í’ˆ ?½ì–´) + '?©ê±´??(ìºë¦­?°ëª…)\n"
        user_prompt += "??ê²½ìš° morphemesë¥?['ì¦‰ì‚¬ë¬´ë¦¼', '?´ìœ ë°?] ?•íƒœë¡?ë¶„ë¦¬?˜ì—¬ ë³´ê³ ?˜ì„¸??\n"
        user_prompt += "'ê°? ?‘ë??¬ëŠ” DC?¸ì‚¬?´ë“œ ê°¤ëŸ¬ë¦??½ì–´?????ˆìŠµ?ˆë‹¤ (?? ?„ìƒê°????„ì¹´?°ë??ì„œ ?ì¡´?˜ê¸° ê°¤ëŸ¬ë¦?.\n"
        
        # ?´ì „ ê²€??ì¿¼ë¦¬ ?´ë ¥ ?„ë‹¬ (ì¤‘ë³µ ê²€??ë°©ì?)
        if ctx and hasattr(ctx, 'searched_queries') and ctx.searched_queries:
